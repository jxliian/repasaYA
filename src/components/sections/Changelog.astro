---
import { execSync } from 'node:child_process';

/**
 * Novedades — el historial de git, traducido a lenguaje humano.
 *
 * Se lee en build, así que no hay nada que mantener a mano: haces commit
 * con formato convencional (`feat(dsd): ...`) y sale aquí solo. Si el
 * build corre sin historial (CI con clon superficial), la sección
 * simplemente no se pinta.
 */
type Commit = { date: string; badge: string; tone: string; scope: string; text: string };

const BADGE: Record<string, { badge: string; tone: string }> = {
  feat: { badge: 'Nuevo', tone: 'green' },
  fix: { badge: 'Arreglo', tone: 'orange' },
  chore: { badge: 'Mejora', tone: 'blue' },
  docs: { badge: 'Docs', tone: 'gray' },
  style: { badge: 'Diseño', tone: 'purple' },
  refactor: { badge: 'Limpieza', tone: 'blue' },
  perf: { badge: 'Velocidad', tone: 'cyan' },
};

/** `ade/direccion-financiera` → `Dirección Financiera` si la conocemos */
const SCOPES: Record<string, string> = {
  'direccion-financiera': 'Dirección Financiera',
  'derecho-fiscal': 'Derecho Fiscal',
  ade: 'ADE',
  informatica: 'Informática',
};
function prettyScope(scope: string): string {
  const last = scope.split('/').pop()!.toLowerCase();
  return SCOPES[last] ?? scope.split('/').pop()!.toUpperCase();
}

function humanize(raw: string): Omit<Commit, 'date'> {
  const m = raw.match(/^(feat|fix|chore|docs|style|refactor|perf)\(([^)]+)\):\s*(.+)/i);
  if (!m) return { badge: 'Cambio', tone: 'gray', scope: '', text: raw.slice(0, 62) };

  const [, type, scope, txt] = m;
  const meta = BADGE[type.toLowerCase()] ?? { badge: 'Cambio', tone: 'gray' };
  const text = txt.replace(/^(añadir|agregar|add|crear|actualizar|update|corregir)\s+/i, '');
  return {
    ...meta,
    scope: prettyScope(scope),
    text: text[0].toUpperCase() + text.slice(1),
  };
}

let commits: Commit[] = [];
try {
  const raw = execSync(
    'git log --pretty=format:"%ad%x09%s" --date=format:"%d/%m/%Y" -n 6',
    { encoding: 'utf8', cwd: process.cwd() }
  ).trim();
  commits = raw
    .split('\n')
    .filter(Boolean)
    .map((line) => {
      const [date = '', ...rest] = line.split('\t');
      return { date, ...humanize(rest.join(' ')) };
    });
} catch {
  /* sin historial → la sección no aparece */
}

const lastUpdate = commits[0]?.date ?? null;
---
{
  commits.length > 0 && (
    <section class="panel changelog" aria-labelledby="news-title">
      <h2 id="news-title" class="p-title">Novedades</h2>
      <ol class="news">
        {commits.map((c) => (
          <li>
            <time>{c.date}</time>
            <span>
              {c.scope && <b>{c.scope}: </b>}
              {c.text}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
    min-width: 0;
  }
  .p-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    margin-bottom: 10px;
  }
  .news {
    list-style: none;
  }
  .news li {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .news li:first-child {
    border-top: 0;
  }
  .news time {
    color: var(--ink-3);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
  }
  .news b {
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .news li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
