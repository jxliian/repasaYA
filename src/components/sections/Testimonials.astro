---
/**
 * Opiniones de estudiantes.
 *
 * Salen de `src/data/testimonials.json` (las que llegan por el issue de
 * GitHub y se aprueban). Rejilla fija en lugar de carrusel: se leen todas
 * de un vistazo y no hay nada que se mueva solo.
 */
import testimonialsData from '../../data/testimonials.json';

const ISSUE_URL = 'https://github.com/jxliian/repasaYA/issues/new?template=dejar_resena.yml';

interface Testimonial {
  username: string;
  name: string;
  avatar: string;
  degree: string;
  stars: number;
  comment: string;
  date: string;
}

const testimonials: Testimonial[] = testimonialsData;

const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return y && m && d ? `${d} ${MONTHS[m - 1]} ${y}` : iso;
};
---

<section class="voices container" id="opiniones" aria-labelledby="voices-title">
  <div class="head">
    <div>
      <h2 id="voices-title" class="sec-title">Lo que dicen los estudiantes<span class="pt">.</span></h2>
      <p class="sec-sub">Opiniones de compañeros que repasan sus asignaturas en repasaYA.</p>
    </div>
    <a class="btn btn-ghost" href={ISSUE_URL} target="_blank" rel="noopener">Dejar mi opinión en GitHub</a>
  </div>

  <div class="quotes">
    {
      testimonials.map((t) => (
        <figure class="quote">
          <span class="stars" aria-label={`${t.stars} de 5 estrellas`}>
            {'★'.repeat(t.stars)}
          </span>
          <blockquote>{t.comment}</blockquote>
          <figcaption>
            <img src={t.avatar} alt="" width="38" height="38" loading="lazy" decoding="async" />
            <span>
              <a href={`https://github.com/${t.username}`} target="_blank" rel="noopener">
                {t.name}
              </a>
              <small>
                {t.degree}, {fmt(t.date)}
              </small>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .voices {
    padding-top: 56px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 20px;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    border-left: 1px solid var(--line);
    min-width: 0;
  }
  .quote:nth-child(4n + 1) {
    border-left: 0;
  }
  .quote:nth-child(n + 5) {
    border-top: 1px solid var(--line);
  }
  .stars {
    color: var(--dot);
    letter-spacing: 2px;
    font-size: 0.9rem;
  }
  blockquote {
    flex: 1;
    font-size: 0.97rem;
    line-height: 1.55;
  }
  figcaption {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.85rem;
  }
  figcaption img {
    width: 38px;
    height: 38px;
    flex: none;
    object-fit: cover;
    border: 1px solid var(--line);
    background: var(--canvas);
  }
  figcaption a {
    display: block;
    font-weight: 600;
    color: var(--ink);
  }
  figcaption a:hover {
    color: var(--brand);
  }
  figcaption small {
    display: block;
    color: var(--ink-3);
    font-size: 0.8rem;
  }

  @media (max-width: 960px) {
    .quotes {
      grid-template-columns: 1fr 1fr;
    }
    .quote {
      border-left: 1px solid var(--line);
      border-top: 0;
    }
    .quote:nth-child(odd) {
      border-left: 0;
    }
    .quote:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .quotes {
      grid-template-columns: 1fr;
    }
    .quote {
      border-left: 0 !important;
    }
    .quote + .quote {
      border-top: 1px solid var(--line);
    }
  }
</style>
