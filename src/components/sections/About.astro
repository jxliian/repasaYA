---
/**
 * Sobre mí + contacto.
 *
 * El formulario no manda nada a ningún servidor: compone un `mailto:`
 * con lo que escribes y abre tu cliente de correo. En un sitio estático
 * sin backend es la única forma honesta de tener formulario sin meter
 * un servicio de terceros que rastree a quien lo use.
 *
 * El QR se genera como SVG (`assets/qr-repasaYA.svg`) y se pinta siempre
 * sobre blanco para que se pueda escanear.
 */
import { Image } from 'astro:assets';
import avatar from '../../assets/julian-avatar.jpg';
import qrSvg from '../../assets/qr-repasaYA.svg?raw';

const EMAIL = 'e.carrionjuliann@go.ugr.es';
const GITHUB = 'https://github.com/jxliian';
const REPO = 'https://github.com/jxliian/repasaYA';

const SUBJECTS = [
  'Aportar material',
  'He visto un fallo en una pregunta',
  'Sugerencia',
  'Otra cosa',
];
---

<section class="about" id="sobre-mi" aria-labelledby="about-title">
  <div class="container grid">
    <div class="bio">
      <div class="me">
        <Image src={avatar} alt="Julián Carrión" width={152} height={152} loading="lazy" class="avatar" />
        <div>
          <h2 id="about-title" class="sec-title">Julián Carrión</h2>
          <p class="role">Doble Grado en ADE e Ingeniería Informática, Universidad de Granada</p>
        </div>
      </div>
      <p>
        Monté repasaYA porque estaba harto de llegar a la semana de exámenes con
        200 diapositivas y ninguna forma decente de saber si me las sabía. Así que
        en vez de subrayar, me puse a convertir el temario en preguntas.
      </p>
      <p>
        Todo lo que hay aquí lo uso yo para estudiar lo mismo que tú. Por eso es
        gratis, no pide registro y no tiene un solo anuncio: no hay nada que
        monetizar, solo apuntes que ya existían.
      </p>
      <div class="links">
        <a class="btn btn-ghost" href={GITHUB} target="_blank" rel="noopener">GitHub @jxliian</a>
        <a class="btn btn-ghost" href={REPO} target="_blank" rel="noopener">Código del proyecto</a>
      </div>
      <div class="qr">
        <div class="code" set:html={qrSvg} />
        <div>
          <strong>Llévatelo al móvil</strong>
          <span>Escanéalo para abrir repasaYA y repasar desde cualquier sitio.</span>
          <span class="url">repasaya.juliancarrion.dev</span>
        </div>
      </div>
    </div>

    <div class="contact" id="contacto">
      <h2 class="sec-title">Escríbeme<span class="pt">.</span></h2>
      <p class="sec-sub">
        ¿Una pregunta mal puesta, una asignatura que falta, apuntes que quieres
        compartir? Cuéntamelo.
      </p>

      <form class="form" data-contact data-email={EMAIL} novalidate>
        <div class="hp-slot" aria-hidden="true">
          <input type="text" name="b_hp" tabindex="-1" autocomplete="off" />
        </div>
        <div class="two">
          <div class="field">
            <label for="c-name">Cómo te llamas</label>
            <input id="c-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre o un alias" maxlength="80" required />
          </div>
          <div class="field">
            <label for="c-subject">De qué va</label>
            <select id="c-subject" name="subject">
              {SUBJECTS.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
        </div>
        <div class="field">
          <div class="label-row">
            <label for="c-message">Cuéntame</label>
            <span class="char-count" data-char-count>0 / 1500</span>
          </div>
          <textarea id="c-message" name="message" placeholder="Sin formalismos, al grano." maxlength="1500" required></textarea>
        </div>

        <p class="disclaimer">
          Esto abre tu programa de correo con el mensaje ya escrito. No se guarda
          nada en ningún servidor, porque no hay servidor.
        </p>

        <div class="actions">
          <button class="btn btn-primary" type="submit">Abrir el correo</button>
          <button class="btn btn-ghost" type="button" data-copy>Copiar dirección</button>
        </div>

        <output class="status" data-status aria-live="polite"></output>
      </form>

      <p class="fallback">O directamente a <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--paper);
    border-top: 1px solid var(--line);
    margin-top: 56px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    padding-block: 52px;
  }
  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  .me {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 18px;
  }
  .me :global(.avatar) {
    width: 76px;
    height: 76px;
    object-fit: cover;
    border: 1px solid var(--line);
    flex: none;
  }
  .role {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .bio > p {
    margin-bottom: 12px;
    max-width: 62ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .qr {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .code {
    width: 116px;
    height: 116px;
    padding: 9px;
    background: #fff;
    border: 1px solid var(--line);
    flex: none;
  }
  .code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .qr strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 2px;
  }
  .qr span {
    display: block;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .qr .url {
    margin-top: 4px;
    color: var(--brand);
    font-weight: 600;
  }

  .form {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 520px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  .hp-slot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .char-count {
    font-size: 0.78rem;
    color: var(--ink-3);
  }
  input,
  select,
  textarea {
    width: 100%;
    font: 400 0.95rem var(--font-body);
    color: var(--ink);
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 10px 12px;
  }
  /* Altura fija: antes se podía estirar sin límite y descuadraba la web */
  textarea {
    height: 150px;
    resize: none;
    overflow-y: auto;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 1px var(--brand);
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--wrong);
  }
  .disclaimer {
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .status {
    font-size: 0.88rem;
    color: var(--correct);
    min-height: 1.2em;
  }
  .status[data-error] {
    color: var(--wrong);
  }
  .fallback {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .fallback a {
    color: var(--brand);
    font-weight: 600;
  }
</style>

<script>
  function initContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    if (!form || form.dataset.ready === '1') return;
    form.dataset.ready = '1';

    const email = form.dataset.email!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const name = form.querySelector<HTMLInputElement>('#c-name')!;
    const subject = form.querySelector<HTMLSelectElement>('#c-subject')!;
    const message = form.querySelector<HTMLTextAreaElement>('#c-message')!;
    const hp = form.querySelector<HTMLInputElement>('[name="b_hp"]');
    const charCount = form.querySelector<HTMLElement>('[data-char-count]');

    function say(text: string, error = false) {
      status.textContent = text;
      status.toggleAttribute('data-error', error);
    }

    function updateCounter() {
      if (charCount && message) {
        const len = message.value.length;
        charCount.textContent = `${len} / 1500`;
        charCount.style.color = len >= 1450 ? 'var(--wrong)' : 'var(--ink-3)';
      }
    }

    // Validación propia (novalidate) para poder escribir los mensajes
    // en el mismo tono que el resto del sitio.
    function check(el: HTMLInputElement | HTMLTextAreaElement, msg: string) {
      const empty = !el.value.trim();
      el.setAttribute('aria-invalid', String(empty));
      if (empty) {
        say(msg, true);
        el.focus();
      }
      return !empty;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Bloqueo de spambots que rellenan el campo trampa (honeypot)
      if (hp && hp.value.trim() !== '') {
        say('Envío bloqueado.');
        return;
      }

      if (!check(name, 'Ponme al menos un nombre.')) return;
      if (!check(message, 'El mensaje está vacío.')) return;

      // Truncar si supera los límites máximos por seguridad de URL mailto:
      const cleanName = name.value.trim().slice(0, 80);
      const cleanMessage = message.value.trim().slice(0, 1500);

      const body = `${cleanMessage}\n\n—\n${cleanName}\nEnviado desde repasaYA`;
      const url =
        `mailto:${email}` +
        `?subject=${encodeURIComponent(`[repasaYA] ${subject.value}`)}` +
        `&body=${encodeURIComponent(body)}`;

      window.location.href = url;
      say('Abriendo tu correo… si no pasa nada, copia la dirección.');
    });

    form.querySelector('[data-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        say('Dirección copiada.');
      } catch {
        say(email, true);
      }
    });

    // Contador y limpieza de avisos al escribir
    message.addEventListener('input', updateCounter);
    updateCounter();

    for (const el of [name, message]) {
      el.addEventListener('input', () => {
        if (el.value.trim()) el.setAttribute('aria-invalid', 'false');
      });
    }
  }

  initContact();
  document.addEventListener('astro:page-load', initContact);
</script>
