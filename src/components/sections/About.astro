---
/**
 * Sobre mí + contacto.
 *
 * El formulario no manda nada a ningún servidor: compone un `mailto:`
 * con lo que escribes y abre tu cliente de correo. En un sitio estático
 * sin backend es la única forma honesta de tener formulario sin meter
 * un servicio de terceros que rastree a quien lo use.
 *
 * ⚠️ El texto de la bio es un punto de partida: cámbialo a tu gusto.
 */
import { Image } from 'astro:assets';
import avatar from '../../assets/julian-avatar.jpg';
import qrImg from '../../assets/qr-repasaYA.png';

const EMAIL = 'e.carrionjuliann@go.ugr.es';
const GITHUB = 'https://github.com/jxliian';
const REPO = 'https://github.com/jxliian/repasaYA';
const PDF_LINK = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'Cartel_Anuncio_repasaYA.pdf';

const SUBJECTS = [
  'Aportar material',
  'He visto un fallo en una pregunta',
  'Sugerencia',
  'Otra cosa',
];
---

<section class="about container" id="sobre-mi" aria-labelledby="about-title">
  <div class="grid">
    <!-- ── Bio ──────────────────────────────────────────────── -->
    <div class="bio glass">
      <div class="bio-head">
        <Image
          class="avatar"
          src={avatar}
          alt="Julián Carrión"
          width={168}
          height={168}
          loading="lazy"
        />
        <div>
          <p class="mono-label">Sobre mí</p>
          <h2 id="about-title">Julián Carrión</h2>
          <p class="role">Doble Grado en ADE + Ingeniería Informática · Universidad de Granada</p>
        </div>
      </div>

      <div class="bio-text">
        <p>
          Monté repasaYA porque estaba harto de llegar a la semana de exámenes con
          200 diapositivas y ninguna forma decente de saber si me las sabía. Así que
          en vez de subrayar, me puse a convertir el temario en preguntas.
        </p>
        <p>
          Todo lo que hay aquí lo uso yo para estudiar lo mismo que tú. Por eso es
          gratis, no pide registro y no tiene un solo anuncio: no hay nada que
          monetizar, solo apuntes que ya existían.
        </p>
      </div>

      <div class="bio-qr">
        <Image
          src={qrImg}
          alt="Código QR repasaYA"
          class="qr-img"
          width={180}
          height={180}
          loading="lazy"
        />
        <a
          href={PDF_LINK}
          target="_blank"
          rel="noopener"
          class="btn btn-primary qr-btn"
        >
          📄 Descargar Cartel para Imprimir (PDF)
        </a>
      </div>



      <div class="bio-links">
        <a class="btn btn-ghost" href={GITHUB} target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          @jxliian
        </a>
        <a class="btn btn-ghost" href={REPO} target="_blank" rel="noopener">★ Código del proyecto</a>
      </div>
    </div>

    <!-- ── Contacto ─────────────────────────────────────────── -->
    <div class="contact glass">
      <p class="mono-label">Contacto</p>
      <h2>Escríbeme</h2>
      <p class="intro">
        ¿Una pregunta mal puesta, una asignatura que falta, apuntes que quieres
        compartir? Cuéntamelo.
      </p>

      <form class="form" data-contact data-email={EMAIL} novalidate>
        <div class="field">
          <label for="c-name">Cómo te llamas</label>
          <input id="c-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre (o un alias, me da igual)" required />
        </div>

        <div class="field">
          <label for="c-subject">De qué va</label>
          <select id="c-subject" name="subject">
            {SUBJECTS.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="c-message">Cuéntame</label>
          <textarea id="c-message" name="message" rows="6" placeholder="Sin formalismos, al grano." required></textarea>
        </div>

        <p class="disclaimer">
          Esto abre tu programa de correo con el mensaje ya escrito. No se guarda
          nada en ningún servidor, porque no hay servidor.
        </p>

        <div class="actions">
          <button class="btn btn-primary" type="submit">Abrir el correo</button>
          <button class="btn btn-ghost" type="button" data-copy>Copiar dirección</button>
        </div>

        <output class="status" data-status aria-live="polite"></output>
      </form>

      <p class="fallback">
        O directamente a <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Los rótulos globales se quedan cortos aquí: esta sección tiene sitio
     de sobra y el texto pedía leerse desde más lejos. */
  .about :global(.mono-label) {
    font-size: 0.76rem;
  }

  .about {
    padding-block: 84px 52px;
  }
  .grid {
    display: grid;
    /* Mismo ancho y misma altura para los dos cuadros: `stretch` iguala
       la altura y `1fr 1fr` el ancho. */
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 20px;
  }
  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .bio,
  .contact {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 34px;
    border-radius: var(--radius-lg);
  }

  /* ── Bio ───────────────────────────────────────────────────── */
  .bio-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }
  .avatar {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--glass-border-hi);
    box-shadow: var(--glow-sm);
  }
  .bio-head h2 {
    margin-top: 5px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.85rem;
    letter-spacing: -0.035em;
  }
  .role {
    margin-top: 6px;
    font-size: 0.92rem;
    color: var(--text-dim);
  }

  .bio-text p {
    font-size: 1.04rem;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .bio-text p + p {
    margin-top: 14px;
  }

  .bio-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
    margin-bottom: 8px;
    padding: 0;
    background: transparent;
    border: none;
    text-align: center;
  }
  .qr-img {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border-hi);
    box-shadow: var(--glow-sm);
  }
  .qr-btn {
    font-size: 0.9rem;
    padding: 12px 22px;
  }



  .bio-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 28px;
  }
  .bio-links .btn {
    padding: 12px 20px;
    font-size: 0.95rem;
  }

  /* ── Contacto ──────────────────────────────────────────────── */
  .contact h2 {
    margin-top: 5px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.85rem;
    letter-spacing: -0.035em;
  }
  .intro {
    margin-top: 10px;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .form {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
    color: var(--text);
    font-family: inherit;
    font-size: 0.98rem;
    transition: border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  textarea {
    resize: vertical;
    min-height: 132px;
    line-height: 1.55;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--text-dim);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--glass-border-hi);
    box-shadow: var(--glow-sm);
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--wrong);
    box-shadow: 0 0 0 3px var(--wrong-glow);
  }
  select {
    cursor: pointer;
  }
  /* El desplegable nativo hereda el fondo del sistema: hay que forzarlo */
  select option {
    background: var(--bg-elevated);
    color: var(--text);
  }

  .disclaimer {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .actions .btn {
    padding: 13px 22px;
    font-size: 0.95rem;
  }

  .status {
    min-height: 1.2em;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--correct);
  }
  .status[data-error] {
    color: var(--wrong);
  }

  .fallback {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--glass-border);
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .fallback a {
    color: var(--accent);
    word-break: break-all;
  }
  .fallback a:hover {
    text-decoration: underline;
  }
</style>

<script>
  function initContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    if (!form || form.dataset.ready === '1') return;
    form.dataset.ready = '1';

    const email = form.dataset.email!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const name = form.querySelector<HTMLInputElement>('#c-name')!;
    const subject = form.querySelector<HTMLSelectElement>('#c-subject')!;
    const message = form.querySelector<HTMLTextAreaElement>('#c-message')!;

    function say(text: string, error = false) {
      status.textContent = text;
      status.toggleAttribute('data-error', error);
    }

    // Validación propia (novalidate) para poder escribir los mensajes
    // en el mismo tono que el resto del sitio.
    function check(el: HTMLInputElement | HTMLTextAreaElement, msg: string) {
      const empty = !el.value.trim();
      el.setAttribute('aria-invalid', String(empty));
      if (empty) {
        say(msg, true);
        el.focus();
      }
      return !empty;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!check(name, 'Ponme al menos un nombre.')) return;
      if (!check(message, 'El mensaje está vacío.')) return;

      const body = `${message.value.trim()}\n\n—\n${name.value.trim()}\nEnviado desde repasaYA`;
      const url =
        `mailto:${email}` +
        `?subject=${encodeURIComponent(`[repasaYA] ${subject.value}`)}` +
        `&body=${encodeURIComponent(body)}`;

      window.location.href = url;
      say('Abriendo tu correo… si no pasa nada, copia la dirección.');
    });

    form.querySelector('[data-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        say('Dirección copiada.');
      } catch {
        say(email, true);
      }
    });

    // Al escribir se limpia el aviso de campo vacío
    for (const el of [name, message]) {
      el.addEventListener('input', () => {
        if (el.value.trim()) el.setAttribute('aria-invalid', 'false');
      });
    }
  }

  initContact();
  document.addEventListener('astro:page-load', initContact);
</script>
