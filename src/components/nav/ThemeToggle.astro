---
/** Interruptor claro/oscuro. La lógica global vive en Shell.astro. */
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Cambiar entre tema claro y oscuro"
  title="Cambiar tema"
>
  <svg class="i-moon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
  </svg>
  <svg class="i-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--glass-border-hi);
    box-shadow: var(--glow-sm);
  }
  /* Se muestra el icono del tema al que vas a cambiar */
  .theme-toggle svg {
    grid-area: 1 / 1;
  }
  .i-sun {
    display: none;
  }
  :root[data-theme='dark'] .i-moon {
    display: none;
  }
  :root[data-theme='dark'] .i-sun {
    display: block;
  }
</style>

<script>
  // Delegación en document: un único listener que sobrevive a las
  // navegaciones con View Transitions.
  if (!(window as any).__themeBound) {
    (window as any).__themeBound = true;

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('[data-theme-toggle]');
      if (!btn) return;
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      window.dispatchEvent(new Event('themechange'));
    });

    // El documento entrante no trae data-theme: se fija antes del swap
    // para que no parpadee en claro.
    document.addEventListener('astro:before-swap', (e) => {
      let t = 'dark';
      try {
        t = localStorage.getItem('theme') || 'dark';
      } catch (err) {}
      (e as any).newDocument.documentElement.dataset.theme = t;
    });
  }
</script>
