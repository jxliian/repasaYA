---
import { getCollection } from 'astro:content';
import GlobalSearch from '../search/GlobalSearch.astro';
import { degreePath } from '../../lib/routes';

/**
 * Cabecera corporativa: marca, navegación principal, buscador compacto y
 * el enlace para pedir una asignatura. Blanca, con borde inferior fino y
 * el subrayado dorado en la sección activa.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const degrees = (await getCollection('degrees')).sort((a, b) =>
  a.data.short.localeCompare(b.data.short, 'es')
);

const path = Astro.url.pathname;
const isHome = path === base;
const isActive = (href: string) => path.startsWith(href);

const REPO_URL = 'https://github.com/jxliian/repasaYA';
const ISSUE_URL = `${REPO_URL}/issues/new?title=Solicitud%3A+%5BAsignatura%5D&body=%23%23+Datos%0A-+**Asignatura**%3A+%0A-+**Grado**%3A+%0A-+**Curso**%3A+%0A-+**Cuatrimestre**%3A+`;
---

<a class="skip" href="#contenido">Saltar al contenido</a>

<header class="site-header">
  <div class="hdr-inner">
    <a class="brand" href={base} aria-label="repasaYA, inicio">repasaYA<span class="pt">.</span></a>

    <nav class="nav" aria-label="Principal">
      <a class:list={['nav-link', { active: isHome }]} href={`${base}#asignaturas`}>Asignaturas</a>
      {
        degrees.map((d) => (
          <a class:list={['nav-link', { active: isActive(degreePath(d.id)) }]} href={degreePath(d.id)}>
            {d.data.short}
          </a>
        ))
      }
      <a class="nav-link" href={`${base}#novedades`}>Novedades</a>
      <a class="nav-link" href={`${base}#sobre-mi`}>Sobre mí</a>
    </nav>

    {
      !isHome && (
        <div class="search-slot">
          <GlobalSearch variant="compact" id="hdr-search" placeholder="Buscar asignatura…" />
        </div>
      )
    }

    <a class="ask" href={ISSUE_URL} target="_blank" rel="noopener">Pedir asignatura</a>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    z-index: 999;
  }
  .skip:focus {
    left: 12px;
    top: 12px;
    padding: 10px 16px;
    border-radius: var(--radius);
    background: var(--brand);
    color: #fff;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .hdr-inner {
    max-width: var(--w-content);
    margin-inline: auto;
    height: var(--header-h);
    padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px));
    display: flex;
    align-items: center;
    gap: 28px;
  }
  @media (min-width: 720px) {
    .hdr-inner {
      padding-inline: 28px;
    }
  }

  .brand {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: -0.01em;
    color: var(--brand);
    flex: none;
  }

  .nav {
    display: flex;
    gap: 22px;
    height: 100%;
  }
  .nav-link {
    display: flex;
    align-items: center;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-2);
    border-bottom: 2px solid transparent;
    padding-top: 2px;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link.active {
    color: var(--ink);
    border-bottom-color: var(--dot);
  }

  .search-slot {
    flex: 1;
    min-width: 0;
    max-width: 320px;
    margin-left: auto;
  }

  .ask {
    margin-left: auto;
    flex: none;
    height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--brand);
  }
  .search-slot + .ask {
    margin-left: 0;
  }
  .ask:hover {
    border-color: var(--brand);
  }

  @media (max-width: 1000px) {
    .nav-link:nth-last-child(-n + 2) {
      display: none;
    }
  }
  /* Móvil: la navegación baja a una segunda fila desplazable */
  @media (max-width: 760px) {
    .hdr-inner {
      flex-wrap: wrap;
      height: auto;
      row-gap: 0;
      column-gap: 14px;
      padding-top: 10px;
    }
    .nav {
      order: 3;
      width: 100%;
      height: 42px;
      gap: 18px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-link,
    .nav-link:nth-last-child(-n + 2) {
      display: flex;
    }
    .search-slot {
      max-width: none;
    }
  }
  @media (max-width: 520px) {
    .ask {
      display: none;
    }
  }
</style>
