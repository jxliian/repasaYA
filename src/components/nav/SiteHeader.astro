---
import { getCollection } from 'astro:content';
import GlobalSearch from '../search/GlobalSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { degreePath } from '../../lib/routes';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const degrees = (await getCollection('degrees')).sort((a, b) =>
  a.data.short.localeCompare(b.data.short, 'es')
);

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);

const REPO_URL = 'https://github.com/jxliian/repasaYA';
const ISSUE_URL = `${REPO_URL}/issues/new?title=Solicitud%3A+%5BAsignatura%5D&body=%23%23+Datos%0A-+**Asignatura**%3A+%0A-+**Grado**%3A+%0A-+**Curso**%3A+%0A-+**Cuatrimestre**%3A+`;
---

<a class="skip" href="#contenido">Saltar al contenido</a>

<header class="site-header">
  <div class="hdr-inner">
    <a class="brand" href={base} aria-label="repasaYA — inicio">
      repasaYA<span class="dot" aria-hidden="true"></span>
    </a>

    <nav class="degrees" aria-label="Grados">
      {
        degrees.map((d) => (
          <a
            class:list={['deg-link', { active: isActive(degreePath(d.id)) }]}
            href={degreePath(d.id)}
          >
            <span aria-hidden="true">{d.data.icon}</span>
            {d.data.short}
          </a>
        ))
      }
    </nav>

    <div class="search-slot">
      <GlobalSearch variant="compact" id="hdr-search" placeholder="Buscar asignatura…" />
    </div>

    <div class="actions">
      <a class="icon-btn" href={REPO_URL} target="_blank" rel="noopener" aria-label="Ver el código en GitHub">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
      <ThemeToggle />
      <a class="ask" href={ISSUE_URL} target="_blank" rel="noopener">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        <span>Pedir asignatura</span>
      </a>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    z-index: 999;
  }
  .skip:focus {
    left: 12px;
    top: 12px;
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--glass-border);
    backdrop-filter: blur(var(--blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--blur)) saturate(150%);
  }
  .hdr-inner {
    max-width: var(--w-wide);
    margin-inline: auto;
    height: var(--header-h);
    padding-inline: clamp(14px, 3vw, 28px);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.16rem;
    letter-spacing: -0.055em;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    margin-bottom: 5px;
    animation: dotPulse 2.4s var(--ease-out) infinite;
  }
  @keyframes dotPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .degrees {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  .deg-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid transparent;
    transition: color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }
  .deg-link:hover {
    color: var(--text);
    background: var(--glass);
    border-color: var(--glass-border);
  }
  .deg-link.active {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .search-slot {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--glass-border-hi);
    box-shadow: var(--glow-sm);
  }

  .ask {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent-bright), var(--accent-deep));
    box-shadow: var(--glow-sm);
    transition: transform var(--dur) var(--ease-snap),
      box-shadow var(--dur) var(--ease-out);
  }
  .ask:hover {
    transform: translateY(-1px);
    box-shadow: var(--glow-md);
  }

  /* ── Adaptación ─────────────────────────────────────────────
     Se van cayendo por orden de prescindibilidad: primero el texto
     del botón, luego los grados, luego el buscador (queda ⌘K). */
  @media (max-width: 1080px) {
    .ask span {
      display: none;
    }
    .ask {
      padding: 9px 12px;
    }
  }
  @media (max-width: 900px) {
    .degrees {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .search-slot {
      display: none;
    }
    .icon-btn {
      display: none;
    }
  }
</style>
