---
// Wordmark "repasaYA" en 3D glossy tipo burbuja (Three.js). Geometría extruida e
// inflada desde la fuente real Unbounded vía opentype.js. Canvas a pantalla completa
// del hero (sin recortes al girar). Todo self-hosted; fallback CSS si no hay WebGL.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="hero3d" id="hero3d" data-font={`${base}fonts/unbounded-800.woff`}>
  <canvas id="hero3d-canvas" aria-hidden="true"></canvas>
  <div class="hero3d-fallback" aria-label="repasaYA">repasaYA</div>
</div>

<style>
  .hero3d { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 3; }
  #hero3d-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero3d-fallback {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; letter-spacing: -.02em;
    font-size: clamp(46px, 11vw, 150px); color: var(--accent);
    text-shadow: 0 8px 36px rgba(138,107,216,.4);
  }
  .hero3d.gl-on .hero3d-fallback { display: none; }
</style>

<script>
  function initHeroLogo() {
    const wrap = document.getElementById('hero3d');
    const canvas = document.getElementById('hero3d-canvas') as HTMLCanvasElement | null;
    if (!wrap || !canvas) return;

    const prev = (window as any).__heroLogo;
    if (prev) { try { cancelAnimationFrame(prev.raf); prev.dispose(); } catch (e) {} }

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fontUrl = wrap.dataset.font || '';

    (async () => {
      try {
        const THREE = await import('three');
        const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');
        const opentype: any = await import('opentype.js');
        const parse = opentype.parse || opentype.default?.parse;

        const buf = await fetch(fontUrl).then(r => r.arrayBuffer());
        const font = parse(buf);

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        if (!renderer.getContext()) return;            // sin WebGL → deja el fallback
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        camera.position.set(0, 0, 9);

        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
        scene.add(new THREE.AmbientLight(0xffffff, 0.5));
        const key = new THREE.DirectionalLight(0xffffff, 1.2); key.position.set(3, 6, 7); scene.add(key);
        const rim = new THREE.DirectionalLight(0xc9b6ff, 0.6); rim.position.set(-5, -2, 3); scene.add(rim);

        // ── Geometría inflada (burbuja) desde el contorno de Unbounded ──
        const size = 1;
        const path = font.getPath('repasaYA', 0, 0, size);
        const sp = new THREE.ShapePath();
        for (const c of path.commands) {
          if (c.type === 'M') sp.moveTo(c.x, -c.y);
          else if (c.type === 'L') sp.lineTo(c.x, -c.y);
          else if (c.type === 'Q') sp.quadraticCurveTo(c.x1, -c.y1, c.x, -c.y);
          else if (c.type === 'C') sp.bezierCurveTo(c.x1, -c.y1, c.x2, -c.y2, c.x, -c.y);
        }
        const shapes = sp.toShapes(true);
        const geo = new THREE.ExtrudeGeometry(shapes, {
          depth: size * 0.3, bevelEnabled: true,
          bevelThickness: size * 0.1, bevelSize: size * 0.062, bevelSegments: 10, curveSegments: 12,
        });
        geo.center();
        geo.computeBoundingBox();
        const bb = geo.boundingBox!;
        const wordW = bb.max.x - bb.min.x;

        // Deformación gelatinosa suave (uHover), sin glitch cromático
        const uniforms = { uTime: { value: 0 }, uHover: { value: 0 } };
        const mat = new THREE.MeshPhysicalMaterial({
          color: 0x8a6bd8, metalness: 0, roughness: 0.1,
          clearcoat: 1, clearcoatRoughness: 0.06, envMapIntensity: 1.35,
        });
        mat.onBeforeCompile = (shader: any) => {
          shader.uniforms.uTime = uniforms.uTime;
          shader.uniforms.uHover = uniforms.uHover;
          shader.vertexShader = 'uniform float uTime;uniform float uHover;\n' + shader.vertexShader;
          shader.vertexShader = shader.vertexShader.replace(
            '#include <begin_vertex>',
            '#include <begin_vertex>\nfloat w = sin(position.y*1.3 + uTime*1.8) * cos(position.x*0.9 + uTime*1.3);\ntransformed += normal * w * 0.05 * uHover;'
          );
        };
        const mesh = new THREE.Mesh(geo, mat);
        const group = new THREE.Group(); group.add(mesh); scene.add(group);

        function resize() {
          const r = wrap!.getBoundingClientRect();
          renderer.setSize(r.width, r.height, false);
          camera.aspect = (r.width || 1) / (r.height || 1);
          const fitW = wordW / 0.66;                  // wordmark ≈ 66% del ancho → grande, con margen
          const dist = (fitW / 2) / Math.tan((camera.fov * Math.PI / 180) / 2) / camera.aspect;
          camera.position.z = Math.max(4, dist);
          camera.updateProjectionMatrix();
        }
        resize();
        window.addEventListener('resize', resize);

        // Puntero (tilt suave + intensidad de la deformación)
        const pointer = { x: 0, y: 0, inside: false };
        function onMove(e: PointerEvent) {
          const r = canvas!.getBoundingClientRect();
          pointer.x = ((e.clientX - r.left) / r.width) * 2 - 1;
          pointer.y = ((e.clientY - r.top) / r.height) * 2 - 1;
          pointer.inside = true;
        }
        function onLeave() { pointer.inside = false; }
        wrap!.addEventListener('pointermove', onMove);
        wrap!.addEventListener('pointerleave', onLeave);

        const clock = new THREE.Clock();
        const state: any = {
          raf: 0,
          dispose() {
            window.removeEventListener('resize', resize);
            wrap!.removeEventListener('pointermove', onMove);
            wrap!.removeEventListener('pointerleave', onLeave);
            geo.dispose(); mat.dispose(); renderer.dispose(); pmrem.dispose();
          },
        };
        (window as any).__heroLogo = state;
        wrap!.classList.add('gl-on');

        function frame() {
          const t = clock.getElapsedTime();
          uniforms.uTime.value = t;
          const targetHover = pointer.inside ? 1 : 0;
          uniforms.uHover.value += (targetHover - uniforms.uHover.value) * 0.07;
          // tilt suave hacia el cursor (amplitud baja → no recorta)
          const tiltX = pointer.inside ? -pointer.y * 0.24 : Math.sin(t * 0.6) * 0.05;
          const tiltY = pointer.inside ?  pointer.x * 0.32 : Math.sin(t * 0.5) * 0.08;
          group.rotation.x += (tiltX - group.rotation.x) * 0.06;
          group.rotation.y += (tiltY - group.rotation.y) * 0.06;
          // respiración (burbuja viva) + pequeño hinchado al hover
          const breathe = 1 + Math.sin(t * 1.4) * 0.012 + uniforms.uHover.value * 0.025;
          group.scale.setScalar(breathe);
          renderer.render(scene, camera);
          state.raf = requestAnimationFrame(frame);
        }

        if (reduce) { renderer.render(scene, camera); }
        else {
          const io = new IntersectionObserver((ents) => {
            ents.forEach((en) => {
              if (en.isIntersecting && !state.raf) frame();
              else if (!en.isIntersecting && state.raf) { cancelAnimationFrame(state.raf); state.raf = 0; }
            });
          });
          io.observe(wrap!);
          const baseDispose = state.dispose;
          state.dispose = () => { io.disconnect(); baseDispose(); };
        }
      } catch (e) { /* sin WebGL/Three/font → fallback CSS visible */ }
    })();
  }

  function deferHeroLogo() {
    if (document.readyState === 'complete') {
      (window as any).requestIdleCallback ? (window as any).requestIdleCallback(initHeroLogo) : setTimeout(initHeroLogo, 200);
    } else {
      window.addEventListener('load', () => setTimeout(initHeroLogo, 150), { once: true });
    }
  }
  deferHeroLogo();
  document.addEventListener('astro:after-swap', deferHeroLogo);
</script>
