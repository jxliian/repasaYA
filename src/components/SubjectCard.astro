---
import type { Subject } from '../data/subjects';

interface Props {
  subject: Subject;
  degree?: 'ade' | 'info' | '';
}

const { subject: s, degree = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = s.external ?? `${base}${s.slug}/`;
const isExternal = !!s.external;
const hasFlashcards = s.chips.some(c => c.toLowerCase().includes('flashcard'));

type Badge = { label: string; cls: string };
const typeBadge: Record<string, Badge> = {
  test: { label: 'Test',       cls: 'b-purple' },
  vf:   { label: 'V/F',        cls: 'b-cyan'   },
  both: { label: 'Test + V/F', cls: 'b-multi'  },
};
const badge = typeBadge[s.type] ?? { label: s.type, cls: 'b-purple' };
---

<a
  class="scard"
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
  data-spot
  data-degree={degree}
  data-type={s.type}
  data-flashcards={hasFlashcards ? '1' : '0'}
  data-title={s.title.toLowerCase()}
  data-slug={s.slug}
  aria-label={`${s.title} — ${s.description}`}
>
  <!-- Spotlight radial that tracks cursor via --mx/--my -->
  <span class="scard-spot" aria-hidden="true"></span>
  <!-- Top accent line revealed on hover -->
  <span class="scard-line" aria-hidden="true"></span>

  <div class="scard-body">
    <div class="scard-head">
      <div class="scard-icon" aria-hidden="true">{s.icon}</div>
      <div class="scard-meta">
        <p class="scard-code">{s.code}</p>
        <p class="scard-name">{s.title}</p>
      </div>
      <span class={`scard-badge ${badge.cls}`}>{badge.label}</span>
    </div>

    <p class="scard-desc">{s.description}</p>

    <div class="scard-foot">
      {s.chips.map(chip => <span class="chip">{chip}</span>)}
      <span class="scard-arrow" aria-hidden="true">→</span>
    </div>
  </div>
</a>

<style>
  /* Tarjeta de asignatura — superficie sólida clara */
  .scard {
    --mx: 50%; --my: 50%;
    position: relative;
    display: flex; flex-direction: column;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    box-shadow: 0 10px 26px rgba(70,60,120,0.10);

    overflow: hidden;
    color: var(--text);
    transition:
      transform     0.22s cubic-bezier(0.4,0,0.2,1),
      background    0.22s,
      border-color  0.22s,
      box-shadow    0.22s;
    isolation: isolate;
  }

  .scard:hover {
    transform: translateY(-5px);
    background: var(--surface2);
    border-color: var(--accent-line);
    box-shadow:
      0 18px 40px rgba(70,60,120,0.18),
      0 0 0 1px var(--accent-soft);
  }

  /* Radial spotlight (follows cursor) */
  .scard-spot {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(
      220px circle at var(--mx) var(--my),
      rgba(138,107,216,0.10),
      transparent 70%
    );
    opacity: 0; transition: opacity .35s; pointer-events: none;
  }
  .scard:hover .scard-spot { opacity: 1; }

  /* Top gradient accent line */
  .scard-line {
    position: absolute; top: 0; left: 0; right: 0; height: 2px; z-index: 2;
    background: var(--accent);
    opacity: 0; transition: opacity .22s;
  }
  .scard:hover .scard-line { opacity: 1; }

  /* ── Content ── */
  .scard-body {
    position: relative; z-index: 3;
    display: flex; flex-direction: column; gap: 12px;
    padding: 22px; flex: 1;
  }
  .scard-head { display: flex; align-items: flex-start; gap: 12px; }

  .scard-icon {
    width: 42px; height: 42px; flex-shrink: 0;
    border-radius: 10px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem;
  }

  .scard-meta { flex: 1; min-width: 0; }
  .scard-code {
    font-family: var(--font-mono);
    font-size: .63rem; font-weight: 700; letter-spacing: .9px;
    text-transform: uppercase; color: var(--text-muted);
    margin-bottom: 3px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .scard-name {
    font-size: .95rem; font-weight: 700; line-height: 1.25; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* Type badges */
  .scard-badge {
    flex-shrink: 0; font-size: .6rem; font-weight: 700;
    border-radius: 99px; padding: 3px 9px; white-space: nowrap;
  }
  .b-purple { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); }
  .b-cyan   { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); }
  .b-multi  {
    background: var(--accent-soft);
    color: var(--accent); border: 1px solid var(--accent-line);
  }

  .scard-desc {
    font-size: .8rem; color: var(--text-muted); line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }

  .scard-foot {
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: auto;
  }
  .chip {
    font-size: .63rem; font-weight: 600;
    background: var(--accent-soft); border: 1px solid var(--accent-line);
    color: var(--accent); border-radius: 99px; padding: 2px 9px; white-space: nowrap;
  }
  .scard-arrow {
    margin-left: auto; font-size: .95rem; color: var(--accent);
    opacity: 0; transform: translateX(-5px);
    transition: opacity .2s, transform .2s; flex-shrink: 0;
  }
  .scard:hover .scard-arrow { opacity: 1; transform: translateX(0); }
</style>

<!-- Single deduped spotlight script targeting ALL [data-spot] on the page -->
<script>
  function initSpotlight() {
    document.querySelectorAll<HTMLElement>('[data-spot]').forEach(el => {
      if ((el as any).__spotted) return;
      (el as any).__spotted = true;
      el.addEventListener('mousemove', (e: MouseEvent) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
      el.addEventListener('mouseleave', () => {
        el.style.setProperty('--mx', '50%');
        el.style.setProperty('--my', '50%');
      });
    });
  }
  initSpotlight();
  document.addEventListener('astro:after-swap', initSpotlight);
</script>
