---
// QuizEngine — motor único para tipo test (4 opts), V/F con justificación, quiz reveal,
// mezcla combinada, modo racha supervivencia, puntos débiles y modos de examen UGR.
interface Props {
  title: string;
  code: string;
  vfData?: any[];
  testData?: any[];
  quizzData?: any[];
  backHref?: string;
  backLabel?: string;
  initialTab?: string;
}
const { title, code, vfData = [], testData = [], quizzData = [], backHref, backLabel, initialTab = 'practicar' } = Astro.props;
const hasVF    = vfData.length > 0;
const hasTest  = testData.length > 0;
const hasQuizz = quizzData.length > 0;
const hasBoth  = hasVF && hasTest;
const hasMultiple = [hasVF, hasTest, hasQuizz].filter(Boolean).length > 1;
const caseItems = testData.filter((q) => Boolean(q?.caseStatement));
const hasCases = caseItems.length > 0;
const uniqueCasesCount = new Set(caseItems.map((q) => q.caseId || q.caseTitle || q.tema)).size;
const startInCases = initialTab === 'supuestos' && hasCases;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<style is:global>
  :root[data-quiz],:root[data-quiz] body{height:100%;overflow:hidden}
  :root[data-quiz] header{background:var(--surface);border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  :root[data-quiz] .header-left{display:flex;align-items:center;gap:12px}
  :root[data-quiz] .header-right{display:flex;align-items:center;gap:12px}
  :root[data-quiz] .header-divider{color:var(--border)}
  :root[data-quiz] .logo{font-size:1.15rem;font-weight:800}:root[data-quiz] .logo span{color:var(--accent)}
  :root[data-quiz] .back{font-size:.8rem;color:var(--text-muted);transition:color .2s}:root[data-quiz] .back:hover{color:var(--accent)}
  :root[data-quiz] .tabs{display:flex;background:var(--surface);border-bottom:1px solid var(--border)}
  :root[data-quiz] .tab{padding:12px 20px;cursor:pointer;font-size:.9rem;color:var(--text-muted);border-bottom:2px solid transparent;transition:all .2s;user-select:none}
  :root[data-quiz] .tab.active{color:var(--accent);border-bottom-color:var(--accent)}:root[data-quiz] .tab:hover:not(.active){color:var(--text)}
  :root[data-quiz] main{flex:1;min-height:0;overflow-y:auto;padding:24px;max-width:860px;width:100%;margin:0 auto}
  :root[data-quiz] .panel{display:none;flex-direction:column;gap:20px}:root[data-quiz] .panel.active{display:flex}

  /* START */
  .start{display:flex;flex-direction:column;gap:22px;padding:8px 0}
  :root[data-quiz] .start-title{font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}
  :root[data-quiz] .mode-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
  :root[data-quiz] .mode-card{background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);padding:18px 16px;cursor:pointer;transition:all .2s;position:relative;user-select:none}
  :root[data-quiz] .mode-card:hover,:root[data-quiz] .mode-card.selected{border-color:var(--accent);background:var(--accent-soft);transform:translateY(-2px)}
  :root[data-quiz] .mode-card.selected::after{content:'✓';position:absolute;top:10px;right:12px;font-size:.8rem;font-weight:800;color:var(--accent)}
  :root[data-quiz] .mc-icon{font-size:1.5rem;margin-bottom:8px}:root[data-quiz] .mc-title{font-size:.95rem;font-weight:800;margin-bottom:4px}
  :root[data-quiz] .mc-desc{font-size:.76rem;color:var(--text-muted);line-height:1.35}
  :root[data-quiz] .mc-chip{display:inline-block;margin-top:8px;font-size:.68rem;font-weight:700;background:var(--surface2);border:1px solid var(--border);border-radius:99px;padding:2px 8px;color:var(--text-muted)}
  :root[data-quiz] .mode-card.selected .mc-chip{background:var(--accent-soft);border-color:var(--accent-line);color:var(--accent2)}
  
  /* EXAM OPTIONS TOGGLES */
  :root[data-quiz] .exam-options-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px}
  :root[data-quiz] .options-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
  :root[data-quiz] .opt-toggle{display:flex;align-items:center;gap:10px;font-size:.82rem;color:var(--text);cursor:pointer;user-select:none}
  :root[data-quiz] .opt-toggle input{accent-color:var(--accent);width:16px;height:16px;cursor:pointer}
  :root[data-quiz] .opt-toggle span strong{color:var(--accent)}

  :root[data-quiz] .sel-label{font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.8px;display:block;margin-bottom:8px}
  :root[data-quiz] .tema-chips{display:flex;flex-wrap:wrap;gap:8px}
  :root[data-quiz] .tema-chip{padding:6px 14px;border:1.5px solid var(--border);border-radius:99px;background:var(--surface2);color:var(--text-muted);font-size:.78rem;font-weight:600;cursor:pointer;transition:all .18s;user-select:none;line-height:1.5}
  :root[data-quiz] .tema-chip:hover{border-color:var(--accent);color:var(--accent2)}
  :root[data-quiz] .tema-chip.chip-on{border-color:var(--accent);background:var(--accent-soft);color:var(--accent2)}
  :root[data-quiz] .chip-all.chip-on{background:var(--accent);color:var(--on-accent)}
  :root[data-quiz] .chip-count{font-size:.65rem;opacity:.7;margin-left:4px}
  :root[data-quiz] .btn-start{width:100%;padding:16px;font-size:1rem;border-radius:var(--radius);background:var(--accent);color:var(--on-accent);border:none;font-weight:800;cursor:pointer;transition:all .2s}
  :root[data-quiz] .btn-start:hover{background:var(--accent-hover);box-shadow:0 4px 20px rgba(138,107,216,.35);transform:translateY(-1px)}

  /* PROGRESS & HEADER */
  .q-header{display:flex;justify-content:space-between;align-items:center;font-size:.8rem;color:var(--text-muted)}
  :root[data-quiz] .progress-bar{height:4px;background:var(--surface2);border-radius:99px;overflow:hidden;margin-top:6px}
  :root[data-quiz] .progress-fill{height:100%;background:var(--accent);border-radius:99px;transition:width .3s}
  :root[data-quiz] .score-live{color:var(--accent);font-weight:700}
  :root[data-quiz] .timer-badge{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:var(--wrong);padding:2px 8px;border-radius:99px;font-weight:700;font-family:var(--font-mono);font-size:.75rem}

  /* QUESTION CARD */
  .q-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:26px 22px;margin-top:14px}
  :root[data-quiz] .q-meta-line{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  :root[data-quiz] .q-tema-tag{font-size:.7rem;font-weight:700;font-family:var(--font-mono);color:var(--accent);text-transform:uppercase;letter-spacing:.8px}
  :root[data-quiz] .q-type-badge{font-size:.65rem;font-weight:800;font-family:var(--font-mono);background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:2px 6px;color:var(--text-muted)}
  :root[data-quiz] .q-text{font-size:1.05rem;line-height:1.65}

  /* VF CONTROLS */
  .vf-buttons{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}
  :root[data-quiz] .vf-btn{padding:16px;border:2px solid var(--border);border-radius:var(--radius);background:var(--surface2);color:var(--text);font-size:1rem;font-weight:700;cursor:pointer;transition:all .18s;position:relative}
  :root[data-quiz] .vf-btn:hover:not(:disabled){border-color:var(--accent);background:var(--accent-soft);color:var(--accent2);transform:translateY(-2px)}
  :root[data-quiz] .vf-btn:disabled{cursor:default;transform:none}
  :root[data-quiz] .vf-btn.chosen-correct{border-color:var(--correct);background:rgba(34,197,94,.12);color:var(--correct)}
  :root[data-quiz] .vf-btn.chosen-wrong{border-color:var(--wrong);background:rgba(239,68,68,.12);color:var(--wrong)}
  :root[data-quiz] .vf-btn.show-correct{border-color:var(--correct);background:rgba(34,197,94,.08);color:var(--correct)}
  :root[data-quiz] .vf-btn.chosen-deferred{border-color:var(--accent);background:var(--accent-soft);color:var(--accent2)}
  :root[data-quiz] .justification{margin-top:14px;border-radius:var(--radius);padding:14px 18px;font-size:.88rem;line-height:1.6;display:none}
  :root[data-quiz] .justification.show{display:block}
  :root[data-quiz] .justification.correct-just{background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2)}
  :root[data-quiz] .justification.wrong-just{background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2)}
  :root[data-quiz] .just-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
  :root[data-quiz] .correct-just .just-label{color:var(--correct)}:root[data-quiz] .wrong-just .just-label{color:var(--wrong)}

  /* QUIZZ REVEAL */
  .reveal-btn{width:100%;padding:14px;margin-top:18px;font-size:.95rem;font-weight:700;border-radius:var(--radius);background:var(--accent-soft);color:var(--accent);border:2px solid var(--accent-line);cursor:pointer;transition:all .2s}
  :root[data-quiz] .reveal-btn:hover:not(:disabled){background:var(--accent-line);border-color:var(--accent);transform:translateY(-1px)}
  :root[data-quiz] .quiz-answer-box{margin-top:16px;background:var(--accent-soft);border:1px solid var(--accent-line);border-radius:var(--radius);padding:16px 18px;font-size:.92rem;line-height:1.65;display:none}
  :root[data-quiz] .quiz-answer-box.show{display:block}
  :root[data-quiz] .quiz-answer-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:8px}

  /* TEST CONTROLS */
  .options{display:flex;flex-direction:column;gap:10px;margin-top:20px}
  :root[data-quiz] .opt-btn{display:flex;align-items:center;gap:14px;padding:14px 18px;border:2px solid var(--border);border-radius:var(--radius);background:var(--surface2);color:var(--text);font-size:.9rem;font-weight:500;cursor:pointer;transition:all .18s;text-align:left}
  :root[data-quiz] .opt-btn:hover:not(:disabled){border-color:var(--accent);background:var(--accent-soft);color:var(--accent2);transform:translateX(3px)}
  :root[data-quiz] .opt-btn:disabled{cursor:default;transform:none}
  :root[data-quiz] .opt-letter{flex-shrink:0;width:28px;height:28px;border-radius:7px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:800;color:var(--text-muted);transition:all .18s}
  :root[data-quiz] .opt-btn:hover:not(:disabled) .opt-letter{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
  :root[data-quiz] .opt-btn.chosen-correct{border-color:var(--correct);background:rgba(34,197,94,.1)}
  :root[data-quiz] .opt-btn.chosen-correct .opt-letter{background:var(--correct);border-color:var(--correct);color:#fff}
  :root[data-quiz] .opt-btn.chosen-wrong{border-color:var(--wrong);background:rgba(239,68,68,.1)}
  :root[data-quiz] .opt-btn.chosen-wrong .opt-letter{background:var(--wrong);border-color:var(--wrong);color:#fff}
  :root[data-quiz] .opt-btn.show-correct{border-color:var(--correct);background:rgba(34,197,94,.06)}
  :root[data-quiz] .opt-btn.show-correct .opt-letter{background:var(--correct);border-color:var(--correct);color:#fff}
  :root[data-quiz] .opt-btn.chosen-deferred{border-color:var(--accent);background:var(--accent-soft);color:var(--accent2)}
  :root[data-quiz] .opt-btn.chosen-deferred .opt-letter{background:var(--accent);border-color:var(--accent);color:#fff}

  :root[data-quiz] .feedback{margin-top:14px;border-radius:var(--radius);padding:12px 16px;font-size:.85rem;font-weight:600;display:none}
  :root[data-quiz] .feedback.show{display:block}
  :root[data-quiz] .feedback.correct{background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);color:var(--correct)}
  :root[data-quiz] .feedback.wrong{background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:var(--wrong)}

  /* NAV */
  .q-nav{display:flex;justify-content:space-between;align-items:center;margin-top:16px}
  :root[data-quiz] .kbd-hints{font-size:.7rem;font-family:var(--font-mono);color:var(--text-muted);display:flex;gap:8px;align-items:center}
  :root[data-quiz] .kbd-hints kbd{background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:2px 5px;font-size:.65rem;color:var(--text)}
  :root[data-quiz] .btn{padding:11px 22px;border:none;border-radius:var(--radius);font-size:.88rem;font-weight:700;cursor:pointer;transition:all .2s}
  :root[data-quiz] .btn-primary{background:var(--accent);color:var(--on-accent)}:root[data-quiz] .btn-primary:hover{background:var(--accent-hover)}
  :root[data-quiz] .btn-ghost{background:var(--surface2);color:var(--text);border:1px solid var(--border)}:root[data-quiz] .btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
  :root[data-quiz] .btn-danger{background:rgba(239,68,68,.15);color:var(--wrong);border:1px solid rgba(239,68,68,.3)}:root[data-quiz] .btn-danger:hover{background:rgba(239,68,68,.25);border-color:var(--wrong)}
  :root[data-quiz] .btn-back-top{background:none;border:none;color:var(--text-muted);font-size:.8rem;font-weight:600;cursor:pointer;padding:2px 6px;border-radius:6px;transition:color .2s;white-space:nowrap}:root[data-quiz] .btn-back-top:hover{color:var(--accent)}

  /* RESULTS */
  .stats-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px}
  :root[data-quiz] .stats-row{display:flex;justify-content:space-around;gap:12px;flex-wrap:wrap}
  :root[data-quiz] .stat-item{text-align:center}:root[data-quiz] .stat-num{font-size:2.2rem;font-weight:800;letter-spacing:-1px;font-family:var(--font-mono)}
  :root[data-quiz] .stat-lbl{font-size:.75rem;color:var(--text-muted);margin-top:2px}
  :root[data-quiz] .c-num{color:var(--correct)}:root[data-quiz] .w-num{color:var(--wrong)}:root[data-quiz] .p-num{color:var(--accent2)}
  :root[data-quiz] .ugr-badge{display:inline-block;margin-top:10px;font-size:.75rem;font-weight:700;background:rgba(124,92,255,.12);border:1px solid rgba(124,92,255,.25);color:var(--accent);padding:4px 12px;border-radius:99px}

  /* Desglose por categoría */
  .cat-list{display:flex;flex-direction:column;gap:14px}
  :root[data-quiz] .cat-row{display:flex;flex-direction:column;gap:6px}
  :root[data-quiz] .cat-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
  :root[data-quiz] .cat-name{font-size:.86rem;font-weight:700;color:var(--text)}
  :root[data-quiz] .cat-meta{font-size:.8rem;font-weight:700;font-family:var(--font-mono);white-space:nowrap}
  :root[data-quiz] .cat-meta .frac{color:var(--text-muted);font-weight:600;margin-left:6px}
  :root[data-quiz] .cat-bar{height:8px;border-radius:99px;background:var(--surface2);border:1px solid var(--border);overflow:hidden}
  :root[data-quiz] .cat-fill{height:100%;border-radius:99px;transition:width .5s ease}
  :root[data-quiz] .cat-fill.hi{background:var(--correct)}
  :root[data-quiz] .cat-fill.mid{background:var(--reveal)}
  :root[data-quiz] .cat-fill.lo{background:var(--wrong)}

  /* BANCO */
  .controls{display:flex;gap:10px;flex-wrap:wrap}
  :root[data-quiz] .search-box{flex:1;min-width:180px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:10px 14px;color:var(--text);font-size:.9rem;outline:none;transition:border-color .2s}
  :root[data-quiz] .search-box:focus{border-color:var(--accent)}:root[data-quiz] .search-box::placeholder{color:var(--text-muted)}
  :root[data-quiz] .cnt{font-size:.78rem;color:var(--text-muted)}
  :root[data-quiz] .bank-list{display:flex;flex-direction:column;gap:10px}
  :root[data-quiz] .bank-item{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 18px;display:flex;gap:14px}
  :root[data-quiz] .bank-badge{flex-shrink:0;width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:800}
  :root[data-quiz] .b-v{background:rgba(34,197,94,.12);color:var(--correct);border:1px solid rgba(34,197,94,.2)}
  :root[data-quiz] .b-f{background:rgba(239,68,68,.12);color:var(--wrong);border:1px solid rgba(239,68,68,.2)}
  :root[data-quiz] .b-t{background:var(--accent-soft);color:var(--accent);border:1px solid var(--accent-line);font-size:.6rem}
  :root[data-quiz] .bank-meta{font-size:.68rem;font-weight:700;font-family:var(--font-mono);color:var(--accent);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
  :root[data-quiz] .bank-q{font-size:.88rem;color:var(--text);margin-bottom:3px}:root[data-quiz] .bank-ans{font-size:.8rem;color:var(--text-muted);font-style:italic}
  :root[data-quiz] .github-fab{position:fixed;bottom:28px;right:28px;display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:99px;padding:12px 20px 12px 16px;color:var(--text);font-size:.85rem;font-weight:600;box-shadow:0 10px 26px rgba(70,60,120,.15);transition:all .25s;z-index:100}
  :root[data-quiz] .github-fab:hover{border-color:var(--accent);background:var(--surface2);color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft),0 0 24px rgba(138,107,216,.30);transform:translateY(-2px)}
  :root[data-quiz] .github-fab svg{flex-shrink:0;transition:transform .25s}:root[data-quiz] .github-fab:hover svg{transform:rotate(-8deg) scale(1.1)}
  :root[data-quiz] body{display:flex;flex-direction:column}
  :root[data-quiz] .theme-toggle:hover{border-color:var(--accent);color:var(--accent)}
  :root[data-quiz][data-theme="dark"] .theme-toggle .ic-sun{display:none}
  :root[data-quiz][data-theme="dark"] .theme-toggle .ic-moon{display:inline !important}
  /* NUEVAS FUNCIONALIDADES: FAVORITAS, STATS, PRINT, SHARE */
  .btn-star-q {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .btn-star-q:hover {
    border-color: #f59e0b;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
  }
  .btn-star-q.is-starred {
    border-color: #f59e0b;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.15);
  }

  .user-stats-bar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 18px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .usb-item { display: flex; flex-direction: column; align-items: center; }
  .usb-val { font-size: 1.15rem; font-weight: 800; font-family: var(--font-mono); color: var(--accent); }
  .usb-lbl { font-size: 0.68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .btn-reset-stats { background: transparent; border: none; cursor: pointer; opacity: 0.5; transition: opacity 0.2s; font-size: 0.9rem; }
  .btn-reset-stats:hover { opacity: 1; }

  .btn-print {
    width: 100%;
    margin-top: 10px;
    padding: 12px;
    font-size: 0.88rem;
    font-weight: 700;
    border-radius: var(--radius);
    background: var(--surface2);
    color: var(--text-muted);
    border: 1px dashed var(--border);
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-print:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .toast-notice {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--on-accent);
    padding: 10px 20px;
    border-radius: 99px;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .toast-notice.show { opacity: 1; }

  /* ── ENUNCIADO DE SUPUESTO / EXAMEN ONLINE ─────────────────── */
  :root[data-quiz] .q-case-box {
    background: var(--surface2);
    border: 1.5px solid var(--accent-line);
    border-left: 5px solid var(--accent);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 18px;
  }
  :root[data-quiz] .q-case-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  :root[data-quiz] .q-case-badge {
    font-size: 0.72rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  :root[data-quiz] .q-case-toggle {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
  }
  :root[data-quiz] .q-case-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  :root[data-quiz] .q-case-body {
    font-size: 0.94rem;
    line-height: 1.68;
    color: var(--text);
    white-space: pre-line;
    max-height: 280px;
    overflow-y: auto;
    padding-right: 6px;
  }
  :root[data-quiz] .q-case-box.collapsed .q-case-body {
    display: none;
  }

  /* PANEL SUPUESTOS / EXAMEN ONLINE */
  :root[data-quiz] .cases-selector-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  :root[data-quiz] .cases-chips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 10px;
  }
  :root[data-quiz] .case-sel-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    text-align: left;
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 2px solid var(--border);
    background: var(--surface2);
    color: var(--text);
    cursor: pointer;
    transition: all 0.18s;
  }
  :root[data-quiz] .case-sel-btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  :root[data-quiz] .case-sel-btn.active {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  :root[data-quiz] .case-sel-title {
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text);
  }
  :root[data-quiz] .case-sel-meta {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 700;
  }

  :root[data-quiz] .case-toolbar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  :root[data-quiz] .case-toolbar-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  :root[data-quiz] .case-toolbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  :root[data-quiz] .case-hero-statement {
    background: var(--surface);
    border: 2px solid var(--accent-line);
    border-left: 6px solid var(--accent);
    border-radius: var(--radius);
    padding: 24px 26px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.14);
    transition: all 0.2s;
  }
  :root[data-quiz] .case-hero-statement.is-sticky {
    position: sticky;
    top: 0;
    z-index: 30;
    max-height: 40vh;
    overflow-y: auto;
    background: var(--surface);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }
  :root[data-quiz] .case-hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  :root[data-quiz] .case-hero-kicker {
    font-size: 0.72rem;
    font-weight: 800;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--accent-line);
  }
  :root[data-quiz] .case-hero-title {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 800;
    color: var(--text);
    margin: 0 0 12px 0;
    line-height: 1.3;
  }
  :root[data-quiz] .case-hero-text {
    font-size: 1.04rem;
    line-height: 1.78;
    color: var(--text);
    white-space: pre-line;
  }
  :root[data-quiz] .case-hero-statement.collapsed .case-hero-text {
    display: none;
  }

  :root[data-quiz] .case-q-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  :root[data-quiz] .case-q-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    transition: border-color 0.2s;
  }
  :root[data-quiz] .case-q-item.graded-ok {
    border-color: var(--correct);
  }
  :root[data-quiz] .case-q-item.graded-wrong {
    border-color: var(--wrong);
  }
  :root[data-quiz] .case-q-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  :root[data-quiz] .case-q-num {
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  :root[data-quiz] .case-q-status {
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
  :root[data-quiz] .case-q-prompt {
    font-size: 1.03rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: 14px;
  }

  #print-container {
    display: none !important;
  }

  /* ── OPTIMIZACIÓN RESPONSIVA MÓVIL ────────────────────────── */
  @media (max-width: 768px) {
    /* 1. Ocultar RepasaBot (Dudas) y botón flotante de GitHub */
    :root[data-quiz] #repasa-bot-root,
    :root[data-quiz] .github-fab {
      display: none !important;
    }

    /* 2. Cabecera en el Menú: solo la flecha para salir a la asignatura y el botón de tema */
    :root[data-quiz] header {
      padding: 10px 14px;
      gap: 8px;
    }
    :root[data-quiz] .back-label,
    :root[data-quiz] .header-divider,
    :root[data-quiz] header .logo,
    :root[data-quiz] #hdr-stats {
      display: none !important;
    }
    :root[data-quiz] .back {
      font-size: 1.3rem;
      font-weight: 700;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 36px;
      min-height: 36px;
      padding: 4px 10px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
    }
    :root[data-quiz] .back:hover {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }

    /* 3. Pestañas: ocultar Banco en móvil; si solo hay test, ocultar toda la barra */
    :root[data-quiz] .tab[data-tab="banco"] {
      display: none !important;
    }
    :root[data-quiz] .tabs:not(.has-cases) {
      display: none !important;
    }
    :root[data-quiz] .tab {
      padding: 10px 14px;
      font-size: 0.82rem;
    }

    /* 4. En realización de tipo test (data-quiz-active): */
    /* Ocultar cabecera superior y pestañas para que ARRIBA SOLO quede la flecha para salir al menú */
    :root[data-quiz-active="true"] header,
    :root[data-quiz-active="true"] .tabs {
      display: none !important;
    }

    /* 5. Ajustes de espacio y legibilidad en el test */
    :root[data-quiz] main {
      padding: 12px 10px;
    }
    :root[data-quiz] .q-header {
      padding: 4px 2px 8px;
    }
    :root[data-quiz] .btn-back-top {
      font-size: 0.84rem;
      font-weight: 700;
      padding: 6px 12px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    :root[data-quiz] .q-card {
      padding: 16px 14px;
      margin-top: 10px;
    }
    :root[data-quiz] .kbd-hints {
      display: none !important;
    }
    :root[data-quiz] .q-case-body {
      max-height: 180px;
      font-size: 0.88rem;
    }
  }

  @media print {
    body > * { visibility: hidden !important; }
    #print-container, #print-container * { visibility: visible !important; display: block !important; }
    #print-container {
      display: block !important;
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      color: #000;
      background: #fff;
      padding: 20px;
      font-family: sans-serif;
    }
    .print-q { margin-bottom: 18px; page-break-inside: avoid; }
    .print-q-title { font-weight: bold; margin-bottom: 6px; }
    .print-opt { margin-left: 16px; margin-bottom: 4px; }
    .print-key { margin-top: 40px; border-top: 2px solid #333; padding-top: 16px; page-break-before: auto; }
  }
</style>

<header class="quiz-header">
  <div class="header-left">
    <a class="back" href={backHref ?? base} aria-label="Volver a la asignatura">
      <span class="back-arrow">←</span>
      <span class="back-label">{backLabel ?? 'repasaYA'}</span>
    </a>
    <span class="header-divider">|</span>
    <div class="logo"><span>{code}</span> · {title}</div>
  </div>
  <div class="header-right">
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar tema" title="Cambiar tema" style="width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;background:var(--surface2);border:1px solid var(--border);color:var(--text);cursor:pointer">
      <svg class="ic-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      <svg class="ic-moon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <span style="font-size:.78rem;color:var(--text-muted)" id="hdr-stats">
      {hasVF && `${vfData.length} V/F`}{hasBoth && ' · '}{hasTest && `${testData.length} preguntas`}
    </span>
  </div>
</header>

<div class:list={['tabs', { 'has-cases': hasCases }]}>
  <div class:list={['tab', { active: !startInCases }]} data-tab="test">Test</div>
  {hasCases && (
    <div class:list={['tab', { active: startInCases }]} data-tab="supuestos" id="tab-btn-supuestos">
      📋 Examen Online por Supuestos ({uniqueCasesCount})
    </div>
  )}
  <div class="tab" data-tab="banco">Banco</div>
</div>

<main style="display:flex;flex-direction:column;flex:1;max-width:960px">
  <!-- TEST PANEL -->
  <div id="panel-test" class:list={['panel', { active: !startInCases }]}>

    <div id="selector-view" class="start">
      <div class="user-stats-bar" id="user-stats-bar" style="display:none">
        <div class="usb-item"><span class="usb-val" id="usb-avg">-</span><span class="usb-lbl">Nota Media UGR</span></div>
        <div class="usb-item"><span class="usb-val" id="usb-streak">0</span><span class="usb-lbl">Racha Máx 🔥</span></div>
        <div class="usb-item"><span class="usb-val" id="usb-total">0</span><span class="usb-lbl">Simulacros</span></div>
        <button class="btn-reset-stats" id="btn-reset-stats" title="Reiniciar estadísticas de esta asignatura">🗑️</button>
      </div>

      <div>
        <p class="start-title">Modo de preguntas</p>
        <div class="mode-grid">
          {hasVF && (
            <div class="mode-card selected" id="card-vf" onclick="selectMode('vf')">
              <div class="mc-icon">✓✗</div>
              <div class="mc-title">Verdadero / Falso</div>
              <div class="mc-desc">Afirmaciones con justificación.</div>
              <span class="mc-chip">{vfData.length} preguntas</span>
            </div>
          )}
          {hasTest && (
            <div class="mode-card" id="card-test" onclick="selectMode('test')">
              <div class="mc-icon">🧠</div>
              <div class="mc-title">Tipo test</div>
              <div class="mc-desc">4 opciones, una correcta.</div>
              <span class="mc-chip">{testData.length} preguntas</span>
            </div>
          )}
          {hasCases && (
            <div class="mode-card" id="card-cases-open" onclick="openSupuestosTab()">
              <div class="mc-icon">📋</div>
              <div class="mc-title">Examen con Enunciados</div>
              <div class="mc-desc">Enunciado grande arriba y preguntas test debajo.</div>
              <span class="mc-chip">{uniqueCasesCount} supuestos · {caseItems.length} preg.</span>
            </div>
          )}
          {hasBoth && (
            <div class="mode-card" id="card-mix" onclick="selectMode('mix')">
              <div class="mc-icon">🔀</div>
              <div class="mc-title">Mezcla Combinada</div>
              <div class="mc-desc">Combina Test y Verdadero/Falso.</div>
              <span class="mc-chip">{vfData.length + testData.length} preguntas</span>
            </div>
          )}
          <div class="mode-card" id="card-streak" onclick="selectMode('streak')">
            <div class="mc-icon">🔥</div>
            <div class="mc-title">Modo Racha</div>
            <div class="mc-desc">Supervivencia: falla 1 y finaliza.</div>
            <span class="mc-chip">Racha máx</span>
          </div>
          <div class="mode-card" id="card-weak" onclick="selectMode('weak')">
            <div class="mc-icon">🎯</div>
            <div class="mc-title">Puntos Débiles</div>
            <div class="mc-desc">Preguntas falladas guardadas.</div>
            <span class="mc-chip" id="chip-weak-count">0 acumuladas</span>
          </div>
          <div class="mode-card" id="card-starred" onclick="selectMode('starred')">
            <div class="mc-icon">⭐</div>
            <div class="mc-title">Mis Favoritas</div>
            <div class="mc-desc">Preguntas guardadas con estrella.</div>
            <span class="mc-chip" id="chip-starred-count">0 guardadas</span>
          </div>
          {hasQuizz && (
            <div class="mode-card" id="card-quizz" onclick="selectMode('quizz')">
              <div class="mc-icon">💡</div>
              <div class="mc-title">Quiz de repaso</div>
              <div class="mc-desc">Pregunta abierta, revela la respuesta.</div>
              <span class="mc-chip">{quizzData.length} preguntas</span>
            </div>
          )}
        </div>
      </div>

      <div class="exam-options-box">
        <p class="start-title">Modificadores de Examen (Opcional)</p>
        <div class="options-grid">
          <label class="opt-toggle">
            <input type="checkbox" id="chk-penalty" />
            <span><strong>Descuento por fallo UGR</strong> (-0.33 por fallo)</span>
          </label>
          <label class="opt-toggle">
            <input type="checkbox" id="chk-deferred" />
            <span><strong>Ocultar soluciones</strong> (ver nota al final)</span>
          </label>
          <label class="opt-toggle">
            <input type="checkbox" id="chk-timer" />
            <span><strong>Temporizador (30s)</strong> por pregunta</span>
          </label>
        </div>
      </div>

      <div>
        <span class="sel-label">Bloques <span id="sel-count" style="font-weight:400;text-transform:none;letter-spacing:0"></span></span>
        <div class="tema-chips" id="tema-chips"></div>
      </div>
      <button class="btn-start" id="btn-start">Empezar →</button>
      <button class="btn-print" id="btn-print">🖨️ Versión para Imprimir / PDF</button>
    </div>

    <div id="quiz-view" style="display:none">
      <div class="q-header">
        <button class="btn-back-top" id="btn-back">← Menú</button>
        <div style="display:flex;align-items:center;gap:10px">
          <span id="q-timer" class="timer-badge" style="display:none">⏱️ 30s</span>
          <span id="q-counter"></span>
        </div>
        <span class="score-live" id="q-score"></span>
      </div>
      <div class="progress-bar"><div class="progress-fill" id="q-progress" style="width:0%"></div></div>
      <div class="q-card">
        <div class="q-meta-line">
          <div class="q-tema-tag" id="q-tema"></div>
          <div style="display:flex;align-items:center;gap:8px">
            <button class="btn-star-q" id="btn-star-q" title="Guardar pregunta favorita">⭐ <span id="star-txt">Favorita</span></button>
            <div class="q-type-badge" id="q-type-badge"></div>
          </div>
        </div>
        <div class="q-case-box" id="q-case-box" style="display:none">
          <div class="q-case-hdr">
            <span class="q-case-badge" id="q-case-title">📋 Enunciado del Supuesto</span>
            <button type="button" class="q-case-toggle" id="q-case-toggle">Plegar / Desplegar enunciado</button>
          </div>
          <div class="q-case-body" id="q-case-body"></div>
        </div>
        <div class="q-text" id="q-text"></div>
        <!-- VF controls -->
        <div id="vf-controls">
          <div class="vf-buttons">
            <button class="vf-btn v-btn" id="btn-v">✓ VERDADERO <span style="font-size:.65rem;opacity:.65;margin-left:4px">[V / 1]</span></button>
            <button class="vf-btn f-btn" id="btn-f">✗ FALSO <span style="font-size:.65rem;opacity:.65;margin-left:4px">[F / 2]</span></button>
          </div>
          <div class="justification" id="just-box">
            <div class="just-label" id="just-label"></div>
            <div id="just-text"></div>
          </div>
        </div>
        <!-- Test controls -->
        <div id="test-controls" style="display:none">
          <div class="options" id="options-container"></div>
          <div class="feedback" id="feedback"></div>
          <div class="justification" id="test-just"><div id="test-just-text"></div></div>
        </div>
        <!-- Quizz reveal controls -->
        <div id="quizz-controls" style="display:none">
          <button class="reveal-btn" id="btn-reveal">Revelar respuesta <kbd style="font-size:.7rem;margin-left:4px">[Enter]</kbd></button>
          <div class="quiz-answer-box" id="quiz-answer-box">
            <div class="quiz-answer-label">Respuesta</div>
            <div id="quiz-answer-text"></div>
          </div>
        </div>
      </div>
      <div class="q-nav">
        <div class="kbd-hints">
          <span>Teclas: <kbd>1-4</kbd> opción | <kbd>Enter</kbd> siguiente | <kbd>←</kbd> <kbd>→</kbd> navegar</span>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn btn-ghost" id="btn-prev" style="display:none">← Anterior</button>
          <button class="btn btn-primary" id="btn-next" style="display:none">Siguiente →</button>
        </div>
      </div>
    </div>

    <div id="results-view" style="display:none;flex-direction:column;gap:20px">
      <div class="stats-box">
        <div style="font-size:1.1rem;font-weight:800;margin-bottom:16px">Resultado</div>
        <div class="stats-row">
          <div class="stat-item"><div class="stat-num p-num" id="r-pct"></div><div class="stat-lbl" id="r-pct-lbl">Nota</div></div>
          <div class="stat-item"><div class="stat-num c-num" id="r-ok"></div><div class="stat-lbl">Correctas</div></div>
          <div class="stat-item"><div class="stat-num w-num" id="r-fail"></div><div class="stat-lbl">Incorrectas</div></div>
          <div class="stat-item"><div class="stat-num" id="r-total"></div><div class="stat-lbl">Total</div></div>
        </div>
        <div id="ugr-note-container" style="text-align:center;display:none">
          <span class="ugr-badge" id="ugr-badge">Descuento UGR aplicado (-0.33 por fallo)</span>
        </div>
      </div>
      <div class="stats-box" id="cat-breakdown" style="display:none">
        <div style="font-size:1rem;font-weight:800;margin-bottom:16px">Acierto por categoría</div>
        <div id="cat-list" class="cat-list"></div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button class="btn btn-primary" id="btn-repeat">Repetir todo</button>
        <button class="btn btn-danger" id="btn-repeat-wrong" style="display:none">↺ Solo fallos</button>
        <button class="btn btn-ghost" id="btn-share-wa" style="background:rgba(37,211,102,.12);border-color:rgba(37,211,102,.3);color:#25D366;font-weight:700">📲 Compartir WhatsApp</button>
        <button class="btn btn-ghost" id="btn-copy-result">📋 Copiar nota</button>
        <button class="btn btn-ghost" id="btn-back2">← Volver</button>
      </div>
    </div>
  </div>

  <!-- SUPUESTOS / EXAMEN ONLINE PANEL -->
  {hasCases && (
    <div id="panel-supuestos" class:list={['panel', { active: startInCases }]}>
      <div class="cases-selector-card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
          <span class="start-title" style="margin:0">📋 Selecciona el Supuesto Práctico o Examen Oficial</span>
          <span style="font-size:0.76rem;color:var(--text-muted)">Lee el enunciado en grande arriba y responde las preguntas tipo test debajo</span>
        </div>
