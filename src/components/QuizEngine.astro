// ── SUPUESTOS / EXAMEN ONLINE CON ENUNCIADO EN GRANDE ────────────────
const CASE_GROUPS = [];
const caseGroupMap = new Map();
TEST_DATA.forEach((q, globalIdx) => {
  if (!q.caseStatement) return;
  const key = q.caseId || q.caseTitle || q.tema;
  if (!caseGroupMap.has(key)) {
    const grp = {
      id: key,
      title: q.caseTitle || q.tema,
      tema: q.tema,
      statement: q.caseStatement,
      questions: [],
    };
    caseGroupMap.set(key, grp);
    CASE_GROUPS.push(grp);
  }
  caseGroupMap.get(key).questions.push({ ...q, _globalIdx: globalIdx });
});

let casesInitialized = false;
let activeCaseIdx = 0;
let caseUserAnswers = {}; // { qIdx: chosenOptIdx }
let caseIsGraded = false;

function initCasesPanel() {
  if (!CASE_GROUPS.length) return;
  if (!casesInitialized) {
    casesInitialized = true;
    renderCaseSelectorChips();

    document.getElementById('btn-case-collapse')?.addEventListener('click', () => {
      document.getElementById('case-hero-statement')?.classList.toggle('collapsed');
    });
    document.getElementById('chk-case-sticky')?.addEventListener('change', (e) => {
      document.getElementById('case-hero-statement')?.classList.toggle('is-sticky', e.target.checked);
    });
    document.getElementById('chk-case-exam-mode')?.addEventListener('change', () => {
      renderActiveCaseQuestions();
    });
    document.getElementById('chk-case-penalty')?.addEventListener('change', () => {
      if (caseIsGraded) gradeActiveCaseExam(false);
    });
    document.getElementById('btn-case-grade')?.addEventListener('click', () => gradeActiveCaseExam(true));
    document.getElementById('btn-case-grade-bottom')?.addEventListener('click', () => gradeActiveCaseExam(true));
    document.getElementById('btn-case-reset')?.addEventListener('click', () => resetActiveCaseExam());
    document.getElementById('btn-case-reset-bottom')?.addEventListener('click', () => resetActiveCaseExam());
    document.getElementById('btn-case-top')?.addEventListener('click', () => {
      document.getElementById('case-hero-statement')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    selectCaseByIndex(0);
  }
}

function renderCaseSelectorChips() {
  const listEl = document.getElementById('cases-selector-list');
  if (!listEl) return;
  listEl.innerHTML = '';
  CASE_GROUPS.forEach((grp, i) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'case-sel-btn' + (i === activeCaseIdx ? ' active' : '');
    btn.innerHTML =
      `<span class="case-sel-title">${grp.title}</span>` +
      `<span class="case-sel-meta">${grp.questions.length} preguntas tipo test · ${grp.tema}</span>`;
    btn.addEventListener('click', () => selectCaseByIndex(i));
    listEl.appendChild(btn);
  });
}

function selectCaseByIndex(i) {
  if (i < 0 || i >= CASE_GROUPS.length) return;
  activeCaseIdx = i;
  caseUserAnswers = {};
  caseIsGraded = false;

  const chips = document.querySelectorAll('#cases-selector-list .case-sel-btn');
  chips.forEach((c, idx) => c.classList.toggle('active', idx === i));

  const grp = CASE_GROUPS[i];
  const titleEl = document.getElementById('case-hero-title');
  const textEl = document.getElementById('case-hero-text');
  const kickerEl = document.getElementById('case-hero-kicker');
  const bannerEl = document.getElementById('case-results-banner');

  if (bannerEl) bannerEl.style.display = 'none';
  if (kickerEl) kickerEl.textContent = `📄 ENUNCIADO DEL SUPUESTO (${i + 1} DE ${CASE_GROUPS.length}) · ${grp.tema}`;
  if (titleEl) titleEl.textContent = grp.title;
  if (textEl) textEl.textContent = grp.statement;

  renderActiveCaseQuestions();
}

function updateCaseLiveProgress() {
  const grp = CASE_GROUPS[activeCaseIdx];
  if (!grp) return;
  const answeredCount = Object.keys(caseUserAnswers).length;
  const progEl = document.getElementById('case-live-progress');
  if (progEl) {
    progEl.textContent = `${answeredCount} / ${grp.questions.length} respondidas`;
  }
}

function renderActiveCaseQuestions() {
  const grp = CASE_GROUPS[activeCaseIdx];
  const container = document.getElementById('case-q-list');
  if (!grp || !container) return;

  const isExamMode = document.getElementById('chk-case-exam-mode')?.checked;
  container.innerHTML = '';

  grp.questions.forEach((q, qIdx) => {
    const card = document.createElement('div');
    const chosen = caseUserAnswers[qIdx];
    const hasAnswered = chosen !== undefined;
    const isOk = hasAnswered && chosen === q.correct;
    const showSolution = caseIsGraded || (!isExamMode && hasAnswered);

    let cardCls = 'case-q-item';
    if (showSolution && hasAnswered) {
      cardCls += isOk ? ' graded-ok' : ' graded-wrong';
    }
    card.className = cardCls;

    // Si la pregunta tiene un enunciado específico distinto del general (ej. en el Simulacro Mixto), mostrarlo
    const hasSubStatement = q.caseStatement && q.caseStatement !== grp.statement;

    let statusText = 'Sin responder';
    if (showSolution) {
      if (!hasAnswered) statusText = '⚪ En blanco (0 pts)';
      else if (isOk) statusText = '✓ Correcta (+1 pt)';
      else statusText = '✗ Incorrecta';
    } else if (hasAnswered) {
      statusText = `Seleccionada: ${LETTERS[chosen]} (pulsa de nuevo para dejar en blanco)`;
    }

    const headHtml =
      `<div class="case-q-head">` +
      `<span class="case-q-num">Pregunta ${qIdx + 1} de ${grp.questions.length} · ${q.tema}</span>` +
      `<span class="case-q-status">${statusText}</span>` +
      `</div>`;

    const subStmtHtml = hasSubStatement
      ? `<div class="q-case-box" style="margin-bottom:14px"><div class="q-case-hdr"><span class="q-case-badge">📋 Datos específicos de esta pregunta</span></div><div class="q-case-body">${q.caseStatement}</div></div>`
      : '';

    const promptHtml = `<div class="case-q-prompt">${qIdx + 1}. ${q.q}</div>`;

    const optsDiv = document.createElement('div');
    optsDiv.className = 'options';
    optsDiv.style.marginTop = '12px';

    q.opts.forEach((optText, optIdx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      let btnCls = 'opt-btn';

      if (showSolution) {
        btn.disabled = true;
        if (hasAnswered && chosen === optIdx) {
          btnCls += isOk ? ' chosen-correct' : ' chosen-wrong';
        }
        if ((!hasAnswered || !isOk) && q.correct === optIdx) {
          btnCls += ' show-correct';
        }
      } else if (hasAnswered && chosen === optIdx) {
        btnCls += ' chosen-deferred';
      }

      btn.className = btnCls;
      btn.innerHTML = `<span class="opt-letter">${LETTERS[optIdx]}</span><span>${optText}</span>`;
      btn.addEventListener('click', () => handleCaseOptionClick(qIdx, optIdx));
      optsDiv.appendChild(btn);
    });

    card.innerHTML = headHtml + subStmtHtml + promptHtml;
    card.appendChild(optsDiv);

    if (showSolution) {
      const fb = document.createElement('div');
      if (hasAnswered) {
        fb.className = 'feedback show ' + (isOk ? 'correct' : 'wrong');
        fb.textContent = isOk
          ? `✓ Correcto — Opción ${LETTERS[q.correct]}: ${q.opts[q.correct]}`
          : `✗ Incorrecto — Marcaste ${LETTERS[chosen]}, pero la correcta es ${LETTERS[q.correct]}: ${q.opts[q.correct]}`;
      } else {
        fb.className = 'feedback show wrong';
        fb.textContent = `⚪ Dejada en blanco — La respuesta correcta es ${LETTERS[q.correct]}: ${q.opts[q.correct]}`;
      }
      card.appendChild(fb);

      if (q.justification) {
        const jbox = document.createElement('div');
        jbox.className = 'justification show ' + (hasAnswered && isOk ? 'correct-just' : 'wrong-just');
        jbox.innerHTML = `<div class="just-label">⚖️ Justificación Legal y Resolución Paso a Paso</div><div>${q.justification}</div>`;
        card.appendChild(jbox);
      }
    }

    container.appendChild(card);
  });

  updateCaseLiveProgress();
}

function handleCaseOptionClick(qIdx, optIdx) {
  const grp = CASE_GROUPS[activeCaseIdx];
  if (!grp || caseIsGraded) return;

  const isExamMode = document.getElementById('chk-case-exam-mode')?.checked;
  const q = grp.questions[qIdx];

  if (isExamMode) {
    // En Modo Examen Online se puede cambiar de opción o desmarcar para dejar en blanco
    if (caseUserAnswers[qIdx] === optIdx) {
      delete caseUserAnswers[qIdx];
    } else {
      caseUserAnswers[qIdx] = optIdx;
    }
    renderActiveCaseQuestions();
  } else {
    // En Modo Estudio se corrige al instante al pulsar
    if (caseUserAnswers[qIdx] !== undefined) return;
    caseUserAnswers[qIdx] = optIdx;
    if (optIdx === q.correct) removeWeakQuestion(q.q);
    else saveWeakQuestion(q.q);
    renderActiveCaseQuestions();
  }
}

function gradeActiveCaseExam(scrollToBanner) {
  const grp = CASE_GROUPS[activeCaseIdx];
  if (!grp) return;

  caseIsGraded = true;
  let okCount = 0;
  let wrongCount = 0;
  let blankCount = 0;

  grp.questions.forEach((q, qIdx) => {
    const chosen = caseUserAnswers[qIdx];
    if (chosen === undefined) {
      blankCount++;
    } else if (chosen === q.correct) {
      okCount++;
      removeWeakQuestion(q.q);
    } else {
      wrongCount++;
      saveWeakQuestion(q.q);
    }
  });

  const applyPenalty = document.getElementById('chk-case-penalty')?.checked;
  const rawPoints = applyPenalty ? Math.max(0, okCount - wrongCount * 0.33) : okCount;
  const finalNote = Math.max(0, Math.round((rawPoints / grp.questions.length) * 100) / 10);

  const banner = document.getElementById('case-results-banner');
  if (banner) {
    banner.style.display = 'block';
    document.getElementById('cr-note').textContent = `${finalNote.toFixed(1)}`;
    document.getElementById('cr-ok').textContent = String(okCount);
    document.getElementById('cr-wrong').textContent = String(wrongCount);
    document.getElementById('cr-blank').textContent = String(blankCount);
    document.getElementById('case-results-badge').textContent = applyPenalty
      ? 'Descuento oficial UGR aplicado (-0,33 por fallo)'
      : 'Nota directa sin penalización';
  }

  saveUserAttempt(finalNote, okCount);
  updateWeakChipCount();
  renderActiveCaseQuestions();

  if (scrollToBanner && banner) {
    banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    showToast(`Examen corregido: ${finalNote.toFixed(1)} / 10 (${okCount} aciertos)`);
  }
}

function resetActiveCaseExam() {
  caseUserAnswers = {};
  caseIsGraded = false;
  const banner = document.getElementById('case-results-banner');
  if (banner) banner.style.display = 'none';
  renderActiveCaseQuestions();
  showToast('Supuesto reiniciado 🔄');
}

if (startInCases && hasCases) {
  initCasesPanel();
}

// Banco
const ALL_BANK = [...VF_DATA, ...TEST_DATA];
let bankReady = false;

function initBank(){
  if (bankReady) return;
  bankReady = true;
  const sel = document.getElementById('b-tema');
  [...new Set(ALL_BANK.map(q => q.tema))].forEach(t => {
    const o = document.createElement('option'); o.value = t; o.textContent = t; sel.appendChild(o);
  });
  document.getElementById('b-search').addEventListener('input', filterBank);
  const bTipo = document.getElementById('b-tipo');
  const bTema = document.getElementById('b-tema');
  if (bTipo) bTipo.addEventListener('change', filterBank);
  if (bTema) bTema.addEventListener('change', filterBank);
  filterBank();
}

function filterBank(){
  const s = document.getElementById('b-search').value.toLowerCase();
  const bTipo = document.getElementById('b-tipo');
  const tipo = bTipo ? bTipo.value : '';
  const tema = document.getElementById('b-tema').value;
  const list = ALL_BANK.filter(q =>
    (!tipo || q.qType === tipo) &&
    (!tema || q.tema === tema) &&
    (!s || q.q.toLowerCase().includes(s))
  );
  document.getElementById('b-count').textContent = `${list.length} preguntas`;
  const el = document.getElementById('b-list'); el.innerHTML = '';
  list.forEach(q => {
    const div = document.createElement('div'); div.className = 'bank-item';
    const badge = q.qType === 'vf'
      ? `<div class="bank-badge ${q.answer==='V'?'b-v':'b-f'}">${q.answer}</div>`
      : '<div class="bank-badge b-t">Test</div>';
    const ans = q.qType === 'vf' ? q.justification : (q.opts ? q.opts[q.correct] : '');
    div.innerHTML = `${badge}<div><div class="bank-meta">${q.tema}</div><div class="bank-q">${q.q}</div><div class="bank-ans">${ans}</div></div>`;
    el.appendChild(div);
  });
}
</script>
