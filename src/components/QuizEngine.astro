<script define:vars={{ vfData, testData, quizzData, hasMultiple, hasVF, hasTest, hasQuizz, hasBoth, code }}>
const LETTERS = ['A','B','C','D','E'];
const VF_DATA    = vfData.map(q => ({ ...q, qType: 'vf' }));
const TEST_DATA  = testData.map(q => ({ ...q, qType: 'test' }));
const QUIZZ_DATA = quizzData.map(q => ({ ...q, qType: 'quizz' }));

const VF_TEMAS    = [...new Set(VF_DATA.map(q=>q.tema))];
const TEST_TEMAS  = [...new Set(TEST_DATA.map(q=>q.tema))];
const QUIZZ_TEMAS = [...new Set(QUIZZ_DATA.map(q=>q.tema))];

let selectedMode = hasVF ? 'vf' : hasTest ? 'test' : 'quizz';
let questions=[], idx=0, correct=0, wrong=0, answered=false;
let answers=[];   // answers[i] = {chosen, wasCorrect}
let selectedTemas = new Set();
let timerInterval = null;
let timeLeft = 30;

// Local storage keys
const WEAK_KEY = 'ry_weak_' + code;
const STAR_KEY = 'ry_star_' + code;
const STATS_KEY = 'ry_stats_' + code;

function getWeakQuestions() {
  try {
    const raw = localStorage.getItem(WEAK_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (e) { return []; }
}
function saveWeakQuestion(qText) {
  try {
    const list = getWeakQuestions();
    if (!list.includes(qText)) {
      list.push(qText);
      localStorage.setItem(WEAK_KEY, JSON.stringify(list));
    }
  } catch (e) {}
}
function removeWeakQuestion(qText) {
  try {
    const list = getWeakQuestions().filter(t => t !== qText);
    localStorage.setItem(WEAK_KEY, JSON.stringify(list));
  } catch (e) {}
}

function updateWeakChipCount() {
  const chip = document.getElementById('chip-weak-count');
  if (chip) {
    const count = getWeakQuestions().length;
    chip.textContent = count > 0 ? `${count} falladas` : '0 acumuladas';
  }
}

// Favoritas (Starred)
function getStarredQuestions() {
  try {
    const raw = localStorage.getItem(STAR_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed.filter(x => typeof x === 'string' && x.trim()) : [];
  } catch (e) { return []; }
}
function toggleStarCurrentQ(e) {
  if (e && e.stopPropagation) e.stopPropagation();
  if (!questions || !questions[idx]) return;
  const qText = String(questions[idx].q || '').trim();
  if (!qText) return;

  let list = getStarredQuestions();
  if (list.includes(qText)) {
    list = list.filter(t => t !== qText);
    showToast('Estrella quitada ⭐');
  } else {
    list.push(qText);
    showToast('¡Guardada en Favoritas! ⭐');
  }
  localStorage.setItem(STAR_KEY, JSON.stringify(list));
  updateStarredState();
  updateStarredChipCount();
}
function updateStarredState() {
  if (!questions || !questions[idx]) return;
  const btn = document.getElementById('btn-star-q');
  if (!btn) return;
  const qText = String(questions[idx].q || '').trim();
  const isStarred = getStarredQuestions().includes(qText);
  btn.classList.toggle('is-starred', isStarred);
  const txt = document.getElementById('star-txt');
  if (txt) txt.textContent = isStarred ? 'Guardada' : 'Favorita';
}
function updateStarredChipCount() {
  const chip = document.getElementById('chip-starred-count');
  if (chip) {
    const count = getStarredQuestions().length;
    chip.textContent = count > 0 ? `${count} guardadas` : '0 guardadas';
  }
}

// Estadísticas de usuario
function getUserStats() {
  try {
    const raw = localStorage.getItem(STATS_KEY);
    return raw ? JSON.parse(raw) : { attempts: 0, totalScore: 0, maxStreak: 0 };
  } catch (e) { return { attempts: 0, totalScore: 0, maxStreak: 0 }; }
}
function saveUserAttempt(finalNote, streakAchieved) {
  try {
    const stats = getUserStats();
    stats.attempts = (stats.attempts || 0) + 1;
    stats.totalScore = (stats.totalScore || 0) + finalNote;
    if (streakAchieved > (stats.maxStreak || 0)) {
      stats.maxStreak = streakAchieved;
    }
    localStorage.setItem(STATS_KEY, JSON.stringify(stats));
    renderUserStats();
  } catch (e) {}
}
function renderUserStats() {
  const bar = document.getElementById('user-stats-bar');
  if (!bar) return;
  const stats = getUserStats();
  if (stats.attempts > 0 || stats.maxStreak > 0) {
    bar.style.display = 'flex';
    const avg = (stats.totalScore / stats.attempts).toFixed(1);
    document.getElementById('usb-avg').textContent = `${avg}/10`;
    document.getElementById('usb-streak').textContent = stats.maxStreak || 0;
    document.getElementById('usb-total').textContent = stats.attempts || 0;
  } else {
    bar.style.display = 'none';
  }
}
function resetUserStats(e) {
  if (e && e.stopPropagation) e.stopPropagation();
  if (confirm('¿Quieres reiniciar las estadísticas de esta asignatura?')) {
    localStorage.removeItem(STATS_KEY);
    renderUserStats();
    showToast('Estadísticas reiniciadas 🗑️');
  }
}

// Exponer en window para onclicks inline
window.resetUserStats = resetUserStats;
window.toggleStarCurrentQ = toggleStarCurrentQ;

// Toast
function showToast(msg) {
  const toast = document.getElementById('toast-notice');
  if (!toast) return;
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2500);
}

updateWeakChipCount();
updateStarredChipCount();
renderUserStats();

function selectMode(mode){
  selectedMode = mode;
  selectedTemas.clear();
  ['vf','test','mix','streak','weak','starred','quizz'].forEach(m=>{
    const el = document.getElementById('card-'+m);
    if(el) el.classList.toggle('selected', m===mode);
  });
  const examBox = document.querySelector('.exam-options-box');
  if (examBox) {
    examBox.style.display = (mode === 'quizz' || mode === 'starred' || mode === 'weak') ? 'none' : '';
  }
  renderChips();
}
window.selectMode = selectMode;
selectMode(selectedMode);

function getSourceForMode() {
  if (selectedMode === 'vf') return VF_DATA;
  if (selectedMode === 'test') return TEST_DATA;
  if (selectedMode === 'quizz') return QUIZZ_DATA;
  if (selectedMode === 'mix') return [...VF_DATA, ...TEST_DATA];
  if (selectedMode === 'streak') return [...VF_DATA, ...TEST_DATA, ...QUIZZ_DATA];
  if (selectedMode === 'weak') {
    const weakTexts = getWeakQuestions();
    const all = [...VF_DATA, ...TEST_DATA, ...QUIZZ_DATA];
    return all.filter(q => q && q.q && weakTexts.includes(String(q.q).trim()));
  }
  if (selectedMode === 'starred') {
    const starredTexts = getStarredQuestions();
    const all = [...VF_DATA, ...TEST_DATA, ...QUIZZ_DATA];
    return all.filter(q => q && q.q && starredTexts.includes(String(q.q).trim()));
  }
  return [...VF_DATA, ...TEST_DATA];
}

function renderChips(){
  const src = getSourceForMode();
  const temas = [...new Set(src.map(q => q.tema))];
  const container = document.getElementById('tema-chips');
  container.innerHTML = '';

  const allChip = document.createElement('button');
  allChip.className = 'tema-chip chip-all' + (selectedTemas.size===0 ? ' chip-on' : '');
  allChip.innerHTML = 'Todos<span class="chip-count">'+src.length+'</span>';
  allChip.addEventListener('click', () => { selectedTemas.clear(); renderChips(); });
  container.appendChild(allChip);

  temas.forEach(t => {
    const count = src.filter(q => q.tema === t).length;
    const chip = document.createElement('button');
    chip.className = 'tema-chip' + (selectedTemas.has(t) ? ' chip-on' : '');
    chip.innerHTML = t + '<span class="chip-count">'+count+'</span>';
    chip.addEventListener('click', () => {
      if(selectedTemas.has(t)) selectedTemas.delete(t);
      else selectedTemas.add(t);
      renderChips();
    });
    container.appendChild(chip);
  });

  const countEl = document.getElementById('sel-count');
  if(countEl){
    if(selectedTemas.size===0) countEl.textContent='';
    else countEl.textContent = '· '+selectedTemas.size+' de '+temas.length+' seleccionados';
  }
}
renderChips();

function shuffle(a){return [...a].sort(()=>Math.random()-.5)}

function startQuiz(){
  const src = getSourceForMode();
  if (selectedMode === 'weak' && src.length === 0) {
    alert('¡Enhorabuena! No tienes ninguna pregunta fallada acumulada en esta asignatura.');
    return;
  }
  if (selectedMode === 'starred' && src.length === 0) {
    alert('Aún no has guardado ninguna pregunta favorita con la estrella ⭐.');
    return;
  }

  const pool = selectedTemas.size===0 ? src : src.filter(q => selectedTemas.has(q.tema));
  questions = shuffle(pool);
  idx = 0; correct = 0; wrong = 0; answers = [];

  hide('selector-view'); hide('results-view'); show('quiz-view');
  showQ();
}

function startTimer() {
  clearInterval(timerInterval);
  const timerBadge = document.getElementById('q-timer');
  const isTimerOn = document.getElementById('chk-timer')?.checked;
  if (!isTimerOn) {
    if (timerBadge) timerBadge.style.display = 'none';
    return;
  }

  timeLeft = 30;
  if (timerBadge) {
    timerBadge.style.display = 'inline-block';
    timerBadge.textContent = `⏱️ ${timeLeft}s`;
  }

  timerInterval = setInterval(() => {
    timeLeft--;
    if (timerBadge) timerBadge.textContent = `⏱️ ${timeLeft}s`;
    if (timeLeft <= 0) {
      clearInterval(timerInterval);
      handleTimeout();
    }
  }, 1000);
}

function handleTimeout() {
  if (answered) return;
  const q = questions[idx];
  if (q.qType === 'vf') answerVF(q.answer === 'V' ? 'F' : 'V');
  else if (q.qType === 'test') answerTest(q.correct === 0 ? 1 : 0);
  else answerReveal();
}

function updateLiveScore() {
  const isDeferred = document.getElementById('chk-deferred')?.checked;
  const scoreEl = document.getElementById('q-score');
  if (!scoreEl) return;
  if (selectedMode === 'streak') {
    scoreEl.textContent = `🔥 Racha: ${correct}`;
  } else if (isDeferred) {
    const totalAnswered = answers.filter(Boolean).length;
    scoreEl.textContent = `Respondidas: ${totalAnswered} / ${questions.length}`;
  } else {
    scoreEl.textContent = `✓${correct}  ✗${wrong}`;
  }
}

function showQ(){
  answered = false;
  clearInterval(timerInterval);
  const q = questions[idx];
  const isDeferred = document.getElementById('chk-deferred')?.checked;
  
  document.getElementById('q-tema').textContent = q.tema;
  document.getElementById('q-type-badge').textContent = q.qType === 'vf' ? 'V/F' : q.qType === 'test' ? 'TEST' : 'QUIZ';
  document.getElementById('q-text').textContent = q.q;
  document.getElementById('q-counter').textContent = `${idx+1} / ${questions.length}`;

  updateLiveScore();
  updateStarredState();

  document.getElementById('q-progress').style.width = `${(idx/questions.length)*100}%`;
  hide_el('btn-next');
  idx > 0 ? show_el('btn-prev') : hide_el('btn-prev');

  const vfCtrl = document.getElementById('vf-controls');
  const testCtrl = document.getElementById('test-controls');
  const quizzCtrl = document.getElementById('quizz-controls');

  vfCtrl.style.display = q.qType === 'vf' ? '' : 'none';
  testCtrl.style.display = q.qType === 'test' ? '' : 'none';
  quizzCtrl.style.display = q.qType === 'quizz' ? '' : 'none';

  if (q.qType === 'vf') {
    const bv = document.getElementById('btn-v'), bf = document.getElementById('btn-f');
    bv.className = 'vf-btn v-btn'; bv.disabled = false;
    bf.className = 'vf-btn f-btn'; bf.disabled = false;
    document.getElementById('just-box').className = 'justification';

    if (answers[idx] !== undefined) {
      answered = true;
      const { chosen, wasCorrect } = answers[idx];
      bv.disabled = true; bf.disabled = true;
      
      if (isDeferred) {
        (chosen === 'V' ? bv : bf).className += ' chosen-deferred';
      } else {
        const cb = chosen === 'V' ? bv : bf, rb = q.answer === 'V' ? bv : bf;
        cb.className += (wasCorrect ? ' chosen-correct' : ' chosen-wrong');
        if (!wasCorrect) rb.className += ' show-correct';
        const jbox = document.getElementById('just-box');
        jbox.className = 'justification show ' + (wasCorrect ? 'correct-just' : 'wrong-just');
        document.getElementById('just-label').textContent = wasCorrect ? `✓ Correcto — ${q.answer==='V'?'VERDADERO':'FALSO'}` : `✗ Incorrecto — Era ${q.answer==='V'?'VERDADERO':'FALSO'}`;
        document.getElementById('just-text').textContent = q.justification;
      }
      show_el('btn-next');
    } else {
      startTimer();
    }
  } else if (q.qType === 'test') {
    const container = document.getElementById('options-container');
    container.innerHTML = '';
    q.opts.forEach((opt, i) => {
      const btn = document.createElement('button'); btn.className = 'opt-btn';
      btn.innerHTML = `<span class="opt-letter">${LETTERS[i]}</span><span>${opt}</span>`;
      btn.addEventListener('click', () => answerTest(i));
      container.appendChild(btn);
    });
    document.getElementById('feedback').className = 'feedback';
    document.getElementById('test-just').className = 'justification';

    if (answers[idx] !== undefined) {
      answered = true;
      const { chosen, wasCorrect } = answers[idx];
      const btns = document.querySelectorAll('.opt-btn');
      btns.forEach(b => b.disabled = true);

      if (isDeferred) {
        btns[chosen].className += ' chosen-deferred';
      } else {
        btns[chosen].className += (wasCorrect ? ' chosen-correct' : ' chosen-wrong');
        if (!wasCorrect) btns[q.correct].className += ' show-correct';
        const fb = document.getElementById('feedback');
        fb.className = 'feedback show ' + (wasCorrect ? 'correct' : 'wrong');
        fb.textContent = wasCorrect ? `✓ Correcto — ${q.opts[q.correct]}` : `✗ Incorrecto — Era: ${q.opts[q.correct]}`;
        showTestJust(q, wasCorrect);
      }
      show_el('btn-next');
    } else {
      startTimer();
    }
  } else {
    // Quizz reveal
    const revealBtn = document.getElementById('btn-reveal');
    const answerBox = document.getElementById('quiz-answer-box');
    document.getElementById('quiz-answer-text').textContent = q.answer;
    if (answers[idx] !== undefined) {
      answered = true;
      revealBtn.style.display = 'none';
      answerBox.className = 'quiz-answer-box show';
      show_el('btn-next');
    } else {
      revealBtn.style.display = '';
      revealBtn.disabled = false;
      answerBox.className = 'quiz-answer-box';
      startTimer();
    }
  }
}

function answerVF(chosen){
  if (answered) return;
  answered = true;
  clearInterval(timerInterval);
  const q = questions[idx];
  const ok = chosen === q.answer;
  const isDeferred = document.getElementById('chk-deferred')?.checked;

  if (ok) {
    correct++;
    removeWeakQuestion(q.q);
  } else {
    wrong++;
    saveWeakQuestion(q.q);
  }

  answers[idx] = { chosen, wasCorrect: ok };
  const bv = document.getElementById('btn-v'), bf = document.getElementById('btn-f');
  bv.disabled = true; bf.disabled = true;

  if (isDeferred) {
    (chosen === 'V' ? bv : bf).className += ' chosen-deferred';
  } else {
    const cb = chosen === 'V' ? bv : bf, rb = q.answer === 'V' ? bv : bf;
    cb.className += (ok ? ' chosen-correct' : ' chosen-wrong');
    if (!ok) rb.className += ' show-correct';
    const jbox = document.getElementById('just-box');
    jbox.className = 'justification show ' + (ok ? 'correct-just' : 'wrong-just');
    document.getElementById('just-label').textContent = ok ? `✓ Correcto — ${q.answer==='V'?'VERDADERO':'FALSO'}` : `✗ Incorrecto — Era ${q.answer==='V'?'VERDADERO':'FALSO'}`;
    document.getElementById('just-text').textContent = q.justification;
  }

  updateLiveScore();
  show_el('btn-next');

  if (selectedMode === 'streak' && !ok) {
    setTimeout(showResults, 1200);
  }
}

function answerTest(chosen){
  if (answered) return;
  answered = true;
  clearInterval(timerInterval);
  const q = questions[idx];
  const ok = chosen === q.correct;
  const isDeferred = document.getElementById('chk-deferred')?.checked;

  if (ok) {
    correct++;
    removeWeakQuestion(q.q);
  } else {
    wrong++;
    saveWeakQuestion(q.q);
  }

  answers[idx] = { chosen, wasCorrect: ok };
  const btns = document.querySelectorAll('.opt-btn');
  btns.forEach(b => b.disabled = true);

  if (isDeferred) {
    btns[chosen].className += ' chosen-deferred';
  } else {
    btns[chosen].className += (ok ? ' chosen-correct' : ' chosen-wrong');
    if (!ok) btns[q.correct].className += ' show-correct';
    const fb = document.getElementById('feedback');
    fb.className = 'feedback show ' + (ok ? 'correct' : 'wrong');
    fb.textContent = ok ? `✓ Correcto — ${q.opts[q.correct]}` : `✗ Incorrecto — Era: ${q.opts[q.correct]}`;
    showTestJust(q, ok);
  }

  updateLiveScore();
  show_el('btn-next');

  if (selectedMode === 'streak' && !ok) {
    setTimeout(showResults, 1200);
  }
}

function showTestJust(q, wasCorrect){
  const tj = document.getElementById('test-just');
  if (q && q.justification) {
    tj.className = 'justification show ' + (wasCorrect ? 'correct-just' : 'wrong-just');
    document.getElementById('test-just-text').textContent = q.justification;
  } else { tj.className = 'justification'; }
}

function answerReveal(){
  if (answered) return;
  answered = true;
  clearInterval(timerInterval);
  document.getElementById('btn-reveal').style.display = 'none';
  document.getElementById('quiz-answer-box').className = 'quiz-answer-box show';
  answers[idx] = { revealed: true };
  show_el('btn-next');
}

function prevQ(){ if(idx > 0){ idx--; showQ(); } }
function nextQ(){ idx++; if(idx >= questions.length){ showResults(); return; } showQ(); }

let currentResultNote = '10.0';

function showResults(){
  clearInterval(timerInterval);
  hide('quiz-view');
  updateWeakChipCount();

  const rv = document.getElementById('results-view');
  rv.style.display = 'flex'; rv.style.flexDirection = 'column'; rv.style.gap = '20px';

  const isPenaltyOn = document.getElementById('chk-penalty')?.checked;
  const ugrContainer = document.getElementById('ugr-note-container');

  let calculatedNote = 0;

  if (selectedMode === 'quizz') {
    document.getElementById('r-pct').textContent = questions.length + ' ✓';
    document.getElementById('r-ok').textContent = questions.length;
    document.getElementById('r-fail').textContent = 0;
    document.getElementById('btn-repeat-wrong').style.display = 'none';
    if (ugrContainer) ugrContainer.style.display = 'none';
    calculatedNote = 10;
  } else if (selectedMode === 'streak') {
    document.getElementById('r-pct').textContent = `🔥 ${correct}`;
    document.getElementById('r-pct-lbl').textContent = 'Racha Aciertos';
    document.getElementById('r-ok').textContent = correct;
    document.getElementById('r-fail').textContent = wrong;
    document.getElementById('btn-repeat-wrong').style.display = 'none';
    if (ugrContainer) ugrContainer.style.display = 'none';
    calculatedNote = Math.min(10, Math.round((correct / 10) * 10) / 10);
  } else {
    document.getElementById('r-pct-lbl').textContent = 'Nota Final';
    document.getElementById('r-ok').textContent = correct;
    document.getElementById('r-fail').textContent = wrong;
    document.getElementById('btn-repeat-wrong').style.display = wrong > 0 ? '' : 'none';

    if (isPenaltyOn) {
      // Penalización UGR: -0.33 por fallo
      const penaltyFactor = 0.33;
      const rawScore = Math.max(0, correct - (wrong * penaltyFactor));
      calculatedNote = Math.max(0, Math.round((rawScore / questions.length) * 100) / 10);
      document.getElementById('r-pct').textContent = `${calculatedNote} / 10`;
      if (ugrContainer) ugrContainer.style.display = 'block';
    } else {
      calculatedNote = Math.round((correct / questions.length) * 100) / 10;
      document.getElementById('r-pct').textContent = `${calculatedNote} / 10`;
      if (ugrContainer) ugrContainer.style.display = 'none';
    }
  }

  currentResultNote = calculatedNote.toFixed(1);
  saveUserAttempt(calculatedNote, correct);

  document.getElementById('r-total').textContent = questions.length;
  renderCatBreakdown();
}

function printExamSheet() {
  const src = getSourceForMode();
  const pool = selectedTemas.size === 0 ? src : src.filter(q => selectedTemas.has(q.tema));
  if (!pool.length) {
    alert('No hay preguntas seleccionadas para imprimir.');
    return;
  }
  const pContainer = document.getElementById('print-container');
  if (!pContainer) return;

  const subjTitle = document.title.split('·')[0].trim();
  let html = `<div class="print-header" style="margin-bottom:20px;border-bottom:2px solid #000;padding-bottom:10px">`;
  html += `<h2 style="margin:0">${code} — ${subjTitle}</h2>`;
  html += `<p style="margin:4px 0 0 0;font-size:14px">Simulacro impreso | repasaYA.com · Fecha: ${new Date().toLocaleDateString('es-ES')}</p></div>`;

  let solutions = [];
  pool.forEach((q, i) => {
    html += `<div class="print-q"><div class="print-q-title">${i + 1}. [${q.tema}] ${q.q}</div>`;
    if (q.qType === 'vf') {
      html += `<div class="print-opt">[ &nbsp; ] VERDADERO &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; [ &nbsp; ] FALSO</div>`;
      solutions.push(`${i + 1}: ${q.answer === 'V' ? 'VERDADERO' : 'FALSO'}`);
    } else if (q.qType === 'test') {
      q.opts.forEach((opt, idx) => {
        html += `<div class="print-opt">[ &nbsp; ] ${LETTERS[idx]}) ${opt}</div>`;
      });
      solutions.push(`${i + 1}: Opción ${LETTERS[q.correct]}`);
    } else {
      solutions.push(`${i + 1}: Ver temario`);
    }
    html += `</div>`;
  });

  html += `<div class="print-key"><h3>HOJA DE SOLUCIONES CORRECCIÓN</h3><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;font-size:13px">`;
  solutions.forEach(s => html += `<div>${s}</div>`);
  html += `</div></div>`;

  pContainer.innerHTML = html;
  window.print();
}
window.printExamSheet = printExamSheet;

function shareResultWhatsApp() {
  const subjTitle = document.title.split('·')[0].trim();
  const text = `🎓 ¡He sacado un ${currentResultNote}/10 en el Simulacro UGR de ${subjTitle} en repasaYA! (🔥 Racha: ${correct} aciertos). ¡Demuestra lo que sabes en: ${window.location.href}`;
  window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
}

function copyResultText() {
  const subjTitle = document.title.split('·')[0].trim();
  const text = `🎓 ¡He sacado un ${currentResultNote}/10 en el Simulacro UGR de ${subjTitle} en repasaYA! (🔥 Racha: ${correct} aciertos). ¡Demuestra lo que sabes en: ${window.location.href}`;
  navigator.clipboard.writeText(text).then(() => {
    showToast('¡Resultado copiado al portapapeles! 📋');
  }).catch(() => {
    showToast('Error al copiar');
  });
}

function renderCatBreakdown(){
  const box = document.getElementById('cat-breakdown');
  const list = document.getElementById('cat-list');
  if (!box || !list) return;

  const stats = {}; const order = [];
  questions.forEach((q, i) => {
    const a = answers[i];
    if (!a || a.wasCorrect === undefined) return;
    const t = q.tema || 'Sin categoría';
    if (!stats[t]) { stats[t] = { ok: 0, total: 0 }; order.push(t); }
    stats[t].total++; if (a.wasCorrect) stats[t].ok++;
  });

  if (order.length === 0) { box.style.display = 'none'; return; }
  list.innerHTML = '';
  order.forEach(t => {
    const { ok, total } = stats[t];
    const pct = Math.round((ok / total) * 100);
    const cls = pct >= 70 ? 'hi' : pct >= 40 ? 'mid' : 'lo';
    const row = document.createElement('div'); row.className = 'cat-row';
    row.innerHTML =
      '<div class="cat-head"><span class="cat-name"></span>' +
      '<span class="cat-meta">' + pct + '%<span class="frac">' + ok + '/' + total + '</span></span></div>' +
      '<div class="cat-bar"><div class="cat-fill ' + cls + '" style="width:' + pct + '%"></div></div>';
    row.querySelector('.cat-name').textContent = t;
    list.appendChild(row);
  });
  box.style.display = '';
}

function repeatWrong(){
  const wrongQs = questions.filter((_, i) => answers[i] !== undefined && answers[i].wasCorrect === false);
  if (!wrongQs.length) return;
  questions = wrongQs;
  idx = 0; correct = 0; wrong = 0; answers = [];
  hide('results-view'); show('quiz-view');
  showQ();
}

function backToSelector(){
  clearInterval(timerInterval);
  hide('quiz-view'); hide('results-view'); show('selector-view');
  updateWeakChipCount();
  updateStarredChipCount();
  renderUserStats();
}

function hide(id){ document.getElementById(id).style.display = 'none'; }
function show(id){ document.getElementById(id).style.display = ''; }
function hide_el(id){ document.getElementById(id).style.display = 'none'; }
function show_el(id){ document.getElementById(id).style.display = ''; }

// Event listeners
document.getElementById('btn-start').addEventListener('click', startQuiz);
document.getElementById('btn-v').addEventListener('click', () => answerVF('V'));
document.getElementById('btn-f').addEventListener('click', () => answerVF('F'));
document.getElementById('btn-reveal').addEventListener('click', answerReveal);
document.getElementById('btn-next').addEventListener('click', nextQ);
document.getElementById('btn-prev').addEventListener('click', prevQ);
document.getElementById('btn-back').addEventListener('click', backToSelector);
document.getElementById('btn-back2').addEventListener('click', backToSelector);
document.getElementById('btn-repeat').addEventListener('click', startQuiz);
document.getElementById('btn-repeat-wrong').addEventListener('click', repeatWrong);

document.getElementById('btn-star-q')?.addEventListener('click', toggleStarCurrentQ);
document.getElementById('btn-reset-stats')?.addEventListener('click', resetUserStats);
document.getElementById('btn-print')?.addEventListener('click', printExamSheet);
document.getElementById('btn-share-wa')?.addEventListener('click', shareResultWhatsApp);
document.getElementById('btn-copy-result')?.addEventListener('click', copyResultText);

// Keyboard Navigation
window.addEventListener('keydown', (e) => {
  const quizView = document.getElementById('quiz-view');
  if (!quizView || quizView.style.display === 'none') return;
  if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName || '')) return;

  const key = e.key.toUpperCase();
  const q = questions[idx];

  if (!answered && q) {
    if (q.qType === 'vf') {
      if (key === 'V' || key === '1') answerVF('V');
      else if (key === 'F' || key === '2') answerVF('F');
    } else if (q.qType === 'test') {
      if (key === '1' || key === 'A') answerTest(0);
      else if (key === '2' || key === 'B') answerTest(1);
      else if (key === '3' || key === 'C') answerTest(2);
      else if (key === '4' || key === 'D') answerTest(3);
    } else if (q.qType === 'quizz' && (key === 'ENTER' || key === ' ')) {
      answerReveal();
    }
  } else if (answered) {
    if (key === 'ENTER' || key === ' ' || key === 'ARROWRIGHT') nextQ();
    else if (key === 'ARROWLEFT' && idx > 0) prevQ();
  }
});

// Mode Cards
['vf','test','mix','streak','weak','starred','quizz'].forEach(m => {
  const card = document.getElementById('card-' + m);
  if (card) card.addEventListener('click', () => selectMode(m));
});

// Tabs
document.querySelectorAll('.tab').forEach(t => {
  t.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    document.getElementById('panel-' + t.dataset.tab).classList.add('active');
    if(t.dataset.tab === 'banco') initBank();
  });
});

// Banco
const ALL_BANK = [...VF_DATA, ...TEST_DATA];
let bankReady = false;

function initBank(){
  if (bankReady) return;
  bankReady = true;
  const sel = document.getElementById('b-tema');
  [...new Set(ALL_BANK.map(q => q.tema))].forEach(t => {
    const o = document.createElement('option'); o.value = t; o.textContent = t; sel.appendChild(o);
  });
  document.getElementById('b-search').addEventListener('input', filterBank);
  const bTipo = document.getElementById('b-tipo');
  const bTema = document.getElementById('b-tema');
  if (bTipo) bTipo.addEventListener('change', filterBank);
  if (bTema) bTema.addEventListener('change', filterBank);
  filterBank();
}

function filterBank(){
  const s = document.getElementById('b-search').value.toLowerCase();
  const bTipo = document.getElementById('b-tipo');
  const tipo = bTipo ? bTipo.value : '';
  const tema = document.getElementById('b-tema').value;
  const list = ALL_BANK.filter(q =>
    (!tipo || q.qType === tipo) &&
    (!tema || q.tema === tema) &&
    (!s || q.q.toLowerCase().includes(s))
  );
  document.getElementById('b-count').textContent = `${list.length} preguntas`;
  const el = document.getElementById('b-list'); el.innerHTML = '';
  list.forEach(q => {
    const div = document.createElement('div'); div.className = 'bank-item';
    const badge = q.qType === 'vf'
      ? `<div class="bank-badge ${q.answer==='V'?'b-v':'b-f'}">${q.answer}</div>`
      : '<div class="bank-badge b-t">Test</div>';
    const ans = q.qType === 'vf' ? q.justification : (q.opts ? q.opts[q.correct] : '');
    div.innerHTML = `${badge}<div><div class="bank-meta">${q.tema}</div><div class="bank-q">${q.q}</div><div class="bank-ans">${ans}</div></div>`;
    el.appendChild(div);
  });
}
</script>
