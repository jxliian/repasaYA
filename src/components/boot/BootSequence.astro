---
/**
 * BootSequence — pantalla de carga inicial de repasaYA.
 *
 * Muestra el logo oficial en CSS con el punto intermitente (idéntico al navbar)
 * mientras se llena la barra de progreso. Al terminar se desvanece y deja la landing.
 *
 * Reglas:
 *  - Solo una vez por sesión (sessionStorage).
 *  - prefers-reduced-motion → no aparece.
 *  - Sin JS → no aparece (el overlay nace con [hidden]).
 *  - Se puede saltar con click o cualquier tecla.
 *  - Tope duro de 2.4s.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div
  class="boot"
  id="boot"
  role="status"
  aria-live="polite"
  hidden
>
  <div class="boot-stage">
    <div class="boot-brand">
      repasaYA<span class="dot" aria-hidden="true"></span>
    </div>
  </div>

  <div class="boot-meter">
    <div class="boot-track">
      <div class="boot-fill" id="boot-fill"></div>
    </div>
    <div class="boot-readout">
      <span class="boot-status" id="boot-status">encendiendo motores</span>
      <span class="boot-pct" id="boot-pct">0%</span>
    </div>
  </div>

  <p class="boot-skip" aria-hidden="true">pulsa cualquier tecla para saltar</p>
</div>

<style is:global>
  :root[data-boot='on'] body {
    overflow: hidden;
  }

  .boot {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 34px;
    background: radial-gradient(
        ellipse 80% 60% at 50% 40%,
        var(--space-800) 0%,
        var(--space-950) 70%
      ),
      var(--space-950);
    transition: opacity 0.55s var(--ease-out), transform 0.55s var(--ease-out),
      filter 0.55s var(--ease-out);
  }
  .boot[hidden] {
    display: none;
  }
  .boot.is-leaving {
    opacity: 0;
    transform: scale(1.06);
    filter: blur(14px);
    pointer-events: none;
  }

  /* Halo de nebulosa detrás del logo */
  .boot::before {
    content: '';
    position: absolute;
    width: min(560px, 80vw);
    aspect-ratio: 1;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    translate: -50% -60%;
    background: radial-gradient(
      circle,
      rgba(124, 92, 255, 0.22) 0%,
      rgba(124, 92, 255, 0.06) 45%,
      transparent 70%
    );
    filter: blur(40px);
    animation: bootPulse 3.2s var(--ease-out) infinite;
    pointer-events: none;
  }
  @keyframes bootPulse {
    0%,
    100% {
      opacity: 0.6;
      scale: 0.96;
    }
    50% {
      opacity: 1;
      scale: 1.04;
    }
  }

  .boot-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .boot-brand {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 8vw, 56px);
    letter-spacing: -0.055em;
    color: var(--text);
    text-shadow: 0 8px 40px rgba(124, 92, 255, 0.55);
    user-select: none;
  }
  .boot-brand .dot {
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent);
    margin-bottom: 0.18em;
    animation: dotPulse 2.4s var(--ease-out) infinite;
  }
  @keyframes dotPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .boot-meter {
    width: min(320px, 72vw);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .boot-track {
    height: 3px;
    border-radius: var(--radius-pill);
    background: rgba(167, 139, 234, 0.14);
    overflow: hidden;
  }
  .boot-fill {
    height: 100%;
    width: 0%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--accent-deep),
      var(--accent),
      var(--neon-cyan)
    );
    box-shadow: 0 0 14px rgba(124, 92, 255, 0.85);
  }
  .boot-readout {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .boot-status {
    color: var(--text-dim);
  }
  .boot-pct {
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .boot-skip {
    position: absolute;
    bottom: 32px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    opacity: 0;
    animation: bootSkipIn 0.4s var(--ease-out) 1.4s forwards;
  }
  @keyframes bootSkipIn {
    to {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('ry_boot') === 'done') return;
      document.documentElement.dataset.boot = 'on';
      var el = document.getElementById('boot');
      if (el) el.hidden = false;
    } catch (e) {
      /* sin sessionStorage → simplemente no arranca */
    }
  })();
</script>

<script>
  const MIN_MS = 800;
  const MAX_MS = 2000;

  const STATUS = [
    'encendiendo motores',
    'barajando preguntas',
    'calentando flashcards',
    'listo para suspender a nadie',
  ];

  function boot() {
    const wrap = document.getElementById('boot');
    if (!wrap || wrap.hidden) return;

    const fill = document.getElementById('boot-fill') as HTMLElement | null;
    const pctEl = document.getElementById('boot-pct') as HTMLElement | null;
    const statusEl = document.getElementById('boot-status') as HTMLElement | null;

    const started = performance.now();
    let finished = false;
    let raf = 0;

    const WEIGHTS = { fonts: 0.3, load: 0.7 };
    let target = 0;
    let shown = 0;
    const done: Record<string, boolean> = {};
    function reach(step: keyof typeof WEIGHTS) {
      if (done[step]) return;
      done[step] = true;
      target = Math.min(1, target + WEIGHTS[step]);
    }

    document.fonts?.ready.then(() => reach('fonts')).catch(() => reach('fonts'));
    if (document.readyState === 'complete') reach('load');
    else window.addEventListener('load', () => reach('load'), { once: true });

    function finish() {
      if (finished) return;
      finished = true;
      try {
        sessionStorage.setItem('ry_boot', 'done');
      } catch (e) {}
      cancelAnimationFrame(raf);
      window.removeEventListener('keydown', onSkip);
      wrap!.removeEventListener('click', onSkip);
      wrap!.classList.add('is-leaving');
      delete document.documentElement.dataset.boot;
      window.dispatchEvent(new CustomEvent('repasaya:boot-done'));
      setTimeout(() => wrap!.remove(), 600);
    }
    function onSkip() {
      target = 1;
      shown = 1;
      finish();
    }
    window.addEventListener('keydown', onSkip);
    wrap.addEventListener('click', onSkip);
    setTimeout(finish, MAX_MS);

    let statusIdx = -1;
    function tick() {
      const elapsed = performance.now() - started;
      const floor = Math.min(0.92, elapsed / MIN_MS);
      const t = Math.max(target, floor);
      shown += (t - shown) * 0.1;

      const pct = Math.min(100, Math.round(shown * 100));
      if (fill) fill.style.width = pct + '%';
      if (pctEl) pctEl.textContent = pct + '%';

      const nextStatus = Math.min(STATUS.length - 1, Math.floor(shown * STATUS.length));
      if (nextStatus !== statusIdx && statusEl) {
        statusIdx = nextStatus;
        statusEl.textContent = STATUS[nextStatus];
      }

      if (shown > 0.995 && elapsed > MIN_MS) return finish();
      raf = requestAnimationFrame(tick);
    }

    raf = requestAnimationFrame(tick);
  }

  boot();
</script>
