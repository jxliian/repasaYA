---
import GlobalSearch from '../search/GlobalSearch.astro';
import HeroLogo3D from './HeroLogo3D.astro';

/**
 * Hero — primera pantalla de la landing.
 *
 * De arriba abajo: logo 3D pequeño, propuesta de valor, buscador global y
 * las dos puertas de entrada a los grados. El logo aparece dos veces en la
 * visita —grande en la pantalla de carga, pequeño aquí— pero comparten
 * geometría y Three.js ya está en caché, así que el segundo sale gratis.
 *
 * La entrada se anima al terminar la secuencia de carga (evento
 * `repasaya:boot-done`) o de inmediato si esa secuencia no llega a correr.
 */
interface Degree {
  slug: string;
  name: string;
  short: string;
  icon: string;
  /** Asignaturas con material ya publicado */
  ready: number;
  /** Asignaturas del plan de estudios completo */
  total: number;
  blurb: string;
}
interface Stat {
  value: string;
  label: string;
}
interface Props {
  degrees: Degree[];
  stats: Stat[];
}

const { degrees, stats } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hero" data-hero aria-label="Bienvenida">
  <!-- Fondo: nebulosa + estrellas + rejilla. Decorativo, sin clics. -->
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-fade"></div>
    <div class="stars stars-far"></div>
    <div class="stars stars-near"></div>
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="orb orb-c"></div>
  </div>

  <div class="hero-inner container">
    <div class="logo-slot" data-rise="1">
      <HeroLogo3D />
    </div>

    <p class="lede" data-rise="2">
      Tests, verdadero/falso y flashcards de tus asignaturas. Los hago mientras me
      examino de lo mismo que tú, así que si algo está mal, se arregla esa semana.
    </p>

    <div class="search-slot" data-rise="3">
      <GlobalSearch variant="hero" id="hero-search" />
      <p class="search-hint">
        o dale a <kbd>⌘</kbd><kbd>K</kbd> desde cualquier parte
      </p>
    </div>

    <div class="degrees" data-rise="4">
      {
        degrees.map((d) => (
          <a class="degree glass glow-hover" href={`${base}${d.slug}/`}>
            <span class="degree-icon" aria-hidden="true">
              {d.icon}
            </span>
            <span class="degree-body">
              <span class="degree-name">{d.short}</span>
              <span class="degree-blurb">{d.blurb}</span>
            </span>
            <span class="degree-count">
              <b>{d.ready}</b>
              <small>de {d.total}</small>
            </span>
            <svg
              class="degree-arrow"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        ))
      }
    </div>

    <dl class="stats" data-rise="7">
      {
        stats.map((s) => (
          <div class="stat">
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <a class="scroll-cue" href="#asignaturas" data-rise="8">
    <span>baja y elige tu veneno</span>
    <span class="chev" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    /* Descontamos la cabecera sticky: si no, el hero desborda la
       primera pantalla justo por esos 64px y la flecha queda cortada. */
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(80px, 12vh, 130px) 0 100px;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Fondo espacial ────────────────────────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 65%, transparent 98%);
    -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 98%);
  }

  /* Rejilla técnica, casi imperceptible, se disuelve hacia abajo */
  .grid-fade {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        rgba(var(--particle), 0.055) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(var(--particle), 0.055) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 90% 60% at 50% 35%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      ellipse 90% 60% at 50% 35%,
      #000 20%,
      transparent 75%
    );
  }

  /* Dos capas de estrellas a distinta velocidad → profundidad */
  .stars {
    position: absolute;
    inset: -20%;
    background-repeat: repeat;
    opacity: 0.5;
  }
  .stars-far {
    background-image: radial-gradient(
        1px 1px at 12% 22%,
        rgba(var(--star), 0.7),
        transparent
      ),
      radial-gradient(1px 1px at 68% 14%, rgba(var(--star), 0.55), transparent),
      radial-gradient(1px 1px at 34% 71%, rgba(var(--star), 0.6), transparent),
      radial-gradient(1px 1px at 87% 58%, rgba(var(--star), 0.5), transparent),
      radial-gradient(1px 1px at 52% 42%, rgba(var(--star), 0.45), transparent);
    background-size: 340px 340px;
    animation: drift 150s linear infinite;
  }
  .stars-near {
    background-image: radial-gradient(
        1.6px 1.6px at 22% 34%,
        rgba(var(--star), 0.85),
        transparent
      ),
      radial-gradient(1.6px 1.6px at 78% 66%, rgba(var(--star), 0.7), transparent),
      radial-gradient(1.4px 1.4px at 44% 12%, rgba(var(--star), 0.75), transparent);
    background-size: 560px 560px;
    animation: drift 90s linear infinite reverse;
    opacity: 0.65;
  }
  @keyframes drift {
    to {
      transform: translate3d(-340px, -180px, 0);
    }
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }
  .orb-a {
    width: 620px;
    height: 620px;
    top: -18%;
    left: -10%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.28), transparent 68%);
    animation: float 26s var(--ease-out) infinite;
  }
  .orb-b {
    width: 500px;
    height: 500px;
    bottom: -10%;
    right: -5%;
    background: radial-gradient(circle, rgba(79, 220, 210, 0.14), transparent 70%);
    animation: float 34s var(--ease-out) infinite reverse;
  }
  .orb-c {
    width: 460px;
    height: 460px;
    top: 42%;
    left: 46%;
    background: radial-gradient(circle, rgba(255, 111, 216, 0.11), transparent 68%);
    animation: float 40s var(--ease-out) infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(38px, -46px) scale(1.09);
    }
  }
  :root[data-theme='light'] .orb {
    opacity: 0.55;
  }

  /* ── Contenido ─────────────────────────────────────────────── */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }

  .logo-slot {
    display: flex;
    justify-content: center;
    margin-bottom: -6px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--correct);
    box-shadow: 0 0 10px var(--correct-glow);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 7.4vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .grad {
    background: linear-gradient(
      100deg,
      var(--accent-bright) 0%,
      var(--accent) 40%,
      var(--neon-cyan) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* Halo detrás del texto en degradado */
    filter: drop-shadow(0 6px 34px rgba(124, 92, 255, 0.45));
  }

  .lede {
    max-width: 56ch;
    font-size: clamp(0.98rem, 1.5vw, 1.12rem);
    line-height: 1.62;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .search-slot {
    width: 100%;
    max-width: 620px;
    margin-top: 6px;
  }
  .search-hint {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-dim);
  }
  .search-hint kbd {
    font-family: inherit;
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
    border-radius: 4px;
    padding: 1px 5px;
    margin-inline: 1px;
  }

  /* ── Puertas de entrada a los grados ───────────────────────── */
  .degrees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 700px;
    margin-top: 10px;
  }
  .degree {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    text-align: left;
  }
  .degree-icon {
    font-size: 1.4rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
  }
  .degree-body {
    flex: 1;
    min-width: 0;
  }
  .degree-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .degree-blurb {
    display: block;
    margin-top: 2px;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .degree-count {
    text-align: right;
    flex-shrink: 0;
    font-family: var(--font-mono);
    line-height: 1.1;
  }
  .degree-count b {
    display: block;
    font-size: 1.05rem;
    color: var(--accent);
  }
  .degree-count small {
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }
  .degree-arrow {
    color: var(--text-dim);
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease-snap), color var(--dur) var(--ease-out);
  }
  .degree:hover .degree-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  /* ── Cifras ────────────────────────────────────────────────── */
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(20px, 5vw, 48px);
    margin-top: 18px;
  }
  .stat dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat dd {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* ── Flecha de bajada ──────────────────────────────────────── */
  .scroll-cue {
    position: absolute;
    bottom: 26px;
    left: 50%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    transition: color var(--dur) var(--ease-out);
  }
  .scroll-cue:hover {
    color: var(--accent);
  }
  .chev {
    width: 9px;
    height: 9px;
    border-right: 1.6px solid currentColor;
    border-bottom: 1.6px solid currentColor;
    rotate: 45deg;
    animation: bob 1.9s var(--ease-out) infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.6;
    }
    50% {
      transform: translateY(5px);
      opacity: 1;
    }
  }

  /* ── Entrada escalonada ────────────────────────────────────── */
  [data-rise] {
    opacity: 0;
    transform: translateY(22px);
  }
  .hero.is-in [data-rise] {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-snap);
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  .hero.is-in [data-rise='1'] {
    --i: 0;
  }
  .hero.is-in [data-rise='2'] {
    --i: 1;
  }
  .hero.is-in [data-rise='3'] {
    --i: 2;
  }
  .hero.is-in [data-rise='4'] {
    --i: 3;
  }
  .hero.is-in [data-rise='5'] {
    --i: 4;
  }
  .hero.is-in [data-rise='6'] {
    --i: 5;
  }
  .hero.is-in [data-rise='7'] {
    --i: 6;
  }
  .hero.is-in [data-rise='8'] {
    --i: 7;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-rise] {
      opacity: 1;
      transform: none;
    }
    .stars,
    .orb,
    .chev {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hero-inner {
      gap: 20px;
    }
    .scroll-cue {
      display: none;
    }
  }
</style>

<script>
  function enterHero() {
    const hero = document.querySelector('[data-hero]');
    if (!hero) return;

    const start = () => hero.classList.add('is-in');

    // Si la secuencia de carga está en marcha, esperamos a que acabe:
    // así el hero no se anima detrás de un overlay opaco.
    if (document.documentElement.dataset.boot === 'on') {
      window.addEventListener('repasaya:boot-done', start, { once: true });
      // Por si el overlay muriera sin avisar
      setTimeout(start, 3200);
    } else {
      requestAnimationFrame(start);
    }
  }

  enterHero();
  document.addEventListener('astro:page-load', enterHero);
</script>
