---
/**
 * Logo del hero — versión plana idéntica a la del navbar,
 * pero escalada para presidir la portada de repasaYA.
 */
---

<div class="hero-brand">
  repasaYA<span class="dot" aria-hidden="true"></span>
</div>

<style>
  .hero-brand {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 5.8vw, 52px);
    letter-spacing: -0.055em;
    color: var(--text);
    filter: drop-shadow(0 12px 34px rgba(124, 92, 255, 0.45));
    user-select: none;
  }
  .hero-brand .dot {
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
    margin-bottom: 0.18em;
    animation: dotPulse 2.4s var(--ease-out) infinite;
  }
  @keyframes dotPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
