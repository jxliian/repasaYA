---
/**
 * Logo principal del hero — versión plana idéntica a la del navbar,
 * pero escalada en grande para presidir la portada de repasaYA.
 */
---

<h1 class="hero-brand">
  repasaYA<span class="dot" aria-hidden="true"></span>
</h1>

<style>
  .hero-brand {
    display: inline-flex;
    align-items: flex-end;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 10vw, 130px);
    letter-spacing: -0.055em;
    color: var(--text);
    filter: drop-shadow(0 14px 40px rgba(124, 92, 255, 0.5));
    user-select: none;
    line-height: 1;
    margin: 0;
  }
  .hero-brand .dot {
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 22px var(--accent);
    margin-bottom: 0.16em;
    animation: dotPulse 2.4s var(--ease-out) infinite;
  }
  @keyframes dotPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
