---
/**
 * PixelMe — Julián en vóxeles, estudiando en su escritorio.
 *
 * Escena 3D hecha de cubitos (estilo MagicaVoxel) y pintada a baja
 * resolución con `image-rendering: pixelated`, para que se vea como pixel
 * art con volumen. Todo el modelo se construye aquí en código: no hay
 * archivos de modelo que cargar.
 *
 * Animación: cabeza al ritmo, manos tecleando, vapor de la taza y un
 * leve vaivén de cámara. Solo se anima mientras está en pantalla; con
 * `prefers-reduced-motion` se pinta un único fotograma. Sin WebGL, el
 * hueco simplemente queda vacío.
 */
---

<div class="pixel-me" aria-hidden="true">
  <canvas data-pixel-me></canvas>
</div>

<style>
  .pixel-me {
    width: 100%;
    aspect-ratio: 1 / 0.86;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>

<script>
  import {
    AmbientLight,
    BoxGeometry,
    Color,
    DirectionalLight,
    Group,
    InstancedMesh,
    Matrix4,
    MeshLambertMaterial,
    OrthographicCamera,
    PointLight,
    Scene,
    WebGLRenderer,
  } from 'three';

  type Vox = Map<string, string>;
  const key = (x: number, y: number, z: number) => `${x},${y},${z}`;

  /* Pseudoaleatorio con semilla: el pelo sale igual en cada visita */
  function rng(seed: number) {
    return () => {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    };
  }

  const C = {
    skin: '#f2c4a0',
    skin2: '#e3ad88',
    blush: '#eba08a',
    lip: '#b4604c',
    eye: '#231a16',
    white: '#ffffff',
    brow: '#2a1d17',
    hair: '#241914',
    hair2: '#3b2a20',
    hair3: '#4f392b',
    tee: '#f5f3f0',
    tee2: '#e4dfda',
    print: '#1f6f6a',
    desk: '#9a6542',
    desk2: '#7c4e32',
    leg: '#5a3a26',
    lid: '#cdd1d6',
    lid2: '#aab1b9',
    key: '#3a3d42',
    dot: '#d9a13a',
    mug: '#f6f4f1',
    mugr: '#7a1f2b',
    coffee: '#4a2c1f',
    bk1: '#e9dcc6',
    bk2: '#2e6a87',
    bk3: '#d9a13a',
    page: '#fbf7ef',
    pot: '#b4673f',
    leaf: '#5f9a6a',
    leaf2: '#3f7a50',
    steam: '#ffffff',
  };

  function box(v: Vox, x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, c: string) {
    for (let x = x0; x <= x1; x++) for (let y = y0; y <= y1; y++) for (let z = z0; z <= z1; z++) v.set(key(x, y, z), c);
  }

  /* ── Modelo ──────────────────────────────────────────────────── */
  function buildStatic(): Vox {
    const v: Vox = new Map();
    // Mesa
    box(v, -22, 8, -8, 21, 9, 10, C.desk);
    box(v, -22, 8, 10, 21, 8, 10, C.desk2);
    for (const [x, z] of [[-21, -7], [20, -7], [-21, 9], [20, 9]]) box(v, x, 0, z, x, 7, z, C.leg);
    // Torso con camiseta
    box(v, -6, 10, -6, 5, 19, -1, C.tee);
    box(v, -6, 10, -1, 5, 10, -1, C.tee2);
    for (const [x, y] of [[2, 17], [3, 17], [4, 17], [2, 16], [4, 16]]) v.set(key(x, y, 0), C.print);
    // Cuello
    box(v, -2, 20, -4, 1, 21, -2, C.skin2);
    // Hombros y brazos (mangas + antebrazo apoyado)
    box(v, -8, 15, -5, -7, 19, -2, C.tee);
    box(v, 6, 15, -5, 7, 19, -2, C.tee);
    box(v, -8, 11, -4, -7, 14, -1, C.skin);
    box(v, 6, 11, -4, 7, 14, -1, C.skin);
    box(v, -7, 10, 0, -6, 11, 3, C.skin);
    box(v, 5, 10, 0, 6, 11, 3, C.skin);
    // Portátil: base con teclado y tapa vista por detrás
    box(v, -7, 10, 0, 6, 10, 8, C.lid2);
    box(v, -6, 10, 1, 5, 10, 6, C.key);
    box(v, -7, 11, 8, 6, 18, 8, C.lid);
    box(v, -7, 11, 9, 6, 11, 9, C.lid2);
    // El punto de repasaYA en la tapa
    box(v, -1, 13, 9, 0, 16, 9, C.dot);
    box(v, -2, 14, 9, 1, 15, 9, C.dot);
    // Taza
    box(v, 12, 10, 1, 15, 14, 4, C.mug);
    box(v, 12, 12, 1, 15, 12, 4, C.mugr);
    box(v, 13, 14, 2, 14, 14, 3, C.coffee);
    box(v, 16, 11, 2, 16, 13, 3, C.mug);
    // Libros y planta
    box(v, -19, 10, -1, -10, 11, 6, C.bk1);
    box(v, -19, 10, 6, -10, 11, 6, C.page);
    box(v, -18, 12, 0, -11, 13, 5, C.bk2);
    box(v, -18, 12, 5, -11, 13, 5, C.page);
    box(v, -17, 14, 1, -12, 14, 4, C.bk3);
    box(v, -16, 15, 1, -13, 18, 4, C.pot);
    const r = rng(11);
    for (let i = 0; i < 26; i++) {
      const x = -16 + Math.floor(r() * 4);
      const z = 1 + Math.floor(r() * 4);
      const y = 19 + Math.floor(r() * 5);
      v.set(key(x + Math.round((r() - 0.5) * 3), y, z + Math.round((r() - 0.5) * 3)), r() > 0.5 ? C.leaf : C.leaf2);
    }
    return v;
  }

  /* Cabeza relativa al cuello (0,0,0 = base del cuello) */
  function buildHead(): Vox {
    const v: Vox = new Map();
    box(v, -5, 0, -6, 4, 9, 2, C.skin);
    box(v, -5, 0, -6, -5, 9, 2, C.skin2);
    // Orejas
    box(v, -6, 3, -3, -6, 5, -2, C.skin2);
    box(v, 5, 3, -3, 5, 5, -2, C.skin2);
    // Ojos con brillo
    for (const x0 of [-4, 1]) {
      box(v, x0, 4, 3, x0 + 1, 5, 3, C.eye);
      v.set(key(x0, 5, 3), C.white);
    }
    // Cejas
    box(v, -4, 7, 3, -2, 7, 3, C.brow);
    box(v, 1, 7, 3, 3, 7, 3, C.brow);
    // Nariz, sonrisa y mejillas
    v.set(key(-1, 3, 3), C.skin2);
    v.set(key(0, 3, 3), C.skin);
    box(v, -1, 1, 3, 0, 1, 3, C.lip);
    v.set(key(-2, 2, 3), C.lip);
    v.set(key(1, 2, 3), C.lip);
    v.set(key(-4, 3, 3), C.blush);
    v.set(key(3, 3, 3), C.blush);
    // Pelo rizado: casquete + rizos sueltos
    const r = rng(5);
    const hairC = () => (r() > 0.7 ? C.hair3 : r() > 0.45 ? C.hair2 : C.hair);
    for (let x = -6; x <= 5; x++)
      for (let z = -7; z <= 3; z++) {
        const top = 10 + Math.floor(r() * 3);
        for (let y = 9; y <= top; y++) v.set(key(x, y, z), hairC());
      }
    for (let x = -6; x <= 5; x++) for (let y = 2; y <= 10; y++) v.set(key(x, y, -7), hairC());
    for (const x of [-6, 5]) for (let y = 6; y <= 10; y++) for (let z = -6; z <= 1; z++) v.set(key(x, y, z), hairC());
    // Flequillo rizado sobre la frente
    for (let x = -5; x <= 4; x++) {
      v.set(key(x, 9, 3), hairC());
      if (r() > 0.45) v.set(key(x, 8, 3), hairC());
      if (r() > 0.6) v.set(key(x, 10, 4), hairC());
    }
    // Rizos que sobresalen del contorno
    for (let i = 0; i < 70; i++) {
      const x = -7 + Math.floor(r() * 14);
      const z = -8 + Math.floor(r() * 12);
      const y = 8 + Math.floor(r() * 6);
      const k = key(x, y, z);
      if (!v.has(k) && (y >= 11 || x <= -6 || x >= 5 || z <= -7)) v.set(k, hairC());
    }
    return v;
  }

  function buildHands(phase: number): Vox {
    const v: Vox = new Map();
    box(v, -6, 11, 3, -4, 11, 5, C.skin);
    box(v, 3, 11, 3, 5, 11, 5, C.skin);
    // dedo levantado alterno
    v.set(key(phase ? -5 : -4, 12, 5), C.skin);
    v.set(key(phase ? 4 : 3, 12, 5), C.skin);
    return v;
  }

  /* Agrupa vóxeles por color en InstancedMesh (pocas llamadas de dibujo) */
  const geo = new BoxGeometry(1, 1, 1);
  const mats = new Map<string, MeshLambertMaterial>();
  const mat = (c: string) => {
    if (!mats.has(c)) mats.set(c, new MeshLambertMaterial({ color: new Color(c) }));
    return mats.get(c)!;
  };
  function toGroup(v: Vox): Group {
    const g = new Group();
    const byColor = new Map<string, number[][]>();
    for (const [k, c] of v) {
      if (!byColor.has(c)) byColor.set(c, []);
      byColor.get(c)!.push(k.split(',').map(Number));
    }
    const m = new Matrix4();
    for (const [c, list] of byColor) {
      const mesh = new InstancedMesh(geo, mat(c), list.length);
      list.forEach(([x, y, z], i) => mesh.setMatrixAt(i, m.makeTranslation(x, y, z)));
      g.add(mesh);
    }
    return g;
  }

  function init() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-pixel-me]');
    if (!canvas || canvas.dataset.ready) return;
    canvas.dataset.ready = '1';

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, alpha: true, antialias: false });
    } catch {
      return;
    }
    renderer.setPixelRatio(1);
    renderer.setClearColor(0x000000, 0);

    const scene = new Scene();
    scene.add(new AmbientLight(0xfff1e0, 1.25));
    const sun = new DirectionalLight(0xffffff, 1.6);
    sun.position.set(18, 40, 30);
    scene.add(sun);
    const lamp = new PointLight(0xffc77a, 120, 60);
    lamp.position.set(18, 26, 14);
    scene.add(lamp);

    scene.add(toGroup(buildStatic()));
    const head = toGroup(buildHead());
    head.position.set(0, 22, -2);
    scene.add(head);
    const handsA = toGroup(buildHands(0));
    const handsB = toGroup(buildHands(1));
    handsB.visible = false;
    scene.add(handsA, handsB);

    // Vapor: cubitos que suben y se desvanecen
    const steamMat = new MeshLambertMaterial({ color: 0xffffff, transparent: true, opacity: 0.8 });
    const steam = Array.from({ length: 7 }, (_, i) => {
      const s = new InstancedMesh(new BoxGeometry(0.7, 0.7, 0.7), steamMat, 1);
      s.setMatrixAt(0, new Matrix4());
      s.userData.offset = i / 7;
      scene.add(s);
      return s;
    });

    const cam = new OrthographicCamera(-1, 1, 1, -1, 0.1, 400);
    const target = { x: -1, y: 18, z: 0 };
    const SCALE = 18.5; // mitad del ancho visible, en vóxeles
    const PIX = 3; // tamaño de cada píxel de pantalla

    function resize() {
      const w = canvas!.clientWidth || 380;
      const h = canvas!.clientHeight || 330;
      renderer.setSize(Math.max(1, Math.round(w / PIX)), Math.max(1, Math.round(h / PIX)), false);
      const aspect = w / h;
      cam.left = -SCALE * aspect;
      cam.right = SCALE * aspect;
      cam.top = SCALE;
      cam.bottom = -SCALE;
      cam.updateProjectionMatrix();
    }
    resize();
    new ResizeObserver(resize).observe(canvas);

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = true;
    let raf = 0;
    const m = new Matrix4();

    function frame(t: number) {
      const s = t / 1000;
      const yaw = 0.34 + (reduce ? 0 : Math.sin(s * 0.35) * 0.14);
      cam.position.set(target.x + Math.sin(yaw) * 80, target.y + 30, target.z + Math.cos(yaw) * 80);
      cam.lookAt(target.x, target.y, target.z);

      if (!reduce) {
        head.position.y = 22 + (Math.floor(s * 2) % 2 ? 0.35 : 0);
        head.rotation.z = Math.sin(s * Math.PI) * 0.03;
        const typing = Math.floor(s * 6) % 2 === 0;
        handsA.visible = typing;
        handsB.visible = !typing;
      }
      steam.forEach((st) => {
        const p = (s * 0.45 + st.userData.offset) % 1;
        const wob = Math.sin((p + st.userData.offset) * 9) * 0.6;
        st.setMatrixAt(0, m.makeTranslation(13.5 + wob, 15 + p * 9, 2.5 + wob * 0.5));
        st.instanceMatrix.needsUpdate = true;
        st.visible = !reduce || p < 0.6;
      });
      steamMat.opacity = 0.75;
      renderer.render(scene, cam);
    }

    function loop(t: number) {
      frame(t);
      if (visible && !reduce) raf = requestAnimationFrame(loop);
    }

    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting && !document.hidden;
      if (visible && !was && !reduce) raf = requestAnimationFrame(loop);
      if (!visible) cancelAnimationFrame(raf);
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        visible = false;
        cancelAnimationFrame(raf);
      } else if (!reduce) {
        visible = true;
        raf = requestAnimationFrame(loop);
      }
    });

    if (reduce) frame(0);
    else raf = requestAnimationFrame(loop);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
