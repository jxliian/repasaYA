---
/**
 * GlobalSearch — buscador global tipo paleta de comandos.
 *
 * Se usa en dos sitios con el mismo componente:
 *   variant="hero"    → grande, centrado, protagonista de la landing
 *   variant="compact" → en la cabecera sticky del resto de páginas
 *
 * El índice (`/search-index.json`) se pide la primera vez que el usuario
 * escribe o enfoca. Nada de meter 400 asignaturas en el HTML.
 */
interface Props {
  variant?: 'hero' | 'compact';
  placeholder?: string;
  id?: string;
}

const {
  variant = 'hero',
  placeholder = '¿Qué te toca hoy? Prueba con «RRHH» o «punteros»',
  id = 'gsearch',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ISSUE_URL =
  'https://github.com/jxliian/repasaYA/issues/new?title=Solicitud%3A+%5BNombre+de+la+asignatura%5D&body=%23%23+Datos%0A-+**Asignatura**%3A+%0A-+**Grado**%3A+%0A-+**Curso**%3A+%0A-+**Cuatrimestre**%3A+';
---

<div
  class:list={['gs', `gs--${variant}`]}
  data-gsearch
  data-index={`${base}search-index.json`}
  data-issue={ISSUE_URL}
>
  <div class="gs-bar glass">
    <svg
      class="gs-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M21 21l-4.5-4.5"></path>
    </svg>

    <input
      class="gs-input"
      id={id}
      type="search"
      placeholder={placeholder}
      aria-label="Buscar asignatura o material"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls={`${id}-results`}
      aria-autocomplete="list"
    />

    <kbd class="gs-kbd" aria-hidden="true">⌘K</kbd>
  </div>

  <div class="gs-panel glass" id={`${id}-results`} role="listbox" hidden>
    <div class="gs-list"></div>
    <div class="gs-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> moverte · <kbd>↵</kbd> abrir · <kbd>esc</kbd> salir</span>
    </div>
  </div>
</div>

<style>
  .gs {
    position: relative;
    width: 100%;
  }
  .gs--hero {
    max-width: 620px;
    margin-inline: auto;
  }
  .gs--compact {
    max-width: 420px;
  }

  /* ── Barra ─────────────────────────────────────────────────── */
  .gs-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    transition: border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .gs--hero .gs-bar {
    height: 62px;
    border-radius: var(--radius-lg);
    padding-inline: 22px;
  }
  .gs--compact .gs-bar {
    height: 40px;
    border-radius: var(--radius-sm);
  }

  .gs-bar:focus-within {
    border-color: var(--glass-border-hi);
    box-shadow: var(--shadow-md), var(--glow-md), inset 0 1px 0 var(--glass-hi);
  }

  .gs-icon {
    color: var(--text-dim);
    flex-shrink: 0;
    transition: color var(--dur) var(--ease-out);
  }
  .gs-bar:focus-within .gs-icon {
    color: var(--accent);
  }

  .gs-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: inherit;
    letter-spacing: -0.01em;
  }
  .gs--hero .gs-input {
    font-size: 1.02rem;
  }
  .gs--compact .gs-input {
    font-size: 0.86rem;
  }
  .gs-input::placeholder {
    color: var(--text-dim);
  }
  .gs-input::-webkit-search-cancel-button {
    display: none;
  }

  .gs-kbd {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--text-dim);
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xs);
    padding: 3px 8px;
    transition: opacity var(--dur) var(--ease-out);
  }
  .gs-bar:focus-within .gs-kbd {
    opacity: 0;
  }

  /* ── Panel de resultados ───────────────────────────────────── */
  .gs-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    z-index: 90;
    border-radius: var(--radius);
    overflow: hidden;
    backdrop-filter: blur(var(--blur-lg)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--blur-lg)) saturate(160%);
    background: var(--glass-strong);
    box-shadow: var(--shadow-lg), var(--glow-sm);
    animation: gsIn 0.18s var(--ease-snap);
  }
  .gs-panel[hidden] {
    display: none;
  }
  @keyframes gsIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .gs-list {
    max-height: min(58vh, 420px);
    overflow-y: auto;
    padding: 8px;
    scrollbar-width: thin;
  }

  .gs-group {
    padding: 12px 12px 6px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .gs-item {
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
    padding: 11px 12px;
    border-radius: var(--radius-sm);
    text-align: left;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .gs-item[aria-selected='true'] {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent-line);
  }

  .gs-emoji {
    font-size: 1.15rem;
    line-height: 1;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-xs);
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
  }

  .gs-body {
    min-width: 0;
    flex: 1;
  }
  .gs-title {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gs-title mark {
    background: none;
    color: var(--accent-bright);
    font-weight: 700;
  }
  .gs-meta {
    display: block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gs-tags {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }
  .gs-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    padding: 3px 7px;
    border-radius: var(--radius-xs);
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }
  .gs-tag--empty {
    color: var(--text-dim);
    background: var(--glass-hi);
    border-color: var(--glass-border);
  }
  @media (max-width: 620px) {
    .gs-tags {
      display: none;
    }
  }

  /* Asignatura del plan sin material: se ve, pero apagada */
  .gs-item.is-planned .gs-emoji,
  .gs-item.is-planned .gs-title {
    opacity: 0.55;
  }
  .gs-item.is-planned:hover .gs-emoji,
  .gs-item.is-planned:hover .gs-title,
  .gs-item.is-planned[aria-selected='true'] .gs-emoji,
  .gs-item.is-planned[aria-selected='true'] .gs-title {
    opacity: 0.85;
  }

  .gs-empty {
    padding: 26px 18px;
    text-align: center;
  }
  .gs-empty p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 14px;
  }
  .gs-empty strong {
    color: var(--text);
  }
  .gs-empty a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent-bright), var(--accent-deep));
    box-shadow: var(--glow-sm);
  }

  .gs-foot {
    padding: 9px 14px;
    border-top: 1px solid var(--glass-border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-dim);
  }
  .gs-foot kbd {
    font-family: inherit;
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
    border-radius: 4px;
    padding: 1px 5px;
    margin-right: 2px;
  }
  @media (max-width: 620px) {
    .gs-foot {
      display: none;
    }
  }
</style>

<script>
  interface Item {
    slug: string;
    title: string;
    icon: string;
    degree: string;
    degreeShort: string;
    year: number;
    semester: number;
    available: boolean;
    url: string;
    external: boolean;
    materialLabels: string[];
    haystack: string;
  }

  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
    );

  /** Issue de GitHub con los datos de la asignatura ya rellenos. */
  function contributeUrl(it: Item): string {
    const body = [
      '## Datos',
      `- **Asignatura**: ${it.title}`,
      `- **Grado**: ${it.degreeShort}`,
      `- **Curso**: ${it.year}º`,
      `- **Cuatrimestre**: ${it.semester}`,
      '',
      '## Qué aporto',
      '- [ ] Tipo test',
      '- [ ] Verdadero/Falso',
      '- [ ] Flashcards',
      '- [ ] Apuntes en PDF',
    ].join('\n');
    return (
      'https://github.com/jxliian/repasaYA/issues/new' +
      `?title=${encodeURIComponent('Material: ' + it.title)}` +
      `&body=${encodeURIComponent(body)}`
    );
  }

  /** Resalta el primer tramo que coincide, sin romper el HTML de alrededor. */
  function highlight(title: string, q: string): string {
    const i = norm(title).indexOf(q);
    if (i < 0 || !q) return escapeHtml(title);
    return (
      escapeHtml(title.slice(0, i)) +
      '<mark>' +
      escapeHtml(title.slice(i, i + q.length)) +
      '</mark>' +
      escapeHtml(title.slice(i + q.length))
    );
  }

  /**
   * Puntuación simple y predecible: cuanto antes aparece lo que escribes
   * en el título, más arriba sale. Todos los términos deben aparecer.
   */
  function score(item: Item, terms: string[]): number {
    let total = 0;
    const t = norm(item.title);
    for (const term of terms) {
      if (t.startsWith(term)) total += 100;
      else if (t.includes(term)) total += 60;
      else if (item.haystack.includes(term)) total += 20;
      else return -1; // falta un término → fuera
    }
    // A igualdad de coincidencia, lo que ya tiene material va primero
    return item.available ? total + 15 : total;
  }

  function initSearch(root: HTMLElement) {
    if (root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const input = root.querySelector('.gs-input') as HTMLInputElement;
    const panel = root.querySelector('.gs-panel') as HTMLElement;
    const list = root.querySelector('.gs-list') as HTMLElement;
    const kbd = root.querySelector('.gs-kbd') as HTMLElement | null;

    if (kbd) {
      const mac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
      kbd.textContent = mac ? '⌘K' : 'Ctrl K';
    }

    let items: Item[] | null = null;
    let loading: Promise<void> | null = null;
    let results: Item[] = [];
    let cursor = -1;

    function loadIndex(): Promise<void> {
      if (items) return Promise.resolve();
      if (loading) return loading;
      loading = fetch(root.dataset.index!)
        .then((r) => r.json())
        .then((d) => {
          items = d.items;
        })
        .catch(() => {
          items = [];
        });
      return loading;
    }

    function close() {
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      cursor = -1;
    }

    function open() {
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function render(q: string) {
      const terms = norm(q).split(/\s+/).filter(Boolean);

      if (!terms.length) return close();

      results = (items ?? [])
        .map((it) => ({ it, s: score(it, terms) }))
        .filter((r) => r.s >= 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 12)
        .map((r) => r.it);

      if (!results.length) {
        list.innerHTML = `
          <div class="gs-empty">
            <p>Nada por aquí con <strong>«${escapeHtml(q)}»</strong>.<br>Puede que aún no la haya subido.</p>
            <a href="${root.dataset.issue}" target="_blank" rel="noopener">Pídela en GitHub →</a>
          </div>`;
        cursor = -1;
        return open();
      }

      // Agrupa por grado para que se vea la jerarquía sin explicarla
      const byDegree = new Map<string, Item[]>();
      for (const it of results) {
        const arr = byDegree.get(it.degreeShort) ?? [];
        arr.push(it);
        byDegree.set(it.degreeShort, arr);
      }

      let html = '';
      let idx = 0;
      const first = norm(terms[0]);
      for (const [degree, group] of byDegree) {
        html += `<div class="gs-group">${escapeHtml(degree)}</div>`;
        for (const it of group) {
          // Sin material aún → se muestra igual, apagada, y el enlace
          // lleva a aportarla. Buscar algo y no encontrar nada es peor.
          const note = !it.available
            ? ' · sin material todavía'
            : it.external
              ? ' · repo aparte'
              : '';
          const tags = it.available
            ? it.materialLabels
                .slice(0, 2)
                .map((m) => `<span class="gs-tag">${escapeHtml(m)}</span>`)
                .join('')
            : '<span class="gs-tag gs-tag--empty">súbela tú</span>';

          const href = it.available ? it.url : contributeUrl(it);
          const blank = it.external || !it.available;

          html += `
            <a class="gs-item${it.available ? '' : ' is-planned'}"
               role="option" aria-selected="false"
               data-i="${idx}" href="${href}"
               ${blank ? 'target="_blank" rel="noopener"' : ''}>
              <span class="gs-emoji" aria-hidden="true">${it.icon}</span>
              <span class="gs-body">
                <span class="gs-title">${highlight(it.title, first)}</span>
                <span class="gs-meta">${it.year}º · C${it.semester}${note}</span>
              </span>
              <span class="gs-tags">${tags}</span>
            </a>`;
          idx++;
        }
      }
      list.innerHTML = html;
      cursor = -1;
      open();
    }

    function move(delta: number) {
      const nodes = list.querySelectorAll<HTMLElement>('.gs-item');
      if (!nodes.length) return;
      cursor = (cursor + delta + nodes.length) % nodes.length;
      nodes.forEach((n, i) => n.setAttribute('aria-selected', String(i === cursor)));
      nodes[cursor].scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('focus', loadIndex, { once: true });
    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (!q) return close();
      loadIndex().then(() => render(input.value.trim()));
    });

    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter' && cursor >= 0) {
        e.preventDefault();
        list.querySelectorAll<HTMLElement>('.gs-item')[cursor]?.click();
      } else if (e.key === 'Escape') {
        if (panel.hidden) input.blur();
        else close();
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }

  function bindShortcut() {
    if ((window as any).__gsShortcut) return;
    (window as any).__gsShortcut = true;
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        const el = document.querySelector<HTMLInputElement>('[data-gsearch] .gs-input');
        el?.focus();
        el?.select();
      }
    });
  }

  function setup() {
    document.querySelectorAll<HTMLElement>('[data-gsearch]').forEach(initSearch);
    bindShortcut();
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
