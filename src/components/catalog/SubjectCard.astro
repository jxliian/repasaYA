---
import { subjectUrl, subjectSlug, degreeSlug, contributeUrl } from '../../lib/routes';
import type { Subject } from '../../lib/routes';

/**
 * Tarjeta de asignatura del catálogo.
 *
 * Dos estados: con material (cristal vivo, borde que se enciende) y sin
 * material (apagada, enlaza al issue para aportarlo). Las vacías se
 * muestran igual a propósito: enseñan el plan completo y son la vía
 * más directa para que alguien contribuya.
 *
 * Los `data-*` son los que lee FilterBar para filtrar sin recargar.
 */
interface Props {
  subject: Subject;
  degreeName: string;
  degreeShort: string;
  /** Mostrar el curso/cuatrimestre (útil en listados mezclados) */
  showPlace?: boolean;
}

const { subject, degreeName, degreeShort, showPlace = false } = Astro.props;

const MATERIAL_LABEL: Record<string, string> = {
  test: 'Tipo test',
  vf: 'V/F',
  reveal: 'Quiz',
  flashcards: 'Flashcards',
  glosario: 'Glosario',
  apuntes: 'Apuntes',
  examen: 'Exámenes',
};

const url = subjectUrl(subject);
const available = url !== null;
const href = url ?? contributeUrl(subject, degreeName);
const isExternal = Boolean(subject.data.external) || !available;
const { title, icon, year, semester, credits, description, materials } = subject.data;
---

<a
  class:list={['card', { 'is-planned': !available }]}
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
  data-subject
  data-slug={subjectSlug(subject)}
  data-degree={degreeSlug(subject)}
  data-year={year}
  data-semester={semester}
  data-status={available ? 'available' : 'planned'}
  data-materials={materials.join(' ')}
>
  <span class="main">
    <span class="title">{title}</span>
    <span class="meta">
      {showPlace && <span>{year}º curso, {semester === 1 ? '1er' : '2º'} cuatrimestre</span>}
      <span>{credits} ECTS</span>
    </span>
  </span>
  <span class="side">
    {
      available ? (
        <span class="mats">
          {materials.map((m) => MATERIAL_LABEL[m] ?? m).join(', ')}
          {subject.data.external && ' (repositorio aparte)'}
        </span>
      ) : (
        <span class="ask">Sin material. Súbelo tú</span>
      )
    }
  </span>
  <span class="sr-only">{degreeShort}</span>
</a>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 8px 24px;
    padding: 13px 20px;
    border-top: 1px solid var(--line);
  }
  .card:first-child {
    border-top: 0;
  }
  .card:hover {
    background: var(--brand-soft);
  }
  .card[hidden] {
    display: none;
  }
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .title {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
  }
  .card:hover .title {
    color: var(--brand);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .side {
    flex: 0 1 auto;
    max-width: 46%;
    text-align: right;
    font-size: 0.86rem;
    color: var(--ink-2);
  }
  .is-planned .title {
    color: var(--ink-2);
    font-weight: 500;
  }
  .ask {
    color: var(--ink-3);
  }
  .is-planned:hover .ask {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 620px) {
    .card {
      flex-direction: column;
      align-items: flex-start;
    }
    .side {
      max-width: none;
      text-align: left;
    }
  }
</style>
