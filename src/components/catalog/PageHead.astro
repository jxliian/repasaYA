---
/** Cabecera de las páginas de catálogo: título, frase y cifras. */
interface Props {
  kicker?: string;
  icon?: string;
  title: string;
  lede?: string;
  stats?: { value: string | number; label: string }[];
}

const { kicker, icon, title, lede, stats = [] } = Astro.props;
---

<header class="page-head">
  {kicker && <p class="mono-label">{kicker}</p>}

  <h1>{title}<span class="pt">.</span></h1>

  {lede && <p class="lede">{lede}</p>}

  {
    stats.length > 0 && (
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    )
  }
</header>

<style>
  .page-head {
    padding-block: 14px 26px;
  }
  .page-head .mono-label {
    margin-bottom: 6px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lede {
    margin-top: 10px;
    max-width: 68ch;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 16px;
    font-size: 0.92rem;
  }
  .stats div {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .stats dt {
    font-weight: 700;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }
  .stats dd {
    color: var(--ink-2);
  }
</style>
