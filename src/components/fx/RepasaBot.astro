---
/**
 * Zero — asistente de repasaYA (antes RepasaBot).
 *
 * El archivo conserva su nombre para no tocar los layouts que lo importan
 * (Shell y QuizShell), y el contenedor mantiene `#repasa-bot-root` porque
 * el motor de tests lo oculta en móvil por ese id.
 *
 * Todo ocurre en el navegador: no hay modelo de lenguaje ni servidor.
 *  1. Busca asignaturas en `search-index.json` (el mismo índice del
 *     buscador, pedido solo la primera vez que se pregunta algo) y
 *     entiende grado, curso y tipo de material: «tests de 4º de ADE».
 *  2. Si la pregunta no va de asignaturas, responde las dudas frecuentes
 *     (descuento UGR, favoritas, imprimir, privacidad…).
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div id="repasa-bot-root" data-base={base}>
  <button id="zero-fab" class="zero-fab" type="button" aria-expanded="false" aria-controls="zero-panel">
    <svg class="zero-mark" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
      <ellipse cx="10" cy="12" rx="6" ry="8.2" fill="none" stroke="currentColor" stroke-width="2.2"></ellipse>
      <circle cx="19.6" cy="18.6" r="2.3" fill="var(--dot)"></circle>
    </svg>
    <span>Pregunta a Zero</span>
  </button>

  <section id="zero-panel" class="zero-panel" hidden aria-label="Zero, asistente de repasaYA">
    <div class="zero-head">
      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
        <ellipse cx="10" cy="12" rx="6" ry="8.2" fill="none" stroke="#fff" stroke-width="2"></ellipse>
        <circle cx="19.6" cy="18.6" r="2.3" fill="var(--dot)"></circle>
      </svg>
      <div>
        <strong>Zero</strong>
        <span>Asistente de repasaYA</span>
      </div>
      <button id="zero-close" type="button" aria-label="Cerrar asistente">✕</button>
    </div>

    <div id="zero-log" class="zero-log" aria-live="polite"></div>

    <div id="zero-sugg" class="zero-sugg">
      <p>Prueba a preguntar</p>
      <button type="button">¿Dónde está la relación de Dirección Financiera?</button>
      <button type="button">Tests de 4º de Informática</button>
      <button type="button">¿Cuánto resta un fallo en la UGR?</button>
    </div>

    <form id="zero-form" class="zero-form">
      <label for="zero-q" class="sr-only">Pregunta</label>
      <input id="zero-q" autocomplete="off" maxlength="200" placeholder="Escribe una asignatura o una duda" />
      <button type="submit">Enviar</button>
    </form>
  </section>
</div>

<style>
  .zero-fab {
    position: fixed;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 9px;
    height: 46px;
    padding: 0 16px 0 12px;
    background: var(--band);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    font: 600 0.9rem var(--font-body);
    box-shadow: 0 8px 24px rgba(40, 10, 16, 0.28);
  }
  .zero-fab:hover {
    background: var(--brand-hover);
  }

  .zero-panel {
    position: fixed;
    right: calc(20px + env(safe-area-inset-right, 0px));
    bottom: calc(78px + env(safe-area-inset-bottom, 0px));
    z-index: 301;
    width: min(390px, calc(100vw - 32px));
    height: min(560px, calc(100dvh - 120px));
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 50px rgba(40, 10, 16, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .zero-panel[hidden] {
    display: none;
  }
  .zero-head {
    background: var(--band);
    color: #fff;
    padding: 12px 14px 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .zero-head strong {
    display: block;
    font-size: 0.98rem;
  }
  .zero-head span {
    font-size: 0.8rem;
    color: var(--on-band-2);
  }
  .zero-head button {
    margin-left: auto;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius);
    color: #fff;
    width: 30px;
    height: 30px;
  }

  .zero-log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.9rem;
  }
  .zero-log :global(.zmsg) {
    max-width: 90%;
    padding: 10px 12px;
    border-radius: var(--radius);
    line-height: 1.5;
  }
  .zero-log :global(.zmsg.b) {
    background: var(--canvas);
    border: 1px solid var(--line);
  }
  .zero-log :global(.zmsg.u) {
    align-self: flex-end;
    background: var(--band);
    color: #fff;
  }
  .zero-log :global(.zmsg ul) {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .zero-log :global(.zmsg a) {
    color: var(--brand);
    font-weight: 600;
  }
  .zero-log :global(.zmsg a:hover) {
    text-decoration: underline;
  }
  .zero-log :global(.zmsg small) {
    display: block;
    color: var(--ink-3);
    font-size: 0.8rem;
  }

  .zero-sugg {
    border-top: 1px solid var(--line);
  }
  .zero-sugg p {
    padding: 9px 16px 2px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .zero-sugg button {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 7px 16px;
    font: 600 0.86rem var(--font-body);
    color: var(--brand);
  }
  .zero-sugg button:last-child {
    padding-bottom: 11px;
  }
  .zero-sugg button:hover {
    background: var(--brand-soft);
  }

  .zero-form {
    display: flex;
    border-top: 1px solid var(--line);
  }
  .zero-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 14px 16px;
    font: 400 0.92rem var(--font-body);
    background: var(--paper);
    color: var(--ink);
    outline: none;
  }
  .zero-form button {
    border: 0;
    background: var(--band);
    color: #fff;
    padding: 0 18px;
    font: 600 0.86rem var(--font-body);
  }

  @media (max-width: 520px) {
    .zero-panel {
      left: max(16px, env(safe-area-inset-left, 0px));
      right: max(16px, env(safe-area-inset-right, 0px));
      width: auto;
    }
    .zero-fab span {
      display: none;
    }
    .zero-fab {
      padding: 0 12px;
    }
  }
  @media print {
    #repasa-bot-root {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById('repasa-bot-root');
    const fab = document.getElementById('zero-fab');
    const panel = document.getElementById('zero-panel');
    const log = document.getElementById('zero-log');
    const input = document.getElementById('zero-q');
    if (!root || !fab || !panel || !log || !input || root.dataset.ready) return;
    root.dataset.ready = '1';
    const base = root.dataset.base || '/';

    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]);
    const norm = (s) => String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    function say(html, who) {
      const d = document.createElement('div');
      d.className = 'zmsg ' + who;
      d.innerHTML = html;
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
    }

    function open(state) {
      panel.hidden = !state;
      fab.setAttribute('aria-expanded', String(state));
      if (state) {
        if (!log.children.length)
          say('Hola, soy Zero, el asistente de repasaYA. Dime qué asignatura o material buscas y te llevo directo. También resuelvo dudas sobre cómo funcionan los tests.', 'b');
        input.focus();
      }
    }
    fab.addEventListener('click', () => open(panel.hidden));
    document.getElementById('zero-close').addEventListener('click', () => {
      open(false);
      fab.focus();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        open(false);
        fab.focus();
      }
    });

    /* Índice de asignaturas: se pide una sola vez */
    let indexPromise = null;
    const loadIndex = () =>
      (indexPromise ??= fetch(base + 'search-index.json')
        .then((r) => (r.ok ? r.json() : []))
        .then((d) => (Array.isArray(d) ? d : d.items || []))
        .catch(() => []));

    const KIND = {
      'Tipo test': /\btests?\b|tipo test/,
      Apuntes: /apunte|relacion|resumen|teoria|pdf/,
      'Exámenes': /examen/,
      Flashcards: /flashcard|fichas/,
      'V/F': /verdadero|falso|\bvf\b/,
      Glosario: /glosario/,
    };
    const STOP = new Set('de del la las el los en y a que donde esta estan hay para con por un una me mi quiero busco dame tests test apuntes examenes examen relacion curso grado material materiales primero segundo tercero cuarto quinto cuatrimestre ade informatica ingenieria'.split(' '));
    const ORD = { primero: 1, segundo: 2, tercero: 3, cuarto: 4, quinto: 5 };

    const FAQ = [
      [/resta|penaliz|descuento|fallo/, 'En los test de la UGR lo normal es que <strong>3 fallos resten 1 acierto</strong> (−0,33 por fallo) y en verdadero/falso <strong>2 fallos resten 1</strong> (−0,50). Al hacer un test puedes activar <em>Descuento por fallo UGR</em> para ver tu nota real sobre 10.'],
      [/favorit|guardar|marcar/, 'Durante un test pulsa <strong>Favorita</strong> en la pregunta. Luego, en la asignatura, entra en <strong>Mis favoritas</strong> para repasar solo esas.'],
      [/imprim|papel|descarg/, 'En cada asignatura tienes <strong>Versión para imprimir</strong>: las preguntas en blanco y negro y la hoja de soluciones al final.'],
      [/gratis|precio|pago|registro|cuenta|privacidad|cookie|datos/, 'repasaYA es <strong>gratis, sin registro, sin anuncios y sin cookies</strong>. Tu progreso se guarda solo en tu navegador.'],
      [/racha|estadistic|nota media|reinici/, 'repasaYA guarda en tu navegador tu <strong>nota media UGR</strong>, tu <strong>racha máxima</strong> y tus simulacros. Para reiniciar una asignatura, usa la papelera de la barra de estadísticas.'],
      [/punto.? debil|debiles/, 'Las preguntas que fallas van a <strong>Puntos débiles</strong>, dentro de cada asignatura, para que las repitas hasta dominarlas.'],
      [/contact|correo|error|aportar|julian|quien|creador/, 'repasaYA lo hace Julián Carrión, estudiante del Doble Grado ADE + Informática en la UGR. Para avisar de un error o aportar material, usa <a href="' + base + '#contacto">el formulario de contacto</a>.'],
    ];

    async function reply(raw) {
      const n = norm(raw);
      const kinds = Object.keys(KIND).filter((k) => KIND[k].test(n));
      const deg = /informatica|ingenieria|\binf\b/.test(n) ? 'informatica' : /\bade\b|empresa/.test(n) ? 'ade' : null;
      const ym = n.match(/\b([1-5])\s*(º|o|er)?\b/) || n.match(/primero|segundo|tercero|cuarto|quinto/);
      const year = ym ? Number(ym[1]) || ORD[ym[0]] : null;
      const words = n.split(/[^a-z0-9]+/).filter((w) => w.length > 2 && !STOP.has(w));

      const idx = (await loadIndex()).filter((s) => s.available);
      const inTitle = (s, w) => norm(s.title).includes(w) || s.slug === w;
      const titleHit = idx.some((s) => words.some((w) => inTitle(s, w)));

      // Las dudas frecuentes ganan salvo que se nombre una asignatura
      const faq = FAQ.find(([r]) => r.test(n));
      if (faq && !titleHit && !deg && !year && !kinds.length) return faq[1];

      // Puntúa por el título; si nada encaja, por la descripción
      let hits = idx.map((s) => ({
        s,
        sc: words.reduce((a, w) => a + (inTitle(s, w) ? 2 : !titleHit && s.haystack.includes(w) ? 1 : 0), 0),
      }));
      const named = hits.some((h) => h.sc > 0);
      hits = hits.filter(
        (h) =>
          (!named || h.sc > 0) &&
          (!deg || h.s.degree === deg) &&
          (!year || h.s.year === year) &&
          (!kinds.length || kinds.some((k) => h.s.materialLabels.includes(k)))
      );
      if (!named && !deg && !year && !kinds.length) hits = [];
      hits.sort((a, b) => b.sc - a.sc || b.s.year - a.s.year);
      if (named && hits.length) hits = hits.filter((h) => h.sc === hits[0].sc);

      if (!hits.length) {
        if (faq) return faq[1];
        return 'No he encontrado nada con eso. Prueba con el nombre de la asignatura (por ejemplo «Econometría») o con un tipo de material y un curso («tests de 4º de ADE»).';
      }
      const top = hits.slice(0, 5);
      const what = kinds.length ? kinds.join(' y ').toLowerCase() : 'material';
      return (
        (hits.length === 1 ? 'Lo tienes aquí:' : `He encontrado ${hits.length} asignaturas con ${what}:`) +
        '<ul>' +
        top
          .map(({ s }) => `<li><a href="${esc(s.url)}">${esc(s.title)}</a><small>${esc(s.degreeShort)}, ${s.year}º curso. ${esc(s.materialLabels.join(', '))}</small></li>`)
          .join('') +
        '</ul>' +
        (hits.length > 5 ? `<p style="margin-top:8px">Y ${hits.length - 5} más en <a href="${base}#asignaturas">el buscador de la portada</a>.</p>` : '')
      );
    }

    async function ask(q) {
      q = q.trim();
      if (!q) return;
      say(esc(q), 'u');
      say(await reply(q), 'b');
    }
    document.getElementById('zero-form').addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
      input.value = '';
    });
    document.getElementById('zero-sugg').addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON') ask(e.target.textContent);
    });
  })();
</script>
