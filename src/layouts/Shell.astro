---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/nav/SiteHeader.astro';
import About from '../components/sections/About.astro';
import RepasaBot from '../components/fx/RepasaBot.astro';
import { fetchHitsOnce } from '../lib/hits';
import { degreePath } from '../lib/routes';

/**
 * Shell — layout del catálogo: cabecera, contenido, «Sobre mí» con el
 * contacto, pie corporativo y el asistente Zero. Un único tema, claro.
 *
 * `QuizShell` es su equivalente para las páginas de material, que van sin
 * cabecera ni pie porque el motor ocupa la pantalla entera.
 */
interface Props {
  title: string;
  description?: string;
  /** Sin uso desde el rediseño: se acepta para no romper páginas antiguas. */
  ambient?: boolean;
  /** Fuera del índice de Google (páginas de prueba, duplicados). */
  noindex?: boolean;
}

const {
  title,
  description = 'Tests interactivos, verdadero/falso, flashcards y apuntes para ADE e Ingeniería Informática UGR. Plataforma 100% gratis, sin registro y sin anuncios.',
  ambient = true,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = 'https://repasaya.juliancarrion.dev/';
const canonical = `${siteUrl}${Astro.url.pathname.replace(/^\/|\/$/g, '')}${Astro.url.pathname === '/' ? '' : '/'}`;
const pageTitle = title === 'repasaYA' ? 'repasaYA — Tests, Flashcards y Apuntes UGR | Aprueba sin pagar ni un duro' : `${title} — repasaYA UGR`;
const year = new Date().getFullYear();
const visits = await fetchHitsOnce();

const favicon512 = `${siteUrl}favicon-512.png`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="repasaYA, repasaya ugr, tests ugr, apuntes ugr, ade ugr, informatica ugr, flashcards ugr, examenes ugr" />
    <meta name="author" content="Julián Carrión" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <link rel="canonical" href={canonical} />

    <!-- Favicon e Iconos oficiales para Google Search y Navegadores -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon-512.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon-48.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />

    <!-- Open Graph & Twitter Cards -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={favicon512} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="repasaYA" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={favicon512} />

    <!-- Datos estructurados Schema.org para Google (Entidad WebSite + Organization oficial) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}#website`,
          "url": siteUrl,
          "name": "repasaYA",
          "alternateName": ["repasa YA", "repasaYA UGR", "repasaYA ADE e Informática"],
          "description": "Plataforma oficial de tests interactivos, verdadero/falso, flashcards y apuntes para ADE e Ingeniería Informática UGR.",
          "inLanguage": "es-ES",
          "publisher": {
            "@id": `${siteUrl}#organization`
          }
        },
        {
          "@type": "EducationalOrganization",
          "@id": `${siteUrl}#organization`,
          "name": "repasaYA",
          "url": siteUrl,
          "logo": favicon512,
          "image": favicon512,
          "sameAs": [
            "https://github.com/jxliian/repasaYA",
            "https://github.com/jxliian"
          ],
          "founder": {
            "@type": "Person",
            "name": "Julián Carrión",
            "sameAs": "https://github.com/jxliian"
          }
        },
        {
          "@type": "EducationalApplication",
          "name": "repasaYA",
          "url": siteUrl,
          "description": "Tests interactivos, verdadero/falso y flashcards para el Doble Grado ADE + Ingeniería Informática de la UGR.",
          "applicationCategory": "EducationalApplication",
          "operatingSystem": "All",
          "inLanguage": "es",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "EUR"
          }
        }
      ]
    })} />
    <ClientRouter />
  </head>

  <body>
    <SiteHeader />

    <main id="contenido">
      <slot />
    </main>

    <About />

    <footer class="site-footer">
      <div class="container cols">
        <div class="brandcol">
          <a class="f-brand" href={base}>repasaYA<span class="pt">.</span></a>
          <p>Tests, apuntes y exámenes resueltos para repasar ADE e Informática en la UGR. Gratis, sin registro y sin anuncios.</p>
          {visits && (
            <p class="visits"><strong>{visits}</strong> visitas</p>
          )}
        </div>
        <div>
          <h2>Grados</h2>
          <ul>
            <li><a href={degreePath('ade')}>ADE</a></li>
            <li><a href={degreePath('informatica')}>Ingeniería Informática</a></li>
            <li><a href={`${base}mapa/`}>Mapa web</a></li>
          </ul>
        </div>
        <div>
          <h2>Proyecto</h2>
          <ul>
            <li><a href={`${base}#novedades`}>Novedades</a></li>
            <li><a href={`${base}#opiniones`}>Opiniones</a></li>
            <li><a href="https://github.com/jxliian/repasaYA" target="_blank" rel="noopener">Código en GitHub</a></li>
          </ul>
        </div>
        <div>
          <h2>Contacto</h2>
          <ul>
            <li><a href={`${base}#sobre-mi`}>Sobre mí</a></li>
            <li><a href={`${base}#contacto`}>Escríbeme</a></li>
            <li><a href={`${base}privacidad/`}>Privacidad</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <div class="container legal-row">
          <span>Hecho con ganas por <a href="https://github.com/jxliian" target="_blank" rel="noopener">Julián Carrión</a></span>
          <span>© {year} Universidad de Granada, Doble Grado ADE + Ingeniería Informática</span>
        </div>
      </div>
    </footer>

    <RepasaBot />

    <style is:global>
      main {
        min-height: 50vh;
      }

      .site-footer {
        background: var(--foot);
        color: var(--foot-text);
        font-size: 0.9rem;
      }
      .site-footer .cols {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
        gap: 32px;
        padding-block: 46px 34px;
      }
      @media (max-width: 820px) {
        .site-footer .cols {
          grid-template-columns: 1fr 1fr;
        }
        .site-footer .brandcol {
          grid-column: 1 / -1;
        }
      }
      .site-footer .f-brand {
        font-family: var(--font-brand);
        font-weight: 700;
        font-size: 1.65rem;
        color: #fff;
      }
      .site-footer .brandcol p {
        margin-top: 10px;
        max-width: 38ch;
        color: var(--foot-dim);
      }
      .site-footer .visits {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        margin-top: 18px !important;
        padding: 7px 12px;
        border: 1px solid var(--foot-line);
        border-radius: var(--radius);
      }
      .site-footer .visits strong {
        color: #fff;
        font-size: 1.05rem;
      }
      .site-footer h2 {
        margin-bottom: 12px;
        color: #fff;
        font-family: var(--font-body);
        font-size: 0.88rem;
        font-weight: 700;
      }
      .site-footer ul {
        list-style: none;
        display: grid;
        gap: 8px;
      }
      .site-footer ul a {
        color: var(--foot-text);
      }
      .site-footer ul a:hover {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .site-footer .legal {
        border-top: 1px solid var(--foot-line);
      }
      .site-footer .legal-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        padding-block: 16px;
        font-size: 0.8rem;
        color: var(--foot-dim);
      }
      .site-footer .legal a {
        color: var(--foot-text);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
    </style>
  </body>
</html>
