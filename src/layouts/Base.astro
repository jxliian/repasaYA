---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'repasaYA — Tipo test, V/F y flashcards para aprobar la carrera. Gratis, sin registro.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = `https://jxliian.github.io/repasaYA${Astro.url.pathname}`;
const pageTitle =
  title === 'repasaYA'
    ? 'repasaYA — Tests interactivos para la carrera'
    : `${title} — repasaYA`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="repasaya, tipo test, flashcards, universidad, ADE, informática, RRHH, OE, SIBW, gratis" />
  <meta name="author" content="jxliian" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href={`${base}logo.png`} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://jxliian.github.io/repasaYA/logo.png" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="repasaYA" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <ClientRouter />
  <style is:global>
    :root {
      --bg:           #050505;               /* #050505 — near-pure black */
      --surface:      #0a0a10;               /* solid surface for non-glass pages */
      --surface2:     #111118;
      --border:       rgba(255,255,255,0.10);
      /* EXACT glassmorphism spec: bg-white/5 backdrop-blur-xl border-white/10 */
      --glass:        rgba(255,255,255,0.05);
      --glass-hi:     rgba(255,255,255,0.10);
      --glass-border: rgba(255,255,255,0.10);
      --accent:       #7c6dfe;
      --accent2:      #c4b5fd;
      --accent-hover: #6b5cf0;
      --cyan:         #22d3ee;
      --correct:      #22c55e;
      --wrong:        #ef4444;
      --reveal:       #f59e0b;
      --text:         #ffffff;
      --text-muted:   #9ca3af;               /* gray-400 — ~7:1 on #050505 ✓ WCAG AA */
      --radius:       16px;
      --radius-lg:    24px;                  /* rounded-3xl */
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-font-smoothing: antialiased; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    a { color: inherit; text-decoration: none; }
    *:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
