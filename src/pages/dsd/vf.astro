---
import Base from '../../layouts/Base.astro';
import QuizEngine from '../../components/QuizEngine.astro';
import vfData from '../../data/dsd-vf.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="DSD · Verdadero/Falso" description="114 preguntas de verdadero o falso con justificación sobre Desarrollo de Sistemas Distribuidos (temas 2-5).">
  <QuizEngine
    title="Desarrollo de Sistemas Distribuidos"
    code="DSD"
    vfData={vfData}
    backHref={`${base}dsd/`}
    backLabel="DSD"
  />
</Base>
