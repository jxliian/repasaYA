---
import Base from '../../layouts/Base.astro';
import QuizEngine from '../../components/QuizEngine.astro';
import testData from '../../data/sibw.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="SIBW · Tipo Test" description="286 preguntas tipo test de Sistemas de Información Basados en Web: HTTP, SEO, UX, XML, normativa y más.">
  <QuizEngine
    title="Sistemas de Información Basados en Web"
    code="SIBW"
    testData={testData}
    backHref={`${base}sibw/`}
    backLabel="SIBW"
  />
</Base>
