---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import PageHead from '../components/catalog/PageHead.astro';
import {
  degreePath,
  materialPath,
  semesterPath,
  subjectSlug,
  subjectUrl,
  yearPath,
} from '../lib/routes';

/**
 * Mapa web.
 *
 * Se genera entero desde las colecciones: añades una asignatura y aparece
 * aquí sin tocar este archivo. Antes era una lista escrita a mano con los
 * slugs en duro, que se quedaba desfasada al primer cambio.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const subjects = await getCollection('subjects');
const degrees = await getCollection('degrees');
const materials = await getCollection('materials');

const ENGINE_TYPES = new Set(['test', 'vf', 'reveal']);

const tree = degrees
  .map((degree) => {
    const mine = subjects.filter((s) => s.data.degree.id === degree.id);

    const years = Array.from({ length: degree.data.years }, (_, i) => i + 1).map((year) => ({
      year,
      semesters: ([1, 2] as const).map((semester) => ({
        semester,
        subjects: mine
          .filter((s) => s.data.year === year && s.data.semester === semester)
          .sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'))
          .map((s) => ({
            entry: s,
            url: subjectUrl(s),
            materials: materials
              .filter((m) => m.data.subject.id === s.id && !m.data.hidden && ENGINE_TYPES.has(m.data.type))
              .sort((a, b) => a.data.order - b.data.order)
              .map((m) => ({
                title: m.data.title,
                count: 'items' in m.data ? m.data.items.length : 0,
                href: materialPath(
                  degree.id,
                  s.data.year,
                  s.data.semester,
                  subjectSlug(s),
                  m.id.split('/').pop()!
                ),
              })),
          })),
      })),
    }));

    return {
      degree,
      years,
      total: mine.length,
      ready: mine.filter((s) => s.data.status === 'available').length,
    };
  })
  .sort((a, b) => b.ready - a.ready);

const totalItems = materials.reduce(
  (n, m) => n + ('items' in m.data ? m.data.items.length : 0),
  0
);
const es = (n: number) => n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
---

<Shell
  title="Mapa web"
  description="Todas las páginas de repasaYA: grados, cursos, cuatrimestres, asignaturas y material disponible."
>
  <div class="container">
    <Breadcrumbs
      crumbs={[{ label: 'Inicio', href: base }, { label: 'Mapa web', href: null }]}
    />

    <PageHead
      kicker="Índice completo"
      title="Mapa web"
      lede="Todo lo que hay en repasaYA, de un vistazo. Esta página se genera sola a partir del contenido, así que no se queda desfasada."
      stats={[
        { value: subjects.length, label: 'asignaturas' },
        { value: materials.length, label: 'materiales' },
        { value: es(totalItems), label: 'preguntas' },
      ]}
    />

    <section class="block">
      <h2>Páginas generales</h2>
      <ul class="plain">
        <li><a href={base}>Inicio</a></li>
        <li><a href={`${base}#sobre-mi`}>Sobre mí y contacto</a></li>
        <li><a href={`${base}mapa/`} aria-current="page">Mapa web</a></li>
        <li><a href={`${base}privacidad/`}>Privacidad</a></li>
        <li>
          <a href={`${base}sitemap-index.xml`}>Sitemap XML</a>
          <span class="note">buscadores</span>
        </li>
      </ul>
    </section>

    {
      tree.map(({ degree, years, total, ready }) => (
        <section class="block">
          <h2>
            <span aria-hidden="true">{degree.data.icon}</span>
            <a href={degreePath(degree.id)}>{degree.data.name}</a>
            <span class="note">
              {ready} de {total} con material
            </span>
          </h2>

          <div class="years">
            {years.map(({ year, semesters }) => (
              <div class="year">
                <h3>
                  <a href={yearPath(degree.id, year)}>{year}º curso</a>
                </h3>

                {semesters.map(({ semester, subjects: list }) => (
                  <div class="sem">
                    <h4>
                      <a href={semesterPath(degree.id, year, semester)}>
                        Cuatrimestre {semester}
                      </a>
                    </h4>

                    {list.length === 0 ? (
                      <p class="empty">Sin asignaturas cargadas.</p>
                    ) : (
                      <ul class="subjects">
                        {list.map(({ entry, url, materials: mats }) => (
                          <li>
                            {url ? (
                              <a
                                class="subject"
                                href={url}
                                target={entry.data.external ? '_blank' : undefined}
                                rel={entry.data.external ? 'noopener' : undefined}
                              >
                                {entry.data.title}
                              </a>
                            ) : (
                              <span class="subject off">{entry.data.title}</span>
                            )}

                            {mats.length > 0 && (
                              <ul class="mats">
                                {mats.map((m) => (
                                  <li>
                                    <a href={m.href}>{m.title}</a>
                                    <span class="note">{m.count}</span>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Shell>

<style>
  .block {
    padding-block: 30px;
    border-top: 1px solid var(--glass-border);
  }
  .block h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .block h2 a:hover {
    color: var(--accent);
  }

  .note {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    white-space: nowrap;
  }

  .plain {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .plain li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
  }
  .plain a {
    color: var(--text-muted);
  }
  .plain a:hover,
  .plain [aria-current='page'] {
    color: var(--accent);
  }

  /* Cursos en columnas: 5 cursos × 2 cuatrimestres en vertical sería
     una lista interminable. */
  .years {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 28px;
  }
  .year h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 8px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--accent-line);
  }
  .sem + .sem {
    margin-top: 18px;
  }
  .sem h4 {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .sem h4 a:hover,
  .year h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .subjects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .subject {
    font-size: 0.88rem;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  a.subject:hover {
    color: var(--accent);
  }
  /* Sin material todavía: se lista igual, pero sin enlace */
  .subject.off {
    color: var(--text-dim);
    opacity: 0.7;
  }

  .mats {
    list-style: none;
    margin: 6px 0 4px 6px;
    padding-left: 13px;
    border-left: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .mats li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mats a {
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .mats a:hover {
    color: var(--accent);
  }

  .empty {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-style: italic;
  }
</style>
