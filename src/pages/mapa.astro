---
import Base from '../layouts/Base.astro';
import { subjects } from '../data/subjects';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();

const adeSlugOrder = ['economia-espanola','rrhh','organizacion-empresas','do1','aef'];
const infoSlugOrder = ['sibw','mp','dsd'];

const ade  = adeSlugOrder.map(slug => subjects.find(s => s.slug === slug)).filter(Boolean);
const info = infoSlugOrder.map(slug => subjects.find(s => s.slug === slug)).filter(Boolean);

function hasFlashcards(s: typeof subjects[0]) {
  return s.chips.some(c => c.toLowerCase().includes('flashcard'));
}
function hasQuiz(s: typeof subjects[0]) {
  return !s.external && !!s.dataFile;
}
function isHub(s: typeof subjects[0]) {
  return hasFlashcards(s) || s.type === 'both';
}
---
<Base title="Mapa web" description="Mapa web de repasaYA — todas las asignaturas y páginas disponibles.">
<style>
html, body { height: auto; overflow: visible; }

.bg-layer {
  position: fixed; inset: 0; z-index: 0;
  pointer-events: none; overflow: hidden;
}
#particles-bg { position: absolute; inset: 0; }
.orb { position: absolute; border-radius: 50%; pointer-events: none; }
.orb-tl {
  width: 600px; height: 600px; top: -15%; left: -8%;
  background: radial-gradient(circle,rgba(124,58,237,0.18) 0%,rgba(124,58,237,0.05) 50%,transparent 70%);
  filter: blur(100px);
}
.orb-br {
  width: 550px; height: 550px; bottom: -12%; right: -8%;
  background: radial-gradient(circle,rgba(6,182,212,0.13) 0%,rgba(6,182,212,0.04) 50%,transparent 70%);
  filter: blur(100px);
}

.page-hdr {
  position: sticky; top: 0; z-index: 200;
  background: rgba(5,5,5,0.80);
  backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  padding: 0 28px; height: 60px;
  display: flex; align-items: center; gap: 14px;
}
.page-logo {
  font-size: 1.2rem; font-weight: 800; letter-spacing: -1px;
  background: linear-gradient(135deg,#7c6dfe,#c4b5fd);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.back-link {
  font-size: .8rem; color: var(--text-muted);
  transition: color .2s; margin-left: auto;
}
.back-link:hover { color: var(--accent); }

main {
  position: relative; z-index: 1;
  max-width: 780px; margin: 0 auto;
  padding: 40px 24px 80px;
}

.page-title {
  font-size: clamp(1.6rem,3vw,2.2rem); font-weight: 800;
  letter-spacing: -1.2px; margin-bottom: 6px;
  background: linear-gradient(135deg,#7c6dfe,#c4b5fd,#22d3ee);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.page-subtitle { font-size: .88rem; color: var(--text-muted); margin-bottom: 32px; }

.glass {
  background: var(--glass);
  backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.50);
}

.sitemap-card { padding: 32px 36px; display: flex; flex-direction: column; gap: 28px; }

.sm-section { display: flex; flex-direction: column; gap: 12px; }
.sm-section-title {
  font-size: .65rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 1px; color: var(--text-muted);
  display: flex; align-items: center; gap: 8px;
}
.sm-section-title::after { content: ''; flex: 1; height: 1px; background: var(--glass-border); }

.sm-list { list-style: none; display: flex; flex-direction: column; gap: 3px; }
.sm-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: 12px;
  transition: background .15s;
}
.sm-item:hover { background: var(--glass); }
.sm-icon { font-size: 1rem; flex-shrink: 0; width: 24px; text-align: center; }
.sm-info { flex: 1; min-width: 0; }
.sm-name {
  font-size: .88rem; font-weight: 600; color: var(--text);
  display: flex; align-items: center; gap: 8px;
  text-decoration: none; transition: color .2s;
}
.sm-name:hover { color: var(--accent); }
.sm-sub-links {
  display: flex; gap: 8px; margin-top: 4px; flex-wrap: wrap;
}
.sm-sub-link {
  font-size: .68rem; font-weight: 600;
  background: rgba(124,109,254,0.10); border: 1px solid rgba(124,109,254,0.20);
  color: var(--accent2); border-radius: 99px; padding: 2px 10px;
  transition: background .15s;
  text-decoration: none;
}
.sm-sub-link:hover { background: rgba(124,109,254,0.20); }
.ext-badge {
  font-size: .63rem; font-weight: 700;
  background: rgba(34,211,238,0.10); border: 1px solid rgba(34,211,238,0.20);
  color: #67e8f9; border-radius: 99px; padding: 2px 9px;
}
.sm-static-link {
  font-size: .88rem; font-weight: 600; color: var(--text);
  display: flex; align-items: center; gap: 6px;
  text-decoration: none; transition: color .2s;
}
.sm-static-link:hover { color: var(--accent); }

footer {
  position: relative; z-index: 1;
  text-align: center; padding: 20px 24px 28px;
  font-size: .72rem; color: rgba(255,255,255,0.25);
  border-top: 1px solid rgba(255,255,255,0.07);
  display: flex; flex-direction: column; gap: 5px;
}
.footer-meta { font-size: .66rem; color: rgba(255,255,255,0.15); }
footer a { color: #c4b5fd; }
footer a:hover { color: #7c6dfe; }

/* Light mode */
[data-theme="light"] .page-hdr { background: rgba(244,242,255,0.92); border-bottom-color: rgba(0,0,0,0.07); }
[data-theme="light"] footer { color: rgba(30,27,75,0.38); border-top-color: rgba(0,0,0,0.07); }
[data-theme="light"] .footer-meta { color: rgba(30,27,75,0.26); }
[data-theme="light"] footer a { color: var(--accent); }
[data-theme="light"] .orb-tl {
  background: radial-gradient(circle,rgba(124,58,237,0.38) 0%,rgba(124,58,237,0.12) 50%,transparent 70%);
}
[data-theme="light"] .orb-br {
  background: radial-gradient(circle,rgba(6,182,212,0.30) 0%,rgba(6,182,212,0.09) 50%,transparent 70%);
}
</style>

<div class="bg-layer" aria-hidden="true">
  <div id="particles-bg"></div>
  <div class="orb orb-tl"></div>
  <div class="orb orb-br"></div>
</div>

<header class="page-hdr">
  <a class="page-logo" href={base}>repasaYA</a>
  <a class="back-link" href={base}>← Volver al inicio</a>
</header>

<main>
  <h1 class="page-title">Mapa web</h1>
  <p class="page-subtitle">Todas las asignaturas y páginas disponibles en repasaYA. Se actualiza automáticamente.</p>

  <div class="glass sitemap-card">

    <!-- Inicio -->
    <div class="sm-section">
      <span class="sm-section-title">Inicio</span>
      <ul class="sm-list">
        <li class="sm-item">
          <span class="sm-icon">🏠</span>
          <div class="sm-info">
            <a class="sm-name" href={base}>repasaYA — Inicio</a>
          </div>
        </li>
      </ul>
    </div>

    <!-- ADE -->
    <div class="sm-section">
      <span class="sm-section-title">📊 Administración de Empresas</span>
      <ul class="sm-list">
        {ade.map(s => (
          <li class="sm-item">
            <span class="sm-icon">{s!.icon}</span>
            <div class="sm-info">
              {s!.external
                ? <a class="sm-name" href={s!.external} target="_blank" rel="noopener">
                    {s!.title} <span class="ext-badge">↗ Externo</span>
                  </a>
                : <a class="sm-name" href={isHub(s!) ? `${base}${s!.slug}/` : `${base}${s!.slug}/`}>{s!.title}</a>
              }
              {!s!.external && (
                <div class="sm-sub-links">
                  {isHub(s!)
                    ? <a class="sm-sub-link" href={`${base}${s!.slug}/`}>Hub</a>
                    : null
                  }
                  {hasQuiz(s!) && (
                    <a class="sm-sub-link" href={isHub(s!) ? `${base}${s!.slug}/quiz/` : `${base}${s!.slug}/`}>
                      {s!.type === 'both' ? 'Test + V/F' : s!.type === 'vf' ? 'V/F' : 'Quiz'}
                    </a>
                  )}
                  {hasFlashcards(s!) && (
                    <a class="sm-sub-link" href={`${base}${s!.slug}/glosario/`}>Flashcards</a>
                  )}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Informática -->
    <div class="sm-section">
      <span class="sm-section-title">💻 Ingeniería Informática</span>
      <ul class="sm-list">
        {info.map(s => (
          <li class="sm-item">
            <span class="sm-icon">{s!.icon}</span>
            <div class="sm-info">
              <a class="sm-name" href={`${base}${s!.slug}/`}>{s!.title}</a>
              <div class="sm-sub-links">
                {isHub(s!) && <a class="sm-sub-link" href={`${base}${s!.slug}/`}>Hub</a>}
                {hasQuiz(s!) && (
                  <a class="sm-sub-link" href={isHub(s!) ? `${base}${s!.slug}/quiz/` : `${base}${s!.slug}/`}>Quiz</a>
                )}
                {hasFlashcards(s!) && (
                  <a class="sm-sub-link" href={`${base}${s!.slug}/glosario/`}>Flashcards</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Información -->
    <div class="sm-section">
      <span class="sm-section-title">📄 Información</span>
      <ul class="sm-list">
        <li class="sm-item">
          <span class="sm-icon">🔒</span>
          <div class="sm-info">
            <a class="sm-static-link" href={`${base}privacidad/`}>Política de Privacidad</a>
          </div>
        </li>
        <li class="sm-item">
          <span class="sm-icon">🗺️</span>
          <div class="sm-info">
            <a class="sm-static-link" href={`${base}mapa/`}>Mapa web <em style="font-size:.75em;opacity:.6">(esta página)</em></a>
          </div>
        </li>
        <li class="sm-item">
          <span class="sm-icon">🤖</span>
          <div class="sm-info">
            <a class="sm-static-link" href="/repasaYA/sitemap-index.xml" target="_blank" rel="noopener">
              Sitemap XML <span class="ext-badge">↗</span>
            </a>
          </div>
        </li>
      </ul>
    </div>

  </div>
</main>

<footer>
  <p>Hecho con ganas · <a href="https://github.com/jxliian" target="_blank" rel="noopener">jxliian</a></p>
  <p class="footer-meta">© {year} · Universidad de Granada · Doble Grado ADE + Informática</p>
  <p><a href={`${base}privacidad/`}>Privacidad</a> · <a href={`${base}mapa/`}>Mapa web</a></p>
</footer>
</Base>
