---
import Base from '../layouts/Base.astro';
import SubjectCarousel from '../components/SubjectCarousel.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HeroLogo3D from '../components/HeroLogo3D.astro';
import { execSync } from 'child_process';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* ── Parse git log → human-readable Novedades ── */
type Commit = { date: string; badge: string; cls: string; scope: string; text: string };
const BADGE: Record<string, Pick<Commit,'badge'|'cls'>> = {
  feat:     { badge:'Nuevo',    cls:'upd-green'  },
  fix:      { badge:'Fix',      cls:'upd-orange' },
  chore:    { badge:'Mejora',   cls:'upd-blue'   },
  docs:     { badge:'Docs',     cls:'upd-gray'   },
  style:    { badge:'UI',       cls:'upd-purple' },
  refactor: { badge:'Refactor', cls:'upd-blue'   },
  perf:     { badge:'Perf',     cls:'upd-cyan'   },
};
function humanize(raw: string): Omit<Commit,'date'> {
  const m = raw.match(/^(feat|fix|chore|docs|style|refactor|perf)\(([^)]+)\):\s*(.+)/i);
  if (!m) return { badge:'Update', cls:'upd-gray', scope:'', text:raw.slice(0,55) };
  const [,type, scope, txt] = m;
  const meta = BADGE[type.toLowerCase()] ?? { badge:'Update', cls:'upd-gray' };
  const text = txt.replace(/^(añadir|agregar|add|crear|actualizar|update|corregir)\s+/i,'');
  return { ...meta, scope:scope.toUpperCase(), text:(text[0].toUpperCase()+text.slice(1)).slice(0,55) };
}
let commits: Commit[] = [];
try {
  const raw = execSync(
    'git log --pretty=format:"%ad%x09%s" --date=format:"%d %b" -n 8',
    { encoding:'utf8', cwd:process.cwd() }
  ).trim();
  commits = raw.split('\n').filter(Boolean).map(line => {
    const [date='', ...rest] = line.split('\t');
    return { date, ...humanize(rest.join(' ')) };
  });
} catch { /* build CI */ }

const lastUpdate = commits[0]?.date ?? null;

const year = new Date().getFullYear();
const ISSUE_URL   = 'https://github.com/jxliian/repasaYA/issues/new?title=Solicitud%3A+%5BNombre%5D&body=%23%23+Datos%0A-%20**Asignatura**%3A+%0A-%20**Curso**%3A+';
const REPO_URL    = 'https://github.com/jxliian/repasaYA';
const PROFILE_URL = 'https://github.com/jxliian';
---
<Base title="repasaYA" description="Tipo test, V/F y flashcards para ADE e Informática. +1000 preguntas, +200 flashcards. Gratis.">
<style>
/* ═══════════════════════════════════════════════════════
   PAGE RESET — normal scroll
═══════════════════════════════════════════════════════ */
html, body { height: auto; overflow: visible; }

/* ═══════════════════════════════════════════════════════
   BACKGROUND LAYER
   - #particles-bg: interactive canvas (reacts to mouse)
   - Two subtle radial orbs, one per corner
   position:fixed so they show THROUGH glass during scroll
═══════════════════════════════════════════════════════ */
.bg-layer {
  position: fixed; inset: 0; z-index: 0;
  pointer-events: none; overflow: hidden;
}
/* Interactive particle canvas */
#particles-bg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

.orb {
  position: absolute; border-radius: 50%;
  pointer-events: none;
}
/* Top-left: lavanda tenue */
.orb-tl {
  width: 600px; height: 600px;
  top: -15%; left: -8%;
  background: radial-gradient(circle,
    rgba(138,107,216,0.10) 0%,
    rgba(138,107,216,0.03) 50%,
    transparent 70%);
  filter: blur(100px);
}
/* Bottom-right: lavanda muy tenue */
.orb-br {
  width: 550px; height: 550px;
  bottom: -12%; right: -8%;
  background: radial-gradient(circle,
    rgba(138,107,216,0.06) 0%,
    rgba(138,107,216,0.02) 50%,
    transparent 70%);
  filter: blur(100px);
}
:root[data-theme="dark"] .orb-tl,
:root[data-theme="dark"] .orb-br { opacity: 1.5; }

/* ═══════════════════════════════════════════════════════
   HEADER — sticky nav (claro)
═══════════════════════════════════════════════════════ */
.site-header {
  position: sticky; top: 0; z-index: 200;
  background: var(--header-bg);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(6px);
  padding: 0 28px; height: 64px;
  display: flex; align-items: center; gap: 16px;
}

.site-logo {
  font-size: 1.4rem; font-weight: 800; letter-spacing: -1.2px;
  flex-shrink: 0; display: flex; align-items: center; gap: 2px;
  color: var(--text); font-family: var(--font-display);
}
.logo-dot {
  display: inline-block; width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
  margin-bottom: 6px; margin-left: 1px;
  box-shadow: 0 0 8px rgba(138,107,216,.7);
  animation: dotPulse 2.4s ease-in-out infinite;
}
@keyframes dotPulse { 0%,100%{opacity:1} 50%{opacity:.4} }

/* Search bar — glass */
.search-wrap {
  flex: 1; max-width: 460px; min-width: 120px;
  display: flex; align-items: center; gap: 10px;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 12px; padding: 0 14px; height: 40px;
  transition: border-color .2s, box-shadow .2s; cursor: text;
}
.search-wrap:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
.search-icon { color: #9b9fb2; flex-shrink: 0; }
.search-input {
  flex: 1; background: none; border: none; outline: none;
  color: var(--text); font-size: .88rem; font-family: inherit;
}
.search-input::placeholder { color: #9b9fb2; }
.search-kbd {
  flex-shrink: 0; font-size: .64rem; font-weight: 700;
  color: var(--text-muted);
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 5px; padding: 2px 7px; font-family: inherit;
  transition: opacity .2s;
}
.search-wrap:focus-within .search-kbd { opacity: 0; }

.header-right { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

/* ── Botones del header (paleta clara) ── */
.hbtn {
  display: inline-flex; align-items: center; gap: 7px; border-radius: 999px;
  padding: 8px 14px; font-size: .82rem; font-weight: 600; white-space: nowrap;
  border: 1.5px solid transparent; transition: all .18s;
}
.hbtn:hover { transform: translateY(-1px); }
.b-ghost  { background: var(--surface); border-color: var(--border); color: var(--text); }
.b-ghost:hover { border-color: var(--accent-line); }
.b-star   { background: #fff8e8; border-color: #f0d699; color: #9a6b00; }
.b-accent { background: var(--accent); color: var(--on-accent);
  box-shadow: 0 6px 16px rgba(138,107,216,.32); }
.b-accent:hover { background: var(--accent-strong); }

.hits-pill {
  display: inline-flex; align-items: center; border-radius: 8px; overflow: hidden;
  border: 1.5px solid var(--border);
}
.hits-lbl {
  font-family: var(--font-mono); font-size: .66rem; font-weight: 700;
  letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted);
  background: var(--surface2); padding: 6px 9px;
}
.hits-num { display: block; background: var(--accent); }

/* ═══════════════════════════════════════════════════════
   HERO — a pantalla completa (aurora derivando)
═══════════════════════════════════════════════════════ */
.hero {
  position: relative; min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
  overflow: hidden; padding: 24px;
}
/* Fundido inferior → disuelve la aurora hacia la zona del carrusel */
.hero::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0;
  height: 28%; z-index: 2; pointer-events: none;
  background: linear-gradient(to bottom, transparent, var(--bg));
}
.hero-blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; z-index: 1; }
.hero-blob.b1 { width: 46%; height: 60%; left: -6%; top: -10%; background: #dcd2ff; animation: drift1 14s ease-in-out infinite; }
.hero-blob.b2 { width: 48%; height: 64%; right: -8%; top: 4%; background: #ffd9e4; animation: drift2 17s ease-in-out infinite; }
.hero-blob.b3 { width: 42%; height: 58%; left: 24%; bottom: -22%; background: #cfeede; animation: drift3 20s ease-in-out infinite; }
@keyframes drift1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(8%,6%) scale(1.12)} }
@keyframes drift2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-7%,8%) scale(1.1)} }
@keyframes drift3 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(5%,-7%) scale(1.14)} }
.hero-scroll {
  position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 4;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  color: var(--text-muted); font-family: var(--font-mono);
  font-size: 11px; letter-spacing: .22em; text-transform: uppercase;
}
.hero-scroll .chev {
  width: 18px; height: 18px;
  border-right: 2px solid var(--accent); border-bottom: 2px solid var(--accent);
  transform: rotate(45deg); animation: bob 1.5s ease-in-out infinite;
}
@keyframes bob { 0%,100%{transform:rotate(45deg) translate(0,0); opacity:.5} 50%{transform:rotate(45deg) translate(3px,3px); opacity:1} }
@media (prefers-reduced-motion: reduce){ .hero-blob,.hero-scroll .chev{ animation:none } }

.lead-tagline {
  text-align: center; max-width: 60ch; margin: 0 auto;
  color: var(--text-muted); font-size: clamp(15px,1.6vw,18px); line-height: 1.6;
}
.lead-tagline strong { color: var(--text); font-weight: 700; }

/* ═══════════════════════════════════════════════════════
   MAIN WRAPPER — z:1 keeps it above bg-layer (z:0)
═══════════════════════════════════════════════════════ */
main {
  position: relative; z-index: 1;
  max-width: 1320px; margin: 0 auto;
  padding: 28px 24px 80px;
  display: flex; flex-direction: column; gap: 20px;
}

/* ═══════════════════════════════════════════════════════
   NOVEDADES — timeline de commits (sección propia, clara)
═══════════════════════════════════════════════════════ */
.novedades {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 26px 22px;
  position: relative; overflow: hidden;
  box-shadow: 0 10px 26px rgba(70,60,120,0.06);
}
.live-dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,.8);
  animation: dotPulse 2.4s ease-in-out infinite;
}

/* ─── Commit timeline (progress bar) ─── */
.tl-hdr {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 20px;
  font-size: .67rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .9px; color: var(--text-muted);
}
.tl-since {
  margin-left: auto; font-size: .64rem; color: var(--accent);
  font-weight: 600; text-transform: none; letter-spacing: 0;
}

/* Horizontal track of commit nodes */
.tl-track {
  list-style: none;
  display: flex; align-items: flex-start;
  position: relative;
  padding: 4px 8px 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.tl-track::-webkit-scrollbar { display: none; }
/* the connecting line that runs through every node */
.tl-track::before {
  content: ''; position: absolute;
  top: 9px; left: 8px; right: 8px; height: 2px;
  background: var(--accent-line);
  border-radius: 2px;
}

.tl-item {
  position: relative; z-index: 1;
  flex: 1 1 0; min-width: 96px;
  display: flex; flex-direction: column; align-items: center;
  gap: 8px; text-align: center;
  padding: 0 4px;
}

/* Node dot on the line */
.tl-node {
  width: 14px; height: 14px; border-radius: 50%;
  border: 3px solid var(--surface);
  background: #94a3b8;
  box-shadow: 0 0 0 1px var(--border);
  transition: transform .2s, box-shadow .2s;
}
.tl-item:hover .tl-node { transform: scale(1.25); }

/* Node colors by commit type (reuse upd-* palette) */
.tl-node.upd-green  { background:#1f9d57; box-shadow:0 0 10px rgba(31,157,87,.45); }
.tl-node.upd-orange { background:#ea7a17; box-shadow:0 0 10px rgba(234,122,23,.45); }
.tl-node.upd-blue   { background:#3b82f6; box-shadow:0 0 10px rgba(59,130,246,.45); }
.tl-node.upd-purple { background:var(--accent); box-shadow:0 0 10px rgba(138,107,216,.5); }
.tl-node.upd-cyan   { background:var(--accent); box-shadow:0 0 10px rgba(138,107,216,.5); }
.tl-node.upd-gray   { background:#94a3b8; }

/* newest commit pulses */
.tl-item.is-latest .tl-node { animation: tlPulse 2s ease-in-out infinite; }
@keyframes tlPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(138,107,216,.5); }
  50%     { box-shadow: 0 0 0 7px rgba(138,107,216,0); }
}

.tl-badge {
  font-size: .58rem; font-weight: 800; border-radius: 99px;
  padding: 2px 9px; white-space: nowrap;
}
.upd-green  { background:rgba(31,157,87,.12);  color:#157f43; border:1px solid rgba(31,157,87,.25);  }
.upd-orange { background:rgba(234,122,23,.12); color:#b45309; border:1px solid rgba(234,122,23,.25); }
.upd-blue   { background:rgba(59,130,246,.12); color:#1d4ed8; border:1px solid rgba(59,130,246,.25); }
.upd-purple { background:var(--accent-soft);   color:var(--accent-strong); border:1px solid var(--accent-line); }
.upd-cyan   { background:var(--accent-soft);   color:var(--accent-strong); border:1px solid var(--accent-line); }
.upd-gray   { background:rgba(107,111,134,.10);color:#6b6f86; border:1px solid rgba(107,111,134,.20);}

.tl-date {
  font-size: .6rem; font-weight: 600; color: var(--text-muted);
  white-space: nowrap;
}
.tl-text {
  font-size: .68rem; color: var(--text-muted); line-height: 1.35;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ═══════════════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════════════ */
footer {
  position: relative; z-index: 1;
  text-align: center; padding: 22px 24px 32px;
  font-size: .74rem; color: var(--text-muted);
  border-top: 1px solid var(--border);
  display: flex; flex-direction: column; gap: 6px;
}
.footer-meta { font-size: .68rem; color: #a8acbb; }
.footer-links { font-size: .72rem; }
footer a { color: var(--accent); }
footer a:hover { color: var(--accent-strong); }

/* ═══════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════ */
@media (max-width: 700px) {
  .site-header { padding: 0 14px; gap: 10px; }
  .search-wrap { max-width: none; min-width: 0; }  /* deja que el buscador encoja: los botones no se salen */
  .search-kbd { display: none; }                   /* ⌘K no aplica en móvil */
  .header-right { gap: 8px; }
  .gh-only { display: none; }              /* Seguir, Star y Visitas fuera en móvil */
  .b-accent span { display: none; }        /* Solicitar solo icono */
  .b-accent { padding: 8px 11px; }
  main { padding: 20px 14px 60px; gap: 14px; }
  .tl-item    { min-width: 88px; }
}
</style>

<!-- ══════════════════════════════════════════════════
     BACKGROUND LAYER
     - #particles-bg ready for tsparticles/particles.js
     - 2 corner orbs (subtle, NOT vivid)
═══════════════════════════════════════════════════ -->
<div class="bg-layer" aria-hidden="true">
  <canvas id="particles-bg"></canvas>
  <div class="orb orb-tl"></div>
  <div class="orb orb-br"></div>
</div>

<!-- ══════════════════════════════════════════════════
     HEADER
═══════════════════════════════════════════════════ -->
<header class="site-header">
  <a class="site-logo" href={base} aria-label="repasaYA — Inicio">
    repasaYA<span class="logo-dot" aria-hidden="true"></span>
  </a>

  <div class="search-wrap" role="search">
    <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
    </svg>
    <input
      class="search-input" id="search-input" type="search"
      placeholder="Buscar asignatura..."
      aria-label="Buscar asignatura" autocomplete="off"
    />
    <kbd class="search-kbd" id="search-kbd" aria-hidden="true">⌘K</kbd>
  </div>

  <div class="header-right">
    <a class="hbtn b-ghost gh-only" href={PROFILE_URL} target="_blank" rel="noopener" aria-label="Seguir en GitHub">
      <svg class="gh" width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      <span>Seguir</span>
    </a>
    <a class="hbtn b-star gh-only" href={REPO_URL} target="_blank" rel="noopener" aria-label="Dar estrella en GitHub">★ <span>Star</span></a>
    <ThemeToggle />
    <a class="hbtn b-accent" href={ISSUE_URL} target="_blank" rel="noopener" aria-label="Solicitar asignatura">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <span>Solicitar</span>
    </a>
    <div class="hits-pill gh-only" aria-label="Visitas">
      <span class="hits-lbl">👁 Visitas</span>
      <img class="hits-num" src="https://hits.sh/jxliian.github.io/repasaYA.svg?style=flat-square&label=&color=8a6bd8&labelColor=8a6bd8" alt="visitas" height="20" loading="lazy" />
    </div>
  </div>
</header>

<!-- ══════════════════════════════════════════════════
     HERO — a pantalla completa
═══════════════════════════════════════════════════ -->
<section class="hero" aria-label="Bienvenida">
  <div class="hero-blob b1"></div><div class="hero-blob b2"></div><div class="hero-blob b3"></div>
  <HeroLogo3D />
  <a class="hero-scroll" href="#carrusel" aria-label="Bajar a las asignaturas">baja<span class="chev" aria-hidden="true"></span></a>
</section>

<!-- ══════════════════════════════════════════════════
     MAIN
═══════════════════════════════════════════════════ -->
<main>

  <!-- ─── CARRUSEL DUAL DE ASIGNATURAS ────────────── -->
  <p class="lead-tagline">Tests interactivos, V/F y flashcards para las asignaturas de la carrera. <strong>Gratis, sin registro, sin anuncios.</strong></p>
  <SubjectCarousel />

  <!-- ─── NOVEDADES (timeline de commits) ──────────── -->
  <section class="novedades" aria-label="Novedades recientes">
    <div class="tl-hdr">
      <span class="live-dot" aria-hidden="true"></span>
      Novedades
      {lastUpdate && <span class="tl-since">Actualizado · {lastUpdate}</span>}
    </div>
    {commits.length > 0 ? (
      <ol class="tl-track">
        {[...commits].reverse().map((c, i, arr) => (
          <li class={`tl-item${i === arr.length - 1 ? ' is-latest' : ''}`} title={c.text}>
            <span class={`tl-node ${c.cls}`} aria-hidden="true"></span>
            <span class={`tl-badge ${c.cls}`}>{c.badge}</span>
            <time class="tl-date">{c.date}</time>
            <span class="tl-text">{c.text}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p style="color:var(--text-muted);font-size:.82rem">Sin historial disponible.</p>
    )}
  </section>

</main>

<footer>
  <p>Hecho con ganas · <a href={PROFILE_URL} target="_blank" rel="noopener">jxliian</a> · <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a></p>
  <p class="footer-meta">© {year} · Universidad de Granada · Doble Grado ADE + Informática</p>
  <p class="footer-links"><a href={`${base}privacidad/`}>Privacidad</a> · <a href={`${base}mapa/`}>Mapa web</a></p>
</footer>

<!-- ══════════════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════════════ -->
<script>
  /* Detect platform → ⌘K vs Ctrl K */
  const kbd = document.getElementById('search-kbd');
  if (kbd) kbd.textContent = /Mac|iPhone|iPod|iPad/.test(navigator.platform) ? '⌘K' : 'Ctrl K';

  /* Cmd/Ctrl+K → focus search; Escape → limpiar (el carrusel reacciona al input) */
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault(); input?.focus(); input?.select();
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input?.blur();
      if (input) { input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true })); }
    }
  });
</script>

<!-- ══════════════════════════════════════════════════
     INTERACTIVE PARTICLE BACKGROUND
     Vanilla canvas — floating nodes connected by lines,
     reacting to the mouse (connect + gentle attraction).
═══════════════════════════════════════════════════ -->
<script>
  interface P { x:number; y:number; vx:number; vy:number; r:number; }

  function initParticles() {
    const canvas = document.getElementById('particles-bg') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Tear down any previous instance (View Transitions re-init)
    const prev = (window as any).__particles;
    if (prev) { cancelAnimationFrame(prev.raf); prev.cleanup(); }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let pRGB = getComputedStyle(document.documentElement).getPropertyValue('--particle').trim() || '60,52,110';
    const onTheme = () => { pRGB = getComputedStyle(document.documentElement).getPropertyValue('--particle').trim() || pRGB; };
    window.addEventListener('themechange', onTheme);

    let w = 0, h = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let particles: P[] = [];
    const mouse = { x: -9999, y: -9999, active: false };

    const LINK_DIST = 130;       // px between particles to draw a link
    const MOUSE_DIST = 180;      // px around cursor that affects particles

    function resize() {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width  = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      canvas!.style.width  = w + 'px';
      canvas!.style.height = h + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Density scales with viewport area (capped)
      const count = Math.min(110, Math.floor((w * h) / 16000));
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          r: Math.random() * 1.6 + 0.8,
        });
      }
    }

    function step() {
      ctx!.clearRect(0, 0, w, h);

      for (const p of particles) {
        // Mouse attraction (subtle pull toward cursor)
        if (mouse.active) {
          const dx = mouse.x - p.x, dy = mouse.y - p.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < MOUSE_DIST * MOUSE_DIST && d2 > 1) {
            const d = Math.sqrt(d2);
            const force = (1 - d / MOUSE_DIST) * 0.6;
            p.vx += (dx / d) * force * 0.05;
            p.vy += (dy / d) * force * 0.05;
          }
        }

        // Move + damping
        p.x += p.vx; p.y += p.vy;
        p.vx *= 0.99; p.vy *= 0.99;

        // Wrap around edges
        if (p.x < -10) p.x = w + 10; else if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10; else if (p.y > h + 10) p.y = -10;

        // Draw node
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${pRGB},0.5)`;
        ctx!.fill();
      }

      // Links between nearby particles
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK_DIST * LINK_DIST) {
            const alpha = (1 - Math.sqrt(d2) / LINK_DIST) * 0.22;
            ctx!.strokeStyle = `rgba(${pRGB},${alpha})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
      }

      // Links from cursor to nearby particles (cyan highlight)
      if (mouse.active) {
        for (const p of particles) {
          const dx = mouse.x - p.x, dy = mouse.y - p.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < MOUSE_DIST * MOUSE_DIST) {
            const alpha = (1 - Math.sqrt(d2) / MOUSE_DIST) * 0.45;
            ctx!.strokeStyle = `rgba(${pRGB},${Math.min(alpha * 1.6, 0.6)})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath();
            ctx!.moveTo(mouse.x, mouse.y);
            ctx!.lineTo(p.x, p.y);
            ctx!.stroke();
          }
        }
      }

      state.raf = requestAnimationFrame(step);
    }

    function onMove(e: PointerEvent) { mouse.x = e.clientX; mouse.y = e.clientY; mouse.active = true; }
    function onLeave() { mouse.active = false; mouse.x = -9999; mouse.y = -9999; }

    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerout', onLeave);

    const state: any = {
      raf: 0,
      cleanup() {
        window.removeEventListener('resize', resize);
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerout', onLeave);
        window.removeEventListener('themechange', onTheme);
      },
    };
    (window as any).__particles = state;

    resize();
    if (reduce) {
      // Static frame for users who prefer reduced motion
      step();
      cancelAnimationFrame(state.raf);
    } else {
      step();
    }
  }

  initParticles();
  document.addEventListener('astro:after-swap', initParticles);
</script>
</Base>
