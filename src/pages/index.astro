<!-- ══════════════════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════════════════ -->
<script>
  /* Detect platform → ⌘K vs Ctrl K */
  const kbd = document.getElementById('search-kbd');
  if (kbd) kbd.textContent = /Mac|iPhone|iPod|iPad/.test(navigator.platform) ? '⌘K' : 'Ctrl K';

  /* Cmd/Ctrl+K → focus search */
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault(); input?.focus(); input?.select();
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input?.blur(); if (input) input.value = ''; applyFilters();
    }
  });

  /* Filter state */
  let activeDeg   = '';
  let activeMtype = '';

  function applyFilters() {
    const q = input?.value.toLowerCase().trim() ?? '';
    let visible = 0;

    document.querySelectorAll<HTMLElement>('[data-slug]').forEach(card => {
      let show = true;
      if (q && !(card.dataset.title ?? '').includes(q)) show = false;
      if (activeDeg   && card.dataset.degree !== activeDeg) show = false;
      if (activeMtype === 'test'
        && !['test','both'].includes(card.dataset.type ?? '')) show = false;
      if (activeMtype === 'vf'
        && !['vf','both'].includes(card.dataset.type ?? '')) show = false;
      if (activeMtype === 'flashcards' && card.dataset.flashcards !== '1') show = false;

      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    document.querySelectorAll<HTMLElement>('[data-section]').forEach(sec => {
      const any = [...sec.querySelectorAll<HTMLElement>('[data-slug]')]
        .some(c => c.style.display !== 'none');
      sec.style.display = any ? '' : 'none';
    });

    const nr = document.getElementById('no-results') as HTMLElement | null;
    const nq = document.getElementById('no-q') as HTMLElement | null;
    if (nr) {
      if (visible === 0) { nr.removeAttribute('hidden'); if (nq) nq.textContent = q || '(filtro)'; }
      else { nr.setAttribute('hidden',''); }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-degree]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeDeg = btn.dataset.degree ?? '';
      document.querySelectorAll<HTMLButtonElement>('[data-degree]').forEach(b => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-mtype]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeMtype = btn.dataset.mtype ?? '';
      document.querySelectorAll<HTMLButtonElement>('[data-mtype]').forEach(b => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  input?.addEventListener('input', applyFilters);
  document.addEventListener('astro:after-swap', applyFilters);
</script>
