  .b-hero .live-pill,
  .b-hero .hero-h1,
  .b-hero .hero-desc,
  .b-hero .stats-row,
  .b-hero .hero-actions { max-width: none; }
  /* En móvil: canvas en flujo, debajo del texto */
  .hero-art { position: static; width: 100%; max-width: 360px; height: 300px; margin: 12px auto 0; }
  .tl-item    { min-width: 88px; }
