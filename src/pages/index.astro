  .b-hero .hero-h1,
  .b-hero .hero-desc,
  .b-hero .stats-row,
  .b-hero .hero-actions { max-width: calc(100% - 400px); }
}
@media (max-width: 700px) {
  .site-header { padding: 0 16px; }
  .search-wrap { max-width: none; }
  .btn-neon span { display: none; }
  .btn-neon { padding: 7px 11px; }
  main { padding: 20px 14px 60px; gap: 14px; }
