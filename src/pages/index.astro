---
import Base from '../layouts/Base.astro';
import SubjectCard from '../components/SubjectCard.astro';
import { subjects } from '../data/subjects';
import { execSync } from 'child_process';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const adeSubjects  = subjects.filter(s =>
  ['economia-espanola','rrhh','organizacion-empresas','do1','aef'].includes(s.slug));
const infoSubjects = subjects.filter(s =>
  ['sibw','mp','dsd'].includes(s.slug));

/* ── Parse git commits → human-readable Novedades ── */
type Commit = { date: string; badge: string; cls: string; scope: string; text: string };
const BADGE: Record<string, Pick<Commit,'badge'|'cls'>> = {
  feat:     { badge:'Nuevo',       cls:'badge-green'  },
  fix:      { badge:'Fix',         cls:'badge-orange' },
  chore:    { badge:'Mejora',      cls:'badge-blue'   },
  docs:     { badge:'Docs',        cls:'badge-gray'   },
  style:    { badge:'UI',          cls:'badge-purple' },
  refactor: { badge:'Refactor',    cls:'badge-blue'   },
  perf:     { badge:'Perf',        cls:'badge-cyan'   },
};
function humanize(raw: string): Omit<Commit,'date'> {
  const m = raw.match(/^(feat|fix|chore|docs|style|refactor|perf)\(([^)]+)\):\s*(.+)/i);
  if (!m) return { badge:'Update', cls:'badge-gray', scope:'', text: raw.slice(0,55) };
  const [,type, scope, txt] = m;
  const meta = BADGE[type.toLowerCase()] ?? { badge:'Update', cls:'badge-gray' };
  const text = txt.replace(/^(añadir|agregar|add|crear|actualizar|update|corregir)\s+/i,'');
  return { ...meta, scope: scope.toUpperCase(), text: (text[0].toUpperCase()+text.slice(1)).slice(0,55) };
}

let commits: Commit[] = [];
try {
  const raw = execSync(
    'git log --pretty=format:"%ad%x09%s" --date=format:"%d %b" -n 7',
    { encoding:'utf8', cwd:process.cwd() }
  ).trim();
  commits = raw.split('\n').filter(Boolean).map(line => {
    const [date='', ...rest] = line.split('\t');
    return { date, ...humanize(rest.join(' ')) };
  });
} catch { /* build CI no git */ }

const lastUpdate  = commits[0]?.date ?? null;
const totalFlash  = 128 + 40 + 63;
const ISSUE_URL   = 'https://github.com/jxliian/repasaYA/issues/new?title=Solicitud%3A+%5BNombre%5D&body=%23%23+Datos%0A-%20**Asignatura**%3A+%0A-%20**Curso**%3A+';
const REPO_URL    = 'https://github.com/jxliian/repasaYA';
const PROFILE_URL = 'https://github.com/jxliian';
const WA_URL      = 'https://wa.me/?text=%F0%9F%93%9A+*repasaYA*+%E2%80%94+Tests+y+flashcards+para+la+carrera.+Gratis+%E2%86%92+https%3A%2F%2Fjxliian.github.io%2FrepasaYA%2F';
---
<Base title="repasaYA" description="Tipo test, V/F y flashcards para ADE e Informática. +1000 preguntas, +200 flashcards. Gratis, sin registro.">

<style>
  /* ═══════════════════════════════════════════════════════
     RESET — this page scrolls normally
  ════════════════════════════════════════════════════════ */
  html,body { height:auto; overflow:visible; }

  /* ═══════════════════════════════════════════════════════
     ORB LAYER — position:fixed so they show through glass
     during scroll. filter:blur() is the CRITICAL part.
  ════════════════════════════════════════════════════════ */
  .orb-layer {
    position: fixed; inset: 0;
    pointer-events: none; z-index: 0; overflow: hidden;
  }
  .orb {
    position: absolute; border-radius: 50%;
    /* filter:blur() makes them soft light sources */
  }
  /* Primary — vivid purple, top-left */
  .orb-1 {
    width: 900px; height: 900px;
    top: -350px; left: -300px;
    background: radial-gradient(closest-side,
      rgba(124,58,237,0.75) 0%,
      rgba(124,58,237,0.30) 45%,
      transparent 100%);
    filter: blur(90px);
    animation: orbPulse 22s ease-in-out infinite alternate;
  }
  /* Secondary — electric cyan, bottom-right */
  .orb-2 {
    width: 700px; height: 700px;
    bottom: -250px; right: -200px;
    background: radial-gradient(closest-side,
      rgba(6,182,212,0.55) 0%,
      rgba(6,182,212,0.18) 45%,
      transparent 100%);
    filter: blur(80px);
    animation: orbPulse 28s ease-in-out infinite alternate-reverse;
  }
  /* Accent — indigo, mid-right, subtle */
  .orb-3 {
    width: 500px; height: 500px;
    top: 38%; right: 5%;
    background: radial-gradient(closest-side,
      rgba(79,70,229,0.40) 0%,
      rgba(79,70,229,0.10) 50%,
      transparent 100%);
    filter: blur(70px);
    animation: orbPulse 18s ease-in-out infinite alternate;
  }
  @keyframes orbPulse {
    from { transform: scale(1)   translate(0,0); }
    to   { transform: scale(1.1) translate(30px,20px); }
  }

  /* ═══════════════════════════════════════════════════════
     GLASSMORPHISM BASE — used on every UI surface
  ════════════════════════════════════════════════════════ */
  .glass {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    border: 1px solid rgba(255,255,255,0.09);
    box-shadow:
      0 8px 40px rgba(0,0,0,0.45),
      inset 0 1px 0 rgba(255,255,255,0.06);
  }

  /* ═══════════════════════════════════════════════════════
     HEADER — sticky glass nav
  ════════════════════════════════════════════════════════ */
  .site-header {
    position: sticky; top: 0; z-index: 200;
    background: rgba(2,2,26,0.75);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    padding: 0 28px; height: 62px;
    display: flex; align-items: center; gap: 16px;
  }

  /* Logo */
  .site-logo {
    font-size: 1.4rem; font-weight: 800; letter-spacing: -1.2px;
    flex-shrink: 0; display: flex; align-items: center; gap: 3px;
    background: linear-gradient(135deg,#7c6dfe,#c4b5fd);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .logo-dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: #7c6dfe; flex-shrink: 0; margin-bottom: 6px;
    -webkit-text-fill-color: initial;
    box-shadow: 0 0 10px rgba(124,109,254,.9);
    animation: dotPulse 2.4s ease-in-out infinite;
  }
  @keyframes dotPulse { 0%,100%{opacity:1;box-shadow:0 0 10px rgba(124,109,254,.9)} 50%{opacity:.5;box-shadow:0 0 4px rgba(124,109,254,.4)} }

  /* Search — glassmorphism input */
  .search-wrap {
    flex: 1; max-width: 460px; min-width: 120px;
    display: flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 12px; padding: 0 14px; height: 38px;
    transition: border-color .2s, box-shadow .2s; cursor: text;
  }
  .search-wrap:focus-within {
    border-color: rgba(124,109,254,.5);
    box-shadow: 0 0 0 3px rgba(124,109,254,.12);
  }
  .search-icon { color: var(--text-muted); flex-shrink: 0; }
  .search-input {
    flex: 1; background: none; border: none; outline: none;
    color: var(--text); font-size: .88rem; font-family: inherit;
  }
  .search-input::placeholder { color: var(--text-muted); }
  .search-kbd {
    flex-shrink: 0; font-size: .64rem; font-weight: 700;
    color: var(--text-muted); background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 5px;
    padding: 2px 7px; font-family: inherit; letter-spacing: .3px;
    transition: opacity .2s;
  }
  .search-wrap:focus-within .search-kbd { opacity: 0; }

  .header-right { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .hdr-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(124,109,254,.08); border: 1px solid rgba(124,109,254,.22);
    border-radius: 99px; padding: 7px 16px;
    color: var(--accent2); font-size: .78rem; font-weight: 700;
    transition: all .2s; white-space: nowrap;
  }
  .hdr-btn:hover { background: rgba(124,109,254,.18); border-color: var(--accent); }
  .hits-pill {
    display: flex; align-items: center; height: 30px; overflow: hidden;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.09);
    border-radius: 99px; padding: 0 10px;
  }
  .hits-pill img { display: block; }

  /* ═══════════════════════════════════════════════════════
     MAIN WRAPPER
  ════════════════════════════════════════════════════════ */
  main {
    position: relative; z-index: 1;
    max-width: 1320px; margin: 0 auto;
    padding: 28px 24px 80px;
    display: flex; flex-direction: column; gap: 16px;
  }

  /* ═══════════════════════════════════════════════════════
     BENTO GRID — 12-column CSS grid (the core of the layout)
  ════════════════════════════════════════════════════════ */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
    align-items: start;
  }

  /* ── Hero: 8 cols ── */
  .bento-hero {
    grid-column: span 8;
    border-radius: var(--radius-lg);
    padding: 40px 44px;
    min-height: 320px;
    display: flex; flex-direction: column; gap: 0;
    position: relative; overflow: hidden;
    /* extra inner purple tint for depth */
    background:
      radial-gradient(ellipse at 5% 10%, rgba(124,58,237,0.10) 0%, transparent 55%),
      rgba(255,255,255,0.04);
  }

  /* Live badge */
  .live-pill {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(34,197,94,.10); border: 1px solid rgba(34,197,94,.22);
    border-radius: 99px; padding: 5px 14px; width: fit-content;
    font-size: .72rem; font-weight: 700; color: #4ade80; margin-bottom: 22px;
  }
  .live-dot {
    width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
    background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,.8);
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  /* Hero headline */
  .hero-h1 {
    font-size: clamp(2rem,3.2vw,3rem);
    font-weight: 800; letter-spacing: -1.8px; line-height: 1.1;
    margin-bottom: 16px;
  }
  .hero-grad {
    background: linear-gradient(135deg,#7c6dfe 0%,#c4b5fd 50%,#22d3ee 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-desc {
    font-size: .95rem; color: var(--text-muted); line-height: 1.65;
    max-width: 500px; margin-bottom: 28px;
  }

  /* Stats row — gradient numbers */
  .stats-row {
    display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px;
  }
  .stat-chip {
    display: flex; flex-direction: column; gap: 2px;
    padding: 12px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08); border-radius: 14px;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  /* THE GRADIENT NUMBERS the brief asks for */
  .stat-n {
    font-size: 1.9rem; font-weight: 800; letter-spacing: -1px; line-height: 1;
    background: linear-gradient(135deg,#a78bfa 0%,#67e8f9 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-l {
    font-size: .62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .8px; color: var(--text-muted);
  }

  /* Hero actions */
  .hero-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .wa-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(37,211,102,.07); border: 1px solid rgba(37,211,102,.22);
    border-radius: 99px; padding: 9px 20px;
    color: #4ade80; font-size: .82rem; font-weight: 700; transition: all .2s;
  }
  .wa-btn:hover { background: rgba(37,211,102,.16); transform: translateY(-1px); }

  /* ── Changelog: 4 cols, 2 rows tall ── */
  .bento-changelog {
    grid-column: span 4;
    grid-row: span 2;
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column;
    min-height: 360px;
    position: relative; overflow: hidden;
  }
  .clog-hdr {
    display: flex; align-items: center; gap: 8px;
    padding: 16px 20px; border-bottom: 1px solid rgba(255,255,255,0.07);
    font-size: .67rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .9px; color: var(--text-muted);
    position: relative; z-index: 2; flex-shrink: 0;
  }
  .clog-since {
    margin-left: auto; font-size: .64rem; color: var(--accent2);
    font-weight: 600; text-transform: none; letter-spacing: 0;
  }
  .clog-list { list-style: none; flex: 1; overflow: hidden; position: relative; z-index: 2; }
  .clog-item {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center; gap: 7px;
    padding: 10px 18px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: background .15s;
  }
  .clog-item:last-child { border-bottom: none; }
  .clog-item:hover { background: rgba(255,255,255,0.04); }
  /* Novedades badges */
  .nbadge {
    font-size: .58rem; font-weight: 800; border-radius: 99px;
    padding: 2px 8px; white-space: nowrap; flex-shrink: 0; letter-spacing: .2px;
  }
  .badge-green  { background:rgba(34,197,94,.15); color:#4ade80; border:1px solid rgba(34,197,94,.25); }
  .badge-orange { background:rgba(249,115,22,.15); color:#fb923c; border:1px solid rgba(249,115,22,.25); }
  .badge-blue   { background:rgba(59,130,246,.15); color:#93c5fd; border:1px solid rgba(59,130,246,.25); }
  .badge-purple { background:rgba(168,85,247,.15); color:#d8b4fe; border:1px solid rgba(168,85,247,.25); }
  .badge-cyan   { background:rgba(34,211,238,.12); color:#67e8f9; border:1px solid rgba(34,211,238,.2); }
  .badge-gray   { background:rgba(148,163,184,.10); color:#94a3b8; border:1px solid rgba(148,163,184,.18); }
  .clog-scope {
    font-size: .6rem; font-weight: 800; color: var(--accent2);
    background: rgba(124,109,254,.1); border: 1px solid rgba(124,109,254,.2);
    border-radius: 4px; padding: 1px 6px; font-family:'Courier New',monospace;
    white-space: nowrap; flex-shrink: 0;
  }
  .clog-text {
    font-size: .77rem; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .clog-date { font-size: .6rem; color: var(--text-muted); white-space: nowrap; flex-shrink: 0; }

  /* ── CTA cards: 4 cols each, sit below hero (row 2) ── */
  .bento-cta {
    grid-column: span 4;
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    display: flex; flex-direction: column; gap: 8px;
    position: relative; overflow: hidden;
    color: var(--text);
    transition: transform .22s, border-color .22s, box-shadow .22s, background .22s;
    --mx: 50%; --my: 50%;
  }
  /* CTA spotlight (same --mx/--my mechanism as cards) */
  .bento-cta::after {
    content:''; position:absolute; inset:0;
    background: radial-gradient(200px circle at var(--mx) var(--my),
      rgba(168,85,247,0.12), transparent 70%);
    opacity:0; transition:opacity .35s; pointer-events:none;
  }
  .bento-cta:hover { transform: translateY(-4px); }
  .bento-cta:hover::after { opacity:1; }

  /* CTA variants */
  .bento-cta.cta-gh:hover   { border-color:rgba(255,255,255,0.22); box-shadow:0 12px 40px rgba(0,0,0,.5); }
  .bento-cta.cta-star:hover { border-color:rgba(250,204,21,0.40);  box-shadow:0 12px 40px rgba(0,0,0,.5),0 0 30px rgba(250,204,21,.08); }
  /* star card — subtle amber tint */
  .bento-cta.cta-star {
    background: linear-gradient(135deg,rgba(251,191,36,.04),rgba(255,255,255,.04));
  }
  .bento-cta.cta-gh {
    background: linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.03));
  }

  .cta-kicker {
    font-size: .65rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .8px; color: var(--text-muted); position: relative; z-index: 2;
  }
  .cta-title {
    font-size: 1.05rem; font-weight: 800; position: relative; z-index: 2; line-height: 1.2;
  }
  .cta-hint {
    font-size: .78rem; color: var(--text-muted); position: relative; z-index: 2; margin-top: 4px;
  }
  .cta-icon-bg {
    position: absolute; right: 20px; top: 50%; transform: translateY(-50%);
    font-size: 2.4rem; opacity: .12; z-index: 0; transition: opacity .22s;
    pointer-events: none; line-height: 1;
  }
  .bento-cta:hover .cta-icon-bg { opacity: .22; }

  /* Arrow chip on CTA */
  .cta-arrow {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: .7rem; font-weight: 700; color: var(--accent2);
    background: rgba(124,109,254,.1); border: 1px solid rgba(124,109,254,.2);
    border-radius: 99px; padding: 3px 10px; width: fit-content;
    position: relative; z-index: 2; margin-top: auto;
    transition: background .2s, border-color .2s;
  }
  .bento-cta:hover .cta-arrow {
    background: rgba(124,109,254,.2); border-color: rgba(124,109,254,.4);
  }
  .cta-star .cta-arrow { color:#fde68a; background:rgba(251,191,36,.1); border-color:rgba(251,191,36,.25); }
  .cta-star:hover .cta-arrow { background:rgba(251,191,36,.2); }

  /* ═══════════════════════════════════════════════════════
     FILTER BAR — glassmorphism pill row
  ════════════════════════════════════════════════════════ */
  .filter-bar {
    display: flex; align-items: center; gap: 20px;
    padding: 14px 22px; border-radius: var(--radius-lg);
    flex-wrap: wrap;
  }
  .fgroup { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .fgroup-label {
    font-size: .66rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .8px; color: var(--text-muted); white-space: nowrap;
    padding-right: 6px; border-right: 1px solid rgba(255,255,255,0.07);
  }
  .fchips { display: flex; gap: 6px; flex-wrap: wrap; }
  .fchip {
    font-size: .77rem; font-weight: 600; border-radius: 99px;
    padding: 5px 14px;
    background: transparent; border: 1px solid rgba(255,255,255,0.09);
    color: var(--text-muted); cursor: pointer; transition: all .18s;
    font-family: inherit;
  }
  .fchip:hover:not(.on) { border-color:rgba(124,109,254,.4); color:var(--accent2); }
  .fchip.on {
    background: rgba(124,109,254,.18); border-color: rgba(124,109,254,.5);
    color: var(--accent2);
  }

  /* ═══════════════════════════════════════════════════════
     SUBJECT SECTIONS
  ════════════════════════════════════════════════════════ */
  .subject-section { display: flex; flex-direction: column; gap: 14px; }
  .section-label {
    display: flex; align-items: center; gap: 10px;
    font-size: .7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1.1px; color: var(--text-muted); padding: 0 4px;
  }
  .section-label::after {
    content:''; flex:1; height:1px; background:rgba(255,255,255,0.07);
  }
  .subject-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 14px;
  }

  /* No results */
  .no-results {
    text-align: center; padding: 48px 24px;
    color: var(--text-muted); font-size: .9rem;
  }
  .no-results[hidden] { display: none; }

  /* ═══════════════════════════════════════════════════════
     FOOTER
  ════════════════════════════════════════════════════════ */
  footer {
    position: relative; z-index: 1;
    text-align: center; padding: 22px 24px;
    font-size: .74rem; color: var(--text-muted);
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  footer a { color: var(--accent2); }
  footer a:hover { color: var(--accent); }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE
     1100px → two-col bento (hero full, changelog full, cta halves)
      680px → single column
  ════════════════════════════════════════════════════════ */
  @media (max-width:1100px) {
    .bento { grid-template-columns:repeat(6,1fr); }
    .bento-hero      { grid-column:span 6; }
    .bento-changelog { grid-column:span 6; grid-row:span 1; }
    .bento-cta       { grid-column:span 3; }
  }
  @media (max-width:700px) {
    .site-header { padding:0 16px; gap:10px; }
    .search-wrap  { max-width:none; }
    .hdr-btn span { display:none; }
    .hdr-btn      { padding:7px 11px; }
    main          { padding:20px 14px 60px; }
    .bento { grid-template-columns:1fr; }
    .bento-hero,.bento-changelog,.bento-cta { grid-column:span 1; grid-row:span 1; }
    .bento-hero { padding:28px 22px; min-height:auto; }
    .stats-row  { gap:6px; }
    .stat-chip  { padding:10px 14px; }
    .stat-n     { font-size:1.5rem; }
    .filter-bar { gap:12px; }
    .subject-grid { grid-template-columns:1fr; }
  }
  @media (max-width:420px) {
    .bento-cta { padding:20px 20px; }
    .hits-pill  { display:none; }
  }
</style>

<!-- ══════════════════════════════════════════════
     ORB BACKGROUND — these are the light sources
     that make backdrop-filter:blur() look real
═══════════════════════════════════════════════ -->
<div class="orb-layer" aria-hidden="true">
