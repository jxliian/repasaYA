---
import Base from '../layouts/Base.astro';
import SubjectCarousel from '../components/SubjectCarousel.astro';
import { execSync } from 'child_process';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* ── Parse git log → human-readable Novedades ── */
type Commit = { date: string; badge: string; cls: string; scope: string; text: string };
const BADGE: Record<string, Pick<Commit,'badge'|'cls'>> = {
  feat:     { badge:'Nuevo',    cls:'upd-green'  },
  fix:      { badge:'Fix',      cls:'upd-orange' },
  chore:    { badge:'Mejora',   cls:'upd-blue'   },
  docs:     { badge:'Docs',     cls:'upd-gray'   },
  style:    { badge:'UI',       cls:'upd-purple' },
  refactor: { badge:'Refactor', cls:'upd-blue'   },
  perf:     { badge:'Perf',     cls:'upd-cyan'   },
};
function humanize(raw: string): Omit<Commit,'date'> {
  const m = raw.match(/^(feat|fix|chore|docs|style|refactor|perf)\(([^)]+)\):\s*(.+)/i);
  if (!m) return { badge:'Update', cls:'upd-gray', scope:'', text:raw.slice(0,55) };
  const [,type, scope, txt] = m;
  const meta = BADGE[type.toLowerCase()] ?? { badge:'Update', cls:'upd-gray' };
  const text = txt.replace(/^(añadir|agregar|add|crear|actualizar|update|corregir)\s+/i,'');
  return { ...meta, scope:scope.toUpperCase(), text:(text[0].toUpperCase()+text.slice(1)).slice(0,55) };
}
let commits: Commit[] = [];
try {
  const raw = execSync(
    'git log --pretty=format:"%ad%x09%s" --date=format:"%d %b" -n 8',
    { encoding:'utf8', cwd:process.cwd() }
  ).trim();
  commits = raw.split('\n').filter(Boolean).map(line => {
    const [date='', ...rest] = line.split('\t');
    return { date, ...humanize(rest.join(' ')) };
  });
} catch { /* build CI */ }

const lastUpdate = commits[0]?.date ?? null;

const year = new Date().getFullYear();
const ISSUE_URL   = 'https://github.com/jxliian/repasaYA/issues/new?title=Solicitud%3A+%5BNombre%5D&body=%23%23+Datos%0A-%20**Asignatura**%3A+%0A-%20**Curso**%3A+';
const REPO_URL    = 'https://github.com/jxliian/repasaYA';
const PROFILE_URL = 'https://github.com/jxliian';
---
<Base title="repasaYA" description="Tipo test, V/F y flashcards para ADE e Informática. +1000 preguntas, +200 flashcards. Gratis.">
<style>
/* ═══════════════════════════════════════════════════════
   PAGE RESET — normal scroll
═══════════════════════════════════════════════════════ */
html, body { height: auto; overflow: visible; }

/* ═══════════════════════════════════════════════════════
   BACKGROUND LAYER
   - #particles-bg: interactive canvas (reacts to mouse)
   - Two subtle radial orbs, one per corner
   position:fixed so they show THROUGH glass during scroll
═══════════════════════════════════════════════════════ */
.bg-layer {
  position: fixed; inset: 0; z-index: 0;
  pointer-events: none; overflow: hidden;
}
/* Interactive particle canvas */
#particles-bg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

.orb {
  position: absolute; border-radius: 50%;
  pointer-events: none;
}
/* Top-left: lavanda tenue */
.orb-tl {
  width: 600px; height: 600px;
  top: -15%; left: -8%;
  background: radial-gradient(circle,
    rgba(138,107,216,0.10) 0%,
    rgba(138,107,216,0.03) 50%,
    transparent 70%);
  filter: blur(100px);
}
/* Bottom-right: lavanda muy tenue */
.orb-br {
  width: 550px; height: 550px;
  bottom: -12%; right: -8%;
  background: radial-gradient(circle,
    rgba(138,107,216,0.06) 0%,
    rgba(138,107,216,0.02) 50%,
    transparent 70%);
  filter: blur(100px);
}

/* ═══════════════════════════════════════════════════════
   GLASSMORPHISM UTILITY
   EXACT Tailwind equivalents requested:
     bg-white/5       → rgba(255,255,255,0.05)
     backdrop-blur-xl → blur(24px)
     border-white/10  → rgba(255,255,255,0.10)
     rounded-3xl      → 24px
     shadow-2xl       → 0 25px 50px -12px rgba(0,0,0,0.5)
═══════════════════════════════════════════════════════ */
.glass {
  background:           var(--surface);
  border:               1px solid var(--glass-border);
  border-radius:        24px;
  box-shadow:           0 25px 50px -12px rgba(0,0,0,0.50);
}

/* ═══════════════════════════════════════════════════════
   HEADER — sticky glass nav
═══════════════════════════════════════════════════════ */
.site-header {
  position: sticky; top: 0; z-index: 200;
  background: var(--header-bg);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(6px);
  padding: 0 28px; height: 64px;
  display: flex; align-items: center; gap: 16px;
}

.site-logo {
  font-size: 1.4rem; font-weight: 800; letter-spacing: -1.2px;
  flex-shrink: 0; display: flex; align-items: center; gap: 2px;
  color: var(--text); font-family: var(--font-display);
}
.logo-dot {
  display: inline-block; width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
  margin-bottom: 6px; margin-left: 1px;
  box-shadow: 0 0 8px rgba(138,107,216,.7);
  animation: dotPulse 2.4s ease-in-out infinite;
}
@keyframes dotPulse { 0%,100%{opacity:1} 50%{opacity:.4} }

/* Search bar — glass */
.search-wrap {
  flex: 1; max-width: 460px; min-width: 120px;
  display: flex; align-items: center; gap: 10px;
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 12px; padding: 0 14px; height: 40px;
  transition: border-color .2s, box-shadow .2s; cursor: text;
}
.search-wrap:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
.search-icon { color: #9b9fb2; flex-shrink: 0; }
.search-input {
  flex: 1; background: none; border: none; outline: none;
  color: var(--text); font-size: .88rem; font-family: inherit;
}
.search-input::placeholder { color: #9b9fb2; }
.search-kbd {
  flex-shrink: 0; font-size: .64rem; font-weight: 700;
  color: var(--text-muted);
  background: #f0f0f6; border: 1px solid var(--border);
  border-radius: 5px; padding: 2px 7px; font-family: inherit;
  transition: opacity .2s;
}
.search-wrap:focus-within .search-kbd { opacity: 0; }

.header-right { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

/* ── Botones del header (paleta clara) ── */
.hbtn {
  display: inline-flex; align-items: center; gap: 7px; border-radius: 999px;
  padding: 8px 14px; font-size: .82rem; font-weight: 600; white-space: nowrap;
  border: 1.5px solid transparent; transition: all .18s;
}
.hbtn:hover { transform: translateY(-1px); }
.b-ghost  { background: #fff; border-color: var(--border); color: var(--text); }
.b-ghost:hover { border-color: var(--accent-line); }
.b-star   { background: #fff8e8; border-color: #f0d699; color: #9a6b00; }
.b-accent { background: var(--accent); color: var(--on-accent);
  box-shadow: 0 6px 16px rgba(138,107,216,.32); }
.b-accent:hover { background: var(--accent-strong); }

.hits-pill {
  display: inline-flex; align-items: center; border-radius: 8px; overflow: hidden;
  border: 1.5px solid var(--border);
}
.hits-lbl {
  font-family: var(--font-mono); font-size: .66rem; font-weight: 700;
  letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted);
  background: #efedf6; padding: 6px 9px;
}
.hits-num { display: block; background: var(--accent); }

/* ═══════════════════════════════════════════════════════
   HERO — a pantalla completa (aurora derivando)
═══════════════════════════════════════════════════════ */
.hero {
  position: relative; min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
  overflow: hidden; padding: 24px;
}
.hero-inner { position: relative; z-index: 3; max-width: 18ch; }
.hero-h1 {
  font-family: var(--font-display); font-weight: 800;
  font-size: clamp(34px,6vw,72px); letter-spacing: -0.02em;
  line-height: 1.02; color: var(--text);
}
.hero-grad { color: var(--accent); }
.hero-desc {
  margin-top: 18px; color: var(--text-muted);
  font-size: clamp(15px,2vw,18px); line-height: 1.6;
}
.hero-blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; z-index: 1; }
.hero-blob.b1 { width: 46%; height: 60%; left: -6%; top: -10%; background: #dcd2ff; animation: drift1 14s ease-in-out infinite; }
.hero-blob.b2 { width: 48%; height: 64%; right: -8%; top: 4%; background: #ffd9e4; animation: drift2 17s ease-in-out infinite; }
.hero-blob.b3 { width: 42%; height: 58%; left: 24%; bottom: -22%; background: #cfeede; animation: drift3 20s ease-in-out infinite; }
@keyframes drift1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(8%,6%) scale(1.12)} }
@keyframes drift2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-7%,8%) scale(1.1)} }
@keyframes drift3 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(5%,-7%) scale(1.14)} }
.hero-scroll {
  position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 4;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  color: var(--text-muted); font-family: var(--font-mono);
  font-size: 11px; letter-spacing: .22em; text-transform: uppercase;
}
.hero-scroll .chev {
  width: 18px; height: 18px;
  border-right: 2px solid var(--accent); border-bottom: 2px solid var(--accent);
  transform: rotate(45deg); animation: bob 1.5s ease-in-out infinite;
}
@keyframes bob { 0%,100%{transform:rotate(45deg) translate(0,0); opacity:.5} 50%{transform:rotate(45deg) translate(3px,3px); opacity:1} }
@media (prefers-reduced-motion: reduce){ .hero-blob,.hero-scroll .chev{ animation:none } }

/* ═══════════════════════════════════════════════════════
   MAIN WRAPPER — z:1 keeps it above bg-layer (z:0)
═══════════════════════════════════════════════════════ */
main {
  position: relative; z-index: 1;
  max-width: 1320px; margin: 0 auto;
  padding: 28px 24px 80px;
  display: flex; flex-direction: column; gap: 20px;
}

/* ═══════════════════════════════════════════════════════
   BENTO BOX — 12-column CSS grid

   Stacked full-width layout:
     Row 1: [Timeline: cols 1-12]   ← commit progress bar
     Row 2: [Hero:     cols 1-12]   ← "Estudia mejor" (full width)
     Row 3: [Profile 1-6] [Star 7-12]  ← two halves = full width
═══════════════════════════════════════════════════════ */
.bento {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 24px;         /* gap-6 */
}

/* Commit timeline — full width, on top */
.b-timeline {
  grid-column: span 12;
  padding: 18px 26px 22px;
  position: relative; overflow: hidden;
}

/* Hero — full width */
.b-hero {
  grid-column: span 12;
  padding: 40px 44px;
  position: relative; overflow: hidden;
  display: flex; flex-direction: column;
  min-height: 470px;
}
/* subtle inner glow on hero only */
.b-hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse at 0% 0%,
    rgba(198,241,53,0.06) 0%, transparent 60%);
  pointer-events: none; border-radius: inherit;
}

/* Canvas art — rests on the hero's bottom-right corner (Task 5 will animate it) */
.hero-art {
  position: absolute; right: 18px; bottom: 0;
  width: 480px; height: 480px; display: block;
  z-index: 2; pointer-events: none;
}
/* keep hero text clear of the art (tablet + desktop) */
@media (min-width: 701px) {
  .b-hero { justify-content: center; }
  .b-hero .live-pill,
  .b-hero .hero-h1,
  .b-hero .hero-desc,
  .b-hero .stats-row,
  .b-hero .hero-actions { max-width: calc(100% - 520px); }
}

/* CTA cards — col-span-6 each (two halves below hero) */
.b-cta {
  grid-column: span 6;
  padding: 28px;
  display: flex; flex-direction: column; gap: 10px;
  position: relative; overflow: hidden;
  color: #fff;
  transition: transform .22s, border-color .22s, background .22s, box-shadow .22s;
  --mx: 50%; --my: 50%;
  min-height: 170px;
}
/* CTA spotlight (same --mx/--my mechanism) */
.b-cta::after {
  content: ''; position: absolute; inset: 0; border-radius: inherit;
  background: radial-gradient(180px circle at var(--mx) var(--my),
    rgba(198,241,53,.10), transparent 70%);
  opacity: 0; transition: opacity .35s; pointer-events: none;
}
.b-cta:hover { transform: translateY(-4px); }
.b-cta:hover::after { opacity: 1; }
.b-cta.cta-gh:hover {
  border-color: rgba(255,255,255,0.25);
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.65);
}
.b-cta.cta-star {
  background: linear-gradient(135deg,
    rgba(251,191,36,0.05), rgba(255,255,255,0.04));
}
.b-cta.cta-star:hover {
  border-color: rgba(250,204,21,0.40);
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.65), 0 0 30px rgba(250,204,21,0.07);
}

/* Large decorative icon in CTA */
.cta-bg-icon {
  position: absolute; right: 22px; top: 50%; transform: translateY(-50%);
  opacity: 0.08; transition: opacity .2s; pointer-events: none; z-index: 0;
}
.b-cta:hover .cta-bg-icon { opacity: 0.16; }

.cta-kicker {
  font-size: .64rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .8px; color: rgba(255,255,255,0.40);
  position: relative; z-index: 2;
}
.cta-title {
  font-size: 1rem; font-weight: 800; color: #fff; line-height: 1.2;
  position: relative; z-index: 2;
}
.cta-hint {
  font-size: .78rem; color: rgba(255,255,255,0.45);
  position: relative; z-index: 2;
}
.cta-arrow {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .7rem; font-weight: 700;
  background: rgba(198,241,53,0.10); border: 1px solid rgba(198,241,53,0.22);
  color: #c6f135; border-radius: 99px; padding: 4px 12px;
  width: fit-content; margin-top: auto;
  position: relative; z-index: 2;
  transition: background .2s, border-color .2s;
}
.b-cta:hover .cta-arrow { background: rgba(198,241,53,0.20); border-color: rgba(198,241,53,0.4); }
.cta-star .cta-arrow { color:#fde68a; background:rgba(251,191,36,0.10); border-color:rgba(251,191,36,0.22); }
.b-cta.cta-star:hover .cta-arrow { background:rgba(251,191,36,0.20); }

/* ─── Hero content ─── */
.live-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(34,197,94,0.10); border: 1px solid rgba(34,197,94,0.22);
  border-radius: 99px; padding: 5px 14px; width: fit-content;
  font-size: .72rem; font-weight: 700; color: #4ade80; margin-bottom: 22px;
  position: relative; z-index: 2;
}
.live-dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,.8);
  animation: dotPulse 2.4s ease-in-out infinite;
}
.hero-h1 {
  font-size: clamp(2.4rem,5vw,4rem);
  font-weight: 800; letter-spacing: -2px; line-height: 1.1;
  color: #fff; margin-bottom: 14px;
  position: relative; z-index: 2;
}
.hero-grad {
  color: var(--accent);
}
.hero-desc {
  font-size: .95rem; color: rgba(255,255,255,0.50); line-height: 1.65;
  max-width: 500px; margin-bottom: 28px;
  position: relative; z-index: 2;
}

/* Stats — gradient numbers (as specified in brief) */
.stats-row {
  display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px;
  position: relative; z-index: 2;
}
.stat-chip {
  display: flex; flex-direction: column; gap: 3px;
  padding: 12px 18px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 14px;
}
.stat-num {
  font-size: 1.85rem; font-weight: 800; letter-spacing: -1px; line-height: 1;
  color: var(--accent);
  font-family: var(--font-mono);
}
.stat-lbl {
  font-size: .62rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .8px; color: rgba(255,255,255,0.38);
  font-family: var(--font-mono);
}
.hero-actions { position: relative; z-index: 2; }
.wa-btn {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(37,211,102,0.07); border: 1px solid rgba(37,211,102,0.22);
  border-radius: 99px; padding: 9px 20px;
  color: #4ade80; font-size: .82rem; font-weight: 700; transition: all .2s;
}
.wa-btn:hover { background: rgba(37,211,102,0.16); transform: translateY(-1px); }

/* ─── Commit timeline (progress bar) ─── */
.tl-hdr {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 20px;
  font-size: .67rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .9px; color: rgba(255,255,255,0.45);
}
.tl-since {
  margin-left: auto; font-size: .64rem; color: #c6f135;
  font-weight: 600; text-transform: none; letter-spacing: 0;
}

/* Horizontal track of commit nodes */
.tl-track {
  list-style: none;
  display: flex; align-items: flex-start;
  position: relative;
  padding: 4px 8px 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.tl-track::-webkit-scrollbar { display: none; }
/* the connecting line that runs through every node */
.tl-track::before {
  content: ''; position: absolute;
  top: 9px; left: 8px; right: 8px; height: 2px;
  background: rgba(198,241,53,0.25);
  border-radius: 2px;
}

.tl-item {
  position: relative; z-index: 1;
  flex: 1 1 0; min-width: 96px;
  display: flex; flex-direction: column; align-items: center;
  gap: 8px; text-align: center;
  padding: 0 4px;
}

/* Node dot on the line */
.tl-node {
  width: 14px; height: 14px; border-radius: 50%;
  border: 3px solid var(--bg);
  background: #94a3b8;
  box-shadow: 0 0 0 1px rgba(255,255,255,0.10);
  transition: transform .2s, box-shadow .2s;
}
.tl-item:hover .tl-node { transform: scale(1.25); }

/* Node colors by commit type (reuse upd-* palette) */
.tl-node.upd-green  { background:#22c55e; box-shadow:0 0 10px rgba(34,197,94,.6); }
.tl-node.upd-orange { background:#f97316; box-shadow:0 0 10px rgba(249,115,22,.6); }
.tl-node.upd-blue   { background:#3b82f6; box-shadow:0 0 10px rgba(59,130,246,.6); }
.tl-node.upd-purple { background:#c6f135; box-shadow:0 0 10px rgba(198,241,53,.6); }
.tl-node.upd-cyan   { background:#c6f135; box-shadow:0 0 10px rgba(198,241,53,.6); }
.tl-node.upd-gray   { background:#94a3b8; }

/* newest commit pulses */
.tl-item.is-latest .tl-node { animation: tlPulse 2s ease-in-out infinite; }
@keyframes tlPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(198,241,53,.55); }
  50%     { box-shadow: 0 0 0 7px rgba(198,241,53,0); }
}

.tl-badge {
  font-size: .58rem; font-weight: 800; border-radius: 99px;
  padding: 2px 9px; white-space: nowrap;
}
.upd-green  { background:rgba(34,197,94,.15);  color:#4ade80; border:1px solid rgba(34,197,94,.25);  }
.upd-orange { background:rgba(249,115,22,.15); color:#fb923c; border:1px solid rgba(249,115,22,.25); }
.upd-blue   { background:rgba(59,130,246,.15); color:#93c5fd; border:1px solid rgba(59,130,246,.25); }
.upd-purple { background:rgba(198,241,53,.12); color:#c6f135; border:1px solid rgba(198,241,53,.25); }
.upd-cyan   { background:rgba(198,241,53,.10); color:#c6f135; border:1px solid rgba(198,241,53,.22); }
.upd-gray   { background:rgba(148,163,184,.10);color:#94a3b8; border:1px solid rgba(148,163,184,.18);}

.tl-date {
  font-size: .6rem; font-weight: 600; color: rgba(255,255,255,0.40);
  white-space: nowrap;
}
.tl-text {
  font-size: .68rem; color: rgba(255,255,255,0.55); line-height: 1.35;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ═══════════════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════════════ */
footer {
  position: relative; z-index: 1;
  text-align: center; padding: 22px 24px 32px;
  font-size: .74rem; color: rgba(255,255,255,0.28);
  border-top: 1px solid rgba(255,255,255,0.07);
  display: flex; flex-direction: column; gap: 6px;
}
.footer-meta { font-size: .68rem; color: rgba(255,255,255,0.18); }
.footer-links { font-size: .72rem; }
footer a { color: #c6f135; }
footer a:hover { color: #b4e02e; }

/* ═══════════════════════════════════════════════════════
   RESPONSIVE
   lg = 1100px+  →  12-col bento
   md = 700-1099 →  2-col (hero full, cta half)
   sm = <700     →  single column
═══════════════════════════════════════════════════════ */
@media (max-width: 1100px) {
  .bento { grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .b-timeline { grid-column: span 6; }
  .b-hero     { grid-column: span 6; padding: 32px 36px; min-height: 400px; }
  .b-cta      { grid-column: span 3; }
  .hero-art { width: 400px; right: 8px; }
  .b-hero .live-pill,
  .b-hero .hero-h1,
  .b-hero .hero-desc,
  .b-hero .stats-row,
  .b-hero .hero-actions { max-width: calc(100% - 440px); }
}
@media (max-width: 700px) {
  .site-header { padding: 0 16px; }
  .search-wrap { max-width: none; }
  .gh-only { display: none; }              /* Seguir, Star y Visitas fuera en móvil */
  .b-accent span { display: none; }        /* Solicitar solo icono */
  .b-accent { padding: 8px 11px; }
  main { padding: 20px 14px 60px; gap: 14px; }
  .bento { grid-template-columns: 1fr; gap: 14px; }
  .b-timeline { grid-column: span 1; }
  .b-hero     { grid-column: span 1; padding: 28px 22px 0; min-height: auto; }
  .b-cta      { grid-column: span 1; }
  /* Reset: en móvil el texto ocupa todo el ancho (sin el clearance del arte) */
  .b-hero .live-pill,
  .b-hero .hero-h1,
  .b-hero .hero-desc,
  .b-hero .stats-row,
  .b-hero .hero-actions { max-width: none; }
  /* En móvil: canvas en flujo, debajo del texto */
  .hero-art { position: static; width: 100%; max-width: 400px; height: 340px; margin: 12px auto 0; }
  .tl-item    { min-width: 88px; }
  .stats-row  { gap: 6px; }
  .stat-chip  { padding: 10px 14px; }
  .stat-num   { font-size: 1.5rem; }
}
