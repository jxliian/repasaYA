---
/**
 * Landing de repasaYA.
 *
 * Orden: secuencia de carga con el logo 3D → hero con buscador y las dos
 * puertas de grado → lo que ya tiene material → novedades sacadas de git
 * → sobre mí y contacto.
 */
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import BootSequence from '../components/boot/BootSequence.astro';
import Hero from '../components/hero/Hero.astro';
import SubjectCard from '../components/catalog/SubjectCard.astro';
import Changelog from '../components/sections/Changelog.astro';
import About from '../components/sections/About.astro';
import { degreePath } from '../lib/routes';

const allSubjects = await getCollection('subjects');
const allDegrees = await getCollection('degrees');
const allMaterials = await getCollection('materials');
const degreeById = new Map(allDegrees.map((d) => [d.id, d.data]));

const degrees = allDegrees
  .map((d) => {
    const mine = allSubjects.filter((s) => s.data.degree.id === d.id);
    return {
      slug: d.id,
      name: d.data.name,
      short: d.data.short,
      icon: d.data.icon,
      ready: mine.filter((s) => s.data.status === 'available').length,
      total: mine.length,
      blurb: d.data.blurb,
    };
  })
  .sort((a, b) => b.ready - a.ready);

const ready = allSubjects
  .filter((s) => s.data.status === 'available')
  .sort((a, b) => a.data.year - b.data.year || a.data.title.localeCompare(b.data.title, 'es'));

/* Cifras contadas de verdad sobre la colección: si añades un archivo de
   preguntas, el hero se actualiza en el siguiente build. */
function countBy(types: string[]): number {
  return allMaterials
    .filter((m) => types.includes(m.data.type))
    .reduce((n, m) => n + ('items' in m.data ? m.data.items.length : 0), 0);
}

/* Separador de miles a mano: `toLocaleString` depende del ICU del Node
   que ejecute el build y en CI puede devolver "1935" en vez de "1.935". */
const es = (n: number) => n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');

const stats = [
  { value: es(countBy(['test', 'vf', 'reveal'])), label: 'preguntas' },
  { value: es(countBy(['flashcards', 'glosario'])), label: 'fichas' },
  { value: String(allSubjects.length), label: 'asignaturas' },
  { value: '0', label: 'anuncios' },
];
---

<Shell title="repasaYA">
  <BootSequence />
  <Hero degrees={degrees} stats={stats} />

  <section id="asignaturas" class="ready container" aria-label="Asignaturas con material">
    <div class="sec-head">
      <div>
        <p class="mono-label">Listo para machacar</p>
        <h2>Lo que ya puedes repasar hoy</h2>
      </div>
      <div class="sec-links">
        {
          degrees.map((d) => (
            <a class="btn btn-ghost" href={degreePath(d.slug)}>
              {d.icon} Ver {d.short}
            </a>
          ))
        }
      </div>
    </div>

    <div class="grid">
      {
        ready.map((s) => (
          <SubjectCard
            subject={s}
            degreeName={degreeById.get(s.data.degree.id)?.name ?? ''}
            degreeShort={degreeById.get(s.data.degree.id)?.short ?? ''}
            showPlace
          />
        ))
      }
    </div>

    <p class="rest">
      Y otras <strong>{allSubjects.length - ready.length}</strong> asignaturas del plan
      esperando material. Si has cursado alguna, ya sabes.
    </p>
  </section>

  <Changelog />
  <About />
</Shell>

<style>
  .ready {
    padding-block: 40px 20px;
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 24px;
  }
  .sec-head h2 {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.6vw, 2.2rem);
    letter-spacing: -0.035em;
  }
  .sec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(264px, 1fr));
    gap: 14px;
  }
  .rest {
    margin-top: 26px;
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .rest strong {
    color: var(--accent);
  }
</style>
