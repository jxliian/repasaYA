---
import { getCollection } from 'astro:content';
import Shell from '../../../../../layouts/Shell.astro';
import Breadcrumbs from '../../../../../components/nav/Breadcrumbs.astro';
import PageHead from '../../../../../components/catalog/PageHead.astro';
import SubjectCard from '../../../../../components/catalog/SubjectCard.astro';
import {
  contributeUrl,
  degreePath,
  hasHub,
  materialPath,
  semesterPath,
  subjectSlug,
  yearPath,
} from '../../../../../lib/routes';

export async function getStaticPaths() {
  const degrees = await getCollection('degrees');
  const subjects = await getCollection('subjects');
  const materials = await getCollection('materials');
  const byId = new Map(degrees.map((d) => [d.id, d]));

  // Solo las que tienen material propio. Las externas viven en otro repo
  // y las vacías no merecen una página en blanco indexable.
  return subjects.filter(hasHub).map((subject) => {
    const degree = byId.get(subject.data.degree.id)!;
    return {
      params: {
        degree: degree.id,
        year: String(subject.data.year),
        semester: `c${subject.data.semester}`,
        subject: subjectSlug(subject),
      },
      props: {
        degree,
        subject,
        materials: materials
          .filter((m) => m.data.subject.id === subject.id)
          .sort((a, b) => a.data.order - b.data.order),
        siblings: subjects.filter(
          (s) =>
            s.data.degree.id === degree.id &&
            s.data.year === subject.data.year &&
            s.data.semester === subject.data.semester &&
            s.id !== subject.id
        ),
      },
    };
  });
}

const { degree, subject, siblings, materials: entries } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { title, icon, year, semester, credits, description } = subject.data;

/* Cómo se presenta cada tipo de material en el hub */
const PRESENTATION: Record<string, { kind: string; blurb: string; cta: string; unit: string }> = {
  test: { kind: 'Test', blurb: 'Corrección al momento y desglose por tema', cta: 'Empezar test', unit: 'preguntas' },
  vf: { kind: 'Verdadero/Falso', blurb: 'Cada respuesta viene con su justificación', cta: 'Empezar', unit: 'afirmaciones' },
  reveal: { kind: 'Preguntas abiertas', blurb: 'Pregunta, piensa, destapa la respuesta', cta: 'Empezar', unit: 'preguntas' },
  flashcards: { kind: 'Flashcards', blurb: 'Tarjetas para repasar en cinco minutos', cta: 'Repasar', unit: 'tarjetas' },
  glosario: { kind: 'Glosario', blurb: 'Los términos que caen sí o sí', cta: 'Repasar', unit: 'términos' },
  apuntes: { kind: 'Apuntes', blurb: 'Resúmenes en PDF, listos para imprimir', cta: 'Abrir PDF', unit: '' },
  examen: { kind: 'Exámenes', blurb: 'Examen de otros años, resuelto', cta: 'Abrir', unit: 'preguntas' },
  guia: { kind: 'Guía', blurb: 'Por dónde empezar y qué pesa más', cta: 'Abrir guía', unit: '' },
};

const slug = subjectSlug(subject);

const materials = entries
  // Lo oculto genera página pero no se lista: solo se llega con el enlace
  .filter((m) => !m.data.hidden)
  .map((m) => {
    const key = m.id.split('/').pop()!;
    return {
      key,
      type: m.data.type,
      label: m.data.title,
      kind: PRESENTATION[m.data.type]?.kind ?? m.data.type,
      blurb: m.data.description ?? PRESENTATION[m.data.type]?.blurb ?? '',
      count: 'items' in m.data ? m.data.items.length : 0,
      unit: PRESENTATION[m.data.type]?.unit ?? '',
      cta: 'pdf' in m.data ? 'Abrir PDF' : (PRESENTATION[m.data.type]?.cta ?? 'Abrir'),
      // Las guías viven en su propia página; el resto tiene ruta generada
      href:
        'href' in m.data
          ? m.data.href
          : materialPath(degree.id, year, semester, slug, key),
    };
  });

const crumbs = [
  { label: 'Inicio', href: base },
  { label: degree.data.short, href: degreePath(degree.id) },
  { label: `${year}º`, href: yearPath(degree.id, year) },
  { label: `Cuatri ${semester}`, href: semesterPath(degree.id, year, semester) },
  { label: title, href: null },
];
---

<Shell title={title} description={description ?? `Material de ${title} en repasaYA.`}>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />

    <PageHead
      kicker={`${degree.data.short}, ${year}º curso, ${semester === 1 ? '1er' : '2º'} cuatrimestre`}
      title={title}
      lede={description}
      stats={[
        { value: materials.length, label: materials.length === 1 ? 'recurso' : 'recursos' },
        { value: credits, label: 'ECTS' },
      ]}
    />

    <div class="layout">
      <section aria-labelledby="mat-title">
        <div class="sec-head">
          <h2 id="mat-title" class="sec-title">Materiales<span class="pt">.</span></h2>
        </div>
        <div class="materials">
          {
            materials.map((m, i) => (
              <div class="mat">
                <div class="mat-body">
                  <span class="kind">{m.kind}</span>
                  <a class="mat-title" href={m.href}>{m.label}</a>
                  {m.blurb && <p class="mat-blurb" title={m.blurb}>{m.blurb}</p>}
                </div>
                {m.count > 0 && (
                  <span class="figs">
                    {m.count} {m.unit}
                  </span>
                )}
                <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost']} href={m.href} tabindex="-1" aria-hidden="true">
                  {m.cta}
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <aside class="side">
        <div class="panel">
          <h2 class="p-title">Sobre la asignatura</h2>
          <dl>
            <div><dt>Grado</dt><dd><a href={degreePath(degree.id)}>{degree.data.name}</a></dd></div>
            <div><dt>Curso</dt><dd><a href={yearPath(degree.id, year)}>{year}º</a>, <a href={semesterPath(degree.id, year, semester)}>{semester === 1 ? '1er' : '2º'} cuatrimestre</a></dd></div>
            <div><dt>Créditos</dt><dd>{credits} ECTS</dd></div>
          </dl>
        </div>
        <div class="panel">
          <h2 class="p-title">¿Falta algo?</h2>
          <p>Si tienes exámenes, apuntes o preguntas de {title}, mándalos. Se suben con tu nombre si quieres, y sin él si no.</p>
          <a class="btn btn-ghost" href={contributeUrl(subject, degree.data.name)} target="_blank" rel="noopener">Aportar material</a>
        </div>
      </aside>
    </div>

    {
      siblings.length > 0 && (
        <section class="siblings">
          <div class="sec-head">
            <h2 class="sec-title">Lo demás de este cuatrimestre<span class="pt">.</span></h2>
            <a class="more" href={semesterPath(degree.id, year, semester)}>Ver el cuatrimestre entero</a>
          </div>
          <div class="sib-list">
            {siblings.map((s) => (
              <SubjectCard subject={s} degreeName={degree.data.name} degreeShort={degree.data.short} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Shell>

<script define:vars={{ recentTitle: title }}>
  /* Para «Seguir donde lo dejaste» en la portada */
  try {
    const key = 'ry-recent';
    const u = location.pathname;
    const list = JSON.parse(localStorage.getItem(key) || '[]').filter((r) => r && r.u !== u);
    list.unshift({ t: recentTitle, u });
    localStorage.setItem(key, JSON.stringify(list.slice(0, 4)));
  } catch (e) {
    /* sin almacenamiento: no pasa nada */
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 12px;
  }
  .materials {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .mat {
    display: flex;
    align-items: center;
    gap: 14px 20px;
    padding: 18px 20px;
    border-top: 1px solid var(--line);
  }
  .mat:first-child {
    border-top: 0;
  }
  .mat-body {
    flex: 1;
    min-width: 0;
  }
  .kind {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand);
  }
  .mat-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.3;
  }
  .mat-title:hover {
    color: var(--brand);
  }
  .mat-blurb {
    margin-top: 4px;
    font-size: 0.88rem;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .figs {
    flex: none;
    font-size: 0.9rem;
    color: var(--ink-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 620px) {
    .mat {
      flex-wrap: wrap;
    }
    .mat-body {
      flex-basis: 100%;
    }
  }

  .side {
    display: grid;
    gap: 16px;
  }
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px;
  }
  .p-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.08rem;
    margin-bottom: 10px;
  }
  .panel p {
    font-size: 0.9rem;
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  dl {
    display: grid;
    gap: 10px;
    font-size: 0.92rem;
  }
  dt {
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  dd a {
    color: var(--brand);
    font-weight: 600;
  }
  dd a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .siblings {
    margin-top: 44px;
  }
  .more {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand);
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sib-list {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
</style>
