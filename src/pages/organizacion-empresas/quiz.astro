---
import Base from '../../layouts/Base.astro';
import QuizEngine from '../../components/QuizEngine.astro';
import testData from '../../data/oe.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="OE · Tipo Test" description="362 preguntas tipo test de Organización de Empresas sobre Mintzberg: configuraciones, partes, parámetros de diseño y más.">
  <QuizEngine
    title="Organización de Empresas"
    code="OE"
    testData={testData}
    backHref={`${base}organizacion-empresas/`}
    backLabel="Organización de Empresas"
  />
</Base>
