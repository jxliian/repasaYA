---
import Base from '../../layouts/Base.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Organización de Empresas" description="437 preguntas tipo test y 128 flashcards sobre Mintzberg: configuraciones, parámetros de diseño, mecanismos de coordinación y más.">
<style is:global>
  html,body{height:100%;overflow:hidden}
  header{background:var(--surface);border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .logo{font-size:1.15rem;font-weight:800}.logo span{color:var(--accent)}
  .back{font-size:.8rem;color:var(--text-muted);transition:color .2s}.back:hover{color:var(--accent)}
  main{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;gap:32px}
  .hub-hero{text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}
  .hub-badge{display:inline-flex;align-items:center;gap:6px;background:var(--accent-soft);border:1px solid var(--accent-line);border-radius:99px;padding:5px 14px;font-size:.75rem;color:var(--accent);font-weight:600}
  .hub-title{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;letter-spacing:-1px;font-family:var(--font-display)}
  .hub-title span{color:var(--accent)}
  .hub-desc{font-size:.9rem;color:var(--text-muted);max-width:520px;line-height:1.6}
  .hub-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;width:100%;max-width:720px}
  .hub-card-secret{border-color:rgba(245,158,11,.35)}
  .hub-card-secret:hover{border-color:rgba(245,158,11,.7);background:#241f12;box-shadow:0 12px 32px rgba(245,158,11,.18)}
  .hub-card-secret::before{background:linear-gradient(90deg,#f59e0b,#fbbf24)}
  .hub-card{background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);padding:28px 22px;display:flex;flex-direction:column;gap:14px;transition:all .22s;position:relative;overflow:hidden;text-decoration:none;color:var(--text)}
  .hub-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--accent);opacity:0;transition:opacity .22s}
  .hub-card:hover{border-color:var(--accent);background:var(--surface2);transform:translateY(-4px);box-shadow:0 12px 32px rgba(138,107,216,.12)}
  .hub-card:hover::before{opacity:1}
  .hub-card-icon{font-size:2rem;width:52px;height:52px;border-radius:12px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center}
  .hub-card-title{font-size:1.05rem;font-weight:800}
  .hub-card-desc{font-size:.8rem;color:var(--text-muted);line-height:1.55;flex:1}
  .hub-card-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto}
  .hub-chip{font-size:.68rem;font-weight:600;background:var(--accent-soft);border:1px solid var(--accent-line);border-radius:99px;padding:3px 10px;color:var(--accent)}
  .hub-card-arrow{position:absolute;bottom:20px;right:20px;font-size:.9rem;color:var(--accent);opacity:0;transform:translateX(-4px);transition:all .2s}
  .hub-card:hover .hub-card-arrow{opacity:1;transform:translateX(0)}
  body{display:flex;flex-direction:column}
  @media(max-width:600px){html,body{height:auto;overflow:visible}main{overflow:visible}.hub-cards{grid-template-columns:1fr}}
</style>

<header>
  <div style="display:flex;align-items:center;gap:12px">
    <a class="back" href={base}>← repasaYA</a>
    <span style="color:var(--border)">|</span>
    <div class="logo"><span>OE</span> · Organización de Empresas</div>
  </div>
  <div style="display:flex;align-items:center;gap:12px">
  <span style="font-size:.75rem;color:var(--text-muted)">ADE · Organización</span>
  <ThemeToggle />
</div>
</header>

<main>
  <div class="hub-hero">
    <span class="hub-badge">🏢 ADE · Organización de Empresas</span>
    <h1 class="hub-title">Organización de <span>Empresas</span></h1>
    <p class="hub-desc">Tipo test sobre Mintzberg: configuraciones estructurales, parámetros de diseño, mecanismos de coordinación y factores de contingencia. Flashcards para afianzar los conceptos clave.</p>
  </div>

  <div class="hub-cards">
    <a class="hub-card" href={`${base}organizacion-empresas/guia/`}>
      <div class="hub-card-icon">📌</div>
      <div class="hub-card-title">Guía de examen</div>
      <p class="hub-card-desc">Todo lo necesario para aprobar: las 6 configuraciones de Mintzberg, los patrones de pregunta, las trampas frecuentes y los datos que caen todos los años.</p>
      <div class="hub-card-chips">
        <span class="hub-chip">Chuleta</span>
        <span class="hub-chip">Mintzberg</span>
        <span class="hub-chip">Patrones</span>
      </div>
      <span class="hub-card-arrow">→</span>
    </a>

    <a class="hub-card" href={`${base}organizacion-empresas/quiz/`}>
      <div class="hub-card-icon">🧠</div>
      <div class="hub-card-title">Tipo Test</div>
      <p class="hub-card-desc">437 preguntas de opción múltiple. Filtra por tema y practica los 21 bloques, incluidos los exámenes oficiales (ExamenSec y Ordinaria 26).</p>
      <div class="hub-card-chips">
        <span class="hub-chip">437 preguntas</span>
        <span class="hub-chip">21 bloques</span>
      </div>
      <span class="hub-card-arrow">→</span>
    </a>

    <a class="hub-card" href={`${base}organizacion-empresas/glosario/`}>
      <div class="hub-card-icon">🃏</div>
      <div class="hub-card-title">Flashcards</div>
      <p class="hub-card-desc">128 tarjetas con los conceptos esenciales: burocracia profesional, forma divisional, adhocracia, hipótesis de Mintzberg, cadena de valor y más.</p>
      <div class="hub-card-chips">
        <span class="hub-chip">128 tarjetas</span>
        <span class="hub-chip">17 temas</span>
        <span class="hub-chip">Flashcards</span>
      </div>
      <span class="hub-card-arrow">→</span>
    </a>

    <a class="hub-card hub-card-secret" href={`${base}organizacion-empresas/secreto/`}>
      <div class="hub-card-icon">🔒</div>
      <div class="hub-card-title">Secreto</div>
      <p class="hub-card-desc">Contenido protegido con contraseña. 🤫 Top secret.</p>
      <div class="hub-card-chips">
        <span class="hub-chip">🔒 Contraseña</span>
        <span class="hub-chip">Top secret</span>
      </div>
      <span class="hub-card-arrow">→</span>
    </a>
  </div>
</main>
</Base>
