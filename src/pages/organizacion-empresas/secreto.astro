---
import Base from '../../layouts/Base.astro';
import QuizEngine from '../../components/QuizEngine.astro';
import testData from '../../data/oe-secreto.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="OE · Secreto" description="Examen ordinario de Organización de Empresas — contenido protegido.">
<style>
  #gate{
    position: fixed; inset: 0; z-index: 9999;
    background: var(--bg);
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  #gate.hidden{ display: none; }
  .gate-card{
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 36px 32px;
    max-width: 380px; width: 100%; text-align: center;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,.5);
  }
  .gate-icon{ font-size: 2.4rem; margin-bottom: 8px; }
  .gate-title{ font-size: 1.3rem; font-weight: 800; margin-bottom: 6px; }
  .gate-sub{ font-size: .85rem; color: var(--text-muted); margin-bottom: 22px; line-height: 1.5; }
  .gate-input{
    width: 100%; padding: 13px 16px; border-radius: 12px;
    border: 1px solid var(--border); background: var(--surface2);
    color: var(--text); font-size: 1rem; text-align: center; letter-spacing: 1px;
    font-family: inherit; margin-bottom: 12px;
  }
  .gate-input:focus{ outline: none; border-color: var(--accent); }
  .gate-btn{
    width: 100%; padding: 13px; border: none; border-radius: 12px;
    background: var(--accent); color: #fff; font-size: .95rem; font-weight: 700;
    cursor: pointer; transition: background .2s;
  }
  .gate-btn:hover{ background: var(--accent-hover); }
  .gate-err{ color: var(--wrong); font-size: .82rem; margin-top: 12px; min-height: 1em; }
  .gate-back{ display: inline-block; margin-top: 18px; font-size: .8rem; color: var(--text-muted); }
  .gate-back:hover{ color: var(--accent); }
</style>

<QuizEngine
  title="OE · Examen Secreto"
  code="OE"
  testData={testData}
  backHref={`${base}organizacion-empresas/`}
  backLabel="Organización de Empresas"
/>

<!-- Password gate (overlay) -->
<div id="gate">
  <div class="gate-card">
    <div class="gate-icon" aria-hidden="true">🔒</div>
    <h1 class="gate-title">Contenido protegido</h1>
    <p class="gate-sub">Introduce la contraseña para acceder al examen ordinario de OE.</p>
    <input id="gate-pass" class="gate-input" type="password" placeholder="Contraseña" autocomplete="off" aria-label="Contraseña" />
    <button id="gate-go" class="gate-btn">Entrar</button>
    <div class="gate-err" id="gate-err" role="alert"></div>
    <a class="gate-back" href={`${base}organizacion-empresas/`}>← Volver</a>
  </div>
</div>

<script>
  const PASS = 'ordi26ulj';
  const KEY  = 'oe-secreto-unlock';
  const gate  = document.getElementById('gate');
  const input = document.getElementById('gate-pass') as HTMLInputElement | null;
  const err   = document.getElementById('gate-err');

  function unlock(){
    gate?.classList.add('hidden');
    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
  }
  function check(){
    if (!input) return;
    if (input.value === PASS) { unlock(); }
    else { if (err) err.textContent = 'Contraseña incorrecta'; input.value = ''; input.focus(); }
  }
  document.getElementById('gate-go')?.addEventListener('click', check);
  input?.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') check(); });

  // Mantener desbloqueado durante la sesión
  try { if (sessionStorage.getItem(KEY) === '1') unlock(); else input?.focus(); } catch (e) { input?.focus(); }
</script>
</Base>
